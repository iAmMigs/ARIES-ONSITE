{% block javascripts %}
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
(function() {
    'use strict';
    // --- Elements ---
    const form = document.getElementById('applyForm');
    const submitBtn = document.getElementById('submitBtn');
    const submitText = document.getElementById('submitText');
    const submitIcon = document.getElementById('submitIcon');
    const submitErrorMessage = document.getElementById('submitErrorMessage');
    
    // Campus Selector
    const campusOptions = document.querySelectorAll('.campus-option');
    const campusInput = document.getElementById('campusSelected');
    const levelSection = document.getElementById('levelSection');
    
    // Education Selection
    const eduOptions = document.querySelectorAll('.edu-option');
    const eduLevelInput = document.getElementById('educationLevel');
    const eduTypeInput = document.getElementById('educationType');
    const educationSelector = document.getElementById('educationSelector');
    const selectedLevelDisplay = document.getElementById('selectedLevelDisplay');
    const changeLevelBtn = document.getElementById('changeLevelBtn');
    const selectedLevelText = document.getElementById('selectedLevelText');

    // App Type
    const applicationTypeInput = document.getElementById('applicationType');
    const applicationTypeSection = document.getElementById('applicationTypeSection');
    const changeTypeBtn = document.getElementById('changeTypeBtn');
    const appTypeText = document.getElementById('appTypeText');
    const appTypeIcon = document.getElementById('appTypeIcon');
    
    // Campus & Sections
    const bedSection = document.getElementById('bedSection');
    const strandSection = document.getElementById('strandSection');
    const gradeLevelSelect = document.getElementById('gradeLevel');
    const strandSelect = document.getElementById('strand'); // Added explicit reference
    
    // Requirements
    const reqEscContainer = document.getElementById('reqEscContainer');
    const reqEscInput = document.getElementById('reqEsc');

    // Mobile Field
    const studentMobileContainer = document.getElementById('studentMobileContainer');
    
    // Modals
    const tertiaryModal = document.getElementById('tertiaryModal');
    const bedModal = document.getElementById('bedModal');
    const closeTertiaryModal = document.getElementById('closeTertiaryModal');
    const closeBedModal = document.getElementById('closeBedModal');
    const tertiaryLevelName = document.getElementById('tertiaryLevelName');
    const bedLevelName = document.getElementById('bedLevelName');

    let selectedLevel = null;
    let selectedType = null;
    let selectedAppType = null;

    // --- DATA MAPPING ---
    const strandData = {
        feu_alabang: {
            'SHS_ABM': 'ABM - Accountancy, Business and Management',
            'SHS_BAE': 'BAE - Business And Entrepreneurship',
            'SHS_CSMA': 'CSMA - Computer Studies And Multimedia Arts',
            'SHS_ENG': 'ENG - Engineering',
            'SHS_GAS': 'GAS - General Academic Strand',
            'SHS_HA': 'HA - Health Allied',
            'SHS_HUMSS': 'HUMSS - Humanities and Social Sciences',
            'SHS_SSH': 'SSH - Social Sciences And Humanities',
            'SHS_STEM': 'STEM - Science, Technology, Engineering and Mathematics'
        },
        feu_diliman: {
            'SHS_ABM': 'ABM - Accountancy, Business and Management',
            'SHS_GAS': 'GAS - General Academic Strand',
            'SHS_HUMSS': 'HUMSS - Humanities and Social Sciences',
            'SHS_SPORTS': 'SPORTS - Sports Track',
            'SHS_STEM': 'STEM - Science, Technology, Engineering and Mathematics'
        }
    };
    
    const gradeLevels = {
        elementary: ['Kinder', 'Grade 1', 'Grade 2', 'Grade 3', 'Grade 4', 'Grade 5', 'Grade 6'],
        junior_high: ['Grade 7', 'Grade 8', 'Grade 9', 'Grade 10'],
        senior_high: ['Grade 11', 'Grade 12']
    };
    
    const appTypeLabels = {
        freshman: { text: 'Freshman', icon: 'ki-user-tick' },
        transferee: { text: 'Transferee', icon: 'ki-arrow-right-left' },
        second_degree: { text: 'Second Degree', icon: 'ki-medal-star' },
        cross_enrollee: { text: 'Cross Enrollee', icon: 'ki-document' },
        new_student: { text: 'New Student', icon: 'ki-user-tick' }
    };
    
    function initSelect2() {
        $('.select-styled').select2({ width: '100%', minimumResultsForSearch: 10 });
        // Add change listener to Select2 elements to trigger validation
        $('.select-styled').on('change', function() {
            checkGlobalValidity();
        });
    }

    // --- Campus Selection Logic ---
    function initCampus() {
        const preSelected = campusInput.value;
        if(preSelected) {
            selectCampus(preSelected, false); // Don't scroll on init
        }
    }

    campusOptions.forEach(opt => {
        opt.addEventListener('click', function() {
            const val = this.dataset.value;
            selectCampus(val, true);
        });
        
        opt.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                const val = this.dataset.value;
                selectCampus(val, true);
            }
        });
    });

    function selectCampus(campusValue, shouldScroll = true) {
        campusOptions.forEach(c => {
            c.classList.remove('selected');
            c.setAttribute('aria-checked', 'false');
        });
        
        const selectedBtn = document.querySelector(`.campus-option[data-value="${campusValue}"]`);
        if(selectedBtn) {
            selectedBtn.classList.add('selected');
            selectedBtn.setAttribute('aria-checked', 'true');
        }

        campusInput.value = campusValue;
        document.getElementById('campusError').style.display = 'none';
        levelSection.classList.remove('section-disabled');
        // Hide options irrelevant to campus
        eduOptions.forEach(opt => {
            if (campusValue === 'feu_alabang') {
                if (opt.classList.contains('diliman-only')) {
                    opt.classList.add('hidden');
                } else {
                    opt.classList.remove('hidden');
                }
            } else {
                opt.classList.remove('hidden');
            }
        });
        
        const currentLevel = document.querySelector('.edu-option.selected');
        if(currentLevel && currentLevel.classList.contains('hidden')) {
            resetLevelSelection();
        }

        updateStrands(campusValue);
        checkGlobalValidity(); // Update progress bar

        if(shouldScroll) {
            scrollToSection('levelSection');
        }
    }
    
    function updateStrands(campus) {
        const select = $('#strand');
        const strands = strandData[campus] || {};
        select.empty().append('<option value="">Select track and strand</option>');
        Object.entries(strands).forEach(([val, label]) => {
            select.append(new Option(label, val));
        });
    }

    function resetLevelSelection() {
        eduOptions.forEach(o => o.classList.remove('selected'));
        selectedLevel = null;
        selectedType = null;
        eduLevelInput.value = '';
        eduTypeInput.value = '';
        selectedLevelDisplay.classList.remove('active');
        educationSelector.classList.remove('collapsed');
        applicationTypeSection.classList.remove('active');
        bedSection.classList.remove('active');
        studentMobileContainer.style.display = 'block';
        checkGlobalValidity();
    }

    // --- Education Option Selection ---
    eduOptions.forEach(opt => {
        opt.addEventListener('click', function() {
            if(!campusInput.value) {
                document.getElementById('campusError').style.display = 'block';
                return;
            }
            eduOptions.forEach(o => o.classList.remove('selected'));
            this.classList.add('selected');
            selectedLevel = this.dataset.level;
            selectedType = this.dataset.type;
            
            // Open Modal
            if(selectedType === 'tertiary') {
                tertiaryLevelName.textContent = selectedLevel === 'graduate' ? 'Graduate School' : 'Collegiate';
                tertiaryModal.classList.add('active');
            } else {
                bedLevelName.textContent = selectedLevel === 'elementary' ? 'Elementary' : (selectedLevel === 'junior_high' ? 'Junior High' : 'Senior High');
                bedModal.classList.add('active');
            }
        });
    });

    // Close Modals
    [closeTertiaryModal, closeBedModal].forEach(btn => btn.addEventListener('click', closeModal));
    
    function closeModal() {
        tertiaryModal.classList.remove('active');
        bedModal.classList.remove('active');
        if (!selectedAppType) { 
            eduOptions.forEach(o => o.classList.remove('selected'));
            selectedLevel = null;
        }
    }

    // App Type Selection (Inside Modal)
    document.querySelectorAll('.modal-option').forEach(opt => {
        opt.addEventListener('click', function() {
            selectedAppType = this.dataset.value;
            closeModal();
            updateFormState();
        });
    });

    function updateFormState() {
        eduLevelInput.value = selectedLevel;
        eduTypeInput.value = selectedType;
        applicationTypeInput.value = selectedAppType;

        selectedLevelDisplay.classList.add('active');
        educationSelector.classList.add('collapsed');
        selectedLevelText.textContent = selectedLevel.replace('_', ' ').toUpperCase();
        
        applicationTypeSection.classList.add('active');
        const info = appTypeLabels[selectedAppType];
        if(info) {
            appTypeText.textContent = info.text;
            appTypeIcon.className = `ki-filled ${info.icon}`;
        }

        // Logic for Mobile Visibility
        updateMobileFieldVisibility();
        
        if (selectedType === 'bed') {
            bedSection.classList.add('active');
            gradeLevelSelect.setAttribute('required', 'required');
            updateGradeDropdown();
            
            if (selectedLevel === 'senior_high') {
                strandSection.style.display = 'block';
                strandSelect.setAttribute('required', 'required');
                
                // ESC logic
                if (selectedAppType === 'transferee') {
                    reqEscContainer.style.display = 'block';
                    reqEscInput.required = true;
                } else {
                    reqEscContainer.style.display = 'none';
                    reqEscInput.required = false;
                }
            } else {
                strandSection.style.display = 'none';
                strandSelect.removeAttribute('required');
                reqEscContainer.style.display = 'none';
                reqEscInput.required = false;
            }
            
            // Auto Scroll to Grade specifics
            scrollToSection('bedSection');
        } else {
            bedSection.classList.remove('active');
            gradeLevelSelect.removeAttribute('required');
            strandSelect.removeAttribute('required');
            // Auto Scroll to Student Details
            scrollToSection('section-student');
        }
        
        checkGlobalValidity();
    }

    function updateMobileFieldVisibility() {
        const input = document.getElementById('contactNumber');
        if (selectedLevel === 'elementary') {
            studentMobileContainer.style.display = 'none';
            input.removeAttribute('required');
        } else {
            studentMobileContainer.style.display = 'block';
            // Optional for 7-SHS as per your prompt in code ("Mobile Number (Optional)"), so no required attr needed
        }
    }

    function updateGradeDropdown() {
        gradeLevelSelect.innerHTML = '<option value="">Select grade level</option>';
        const levels = gradeLevels[selectedLevel] || [];
        levels.forEach(lvl => {
            const val = lvl.toLowerCase().replace(' ', '_');
            gradeLevelSelect.add(new Option(lvl, val));
        });
    }

    changeLevelBtn.addEventListener('click', resetLevelSelection);
    changeTypeBtn.addEventListener('click', () => {
        if(selectedType === 'tertiary') tertiaryModal.classList.add('active');
        else bedModal.classList.add('active');
    });

    // Validations
    function validateField(input, errorId) {
        if (input.offsetParent === null) return true; // Hidden fields are valid
        if (!input.hasAttribute('required') && input.value.trim() === '') return true;
        
        const isValid = input.value.trim() !== '';
        const errorEl = document.getElementById(errorId);
        if(errorEl) {
            if(!isValid) {
                input.classList.add('is-invalid');
                errorEl.classList.add('show');
            } else {
                input.classList.remove('is-invalid');
                errorEl.classList.remove('show');
            }
        }
        return isValid;
    }

    form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        // Force check validity one last time
        if (!checkGlobalValidity()) {
            // Find first error and scroll
            const firstError = document.querySelector('.error-message.show, .is-invalid, .campus-selector-row');
            if(firstError) firstError.scrollIntoView({behavior: 'smooth', block: 'center'});
            return;
        }

        submitBtn.disabled = true;
        submitText.textContent = 'Submitting...';
        submitIcon.className = 'ki-filled ki-loading-circle animate-spin';
        form.submit();
    });

    // Modals Close Logic
    document.querySelectorAll('.modal-overlay').forEach(overlay => {
        overlay.addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });
    });

    // --- Scroll Spy for Sidebar ---
    function initScrollSpy() {
        const steps = document.querySelectorAll('.step-item');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const activeId = entry.target.id;
                    steps.forEach(step => {
                        const targetId = step.dataset.target;
                        const circle = step.querySelector('.step-circle');
                        const info = step.querySelector('.step-info');
                        
                        if (targetId === activeId) {
                            step.setAttribute('aria-current', 'step');
                            circle.classList.add('active');
                            circle.classList.remove('inactive');
                            info.classList.add('active');
                            info.classList.remove('inactive');
                        } else {
                            step.removeAttribute('aria-current');
                            circle.classList.remove('active');
                            circle.classList.add('inactive');
                            info.classList.remove('active');
                            info.classList.add('inactive');
                        }
                    });
                }
            });
        }, { threshold: 0.3, rootMargin: "-10% 0px -50% 0px" });
        
        document.querySelectorAll('section[id^="section-"]').forEach(section => {
            observer.observe(section);
        });
    }

    // --- GLOBAL VALIDITY & PROGRESS BAR ---
    function checkGlobalValidity() {
        // 1. Inputs to track
        let totalItems = 0;
        let filledItems = 0;

        // A. Custom Selectors (Campus & Level)
        totalItems++; // Campus is always required
        if (campusInput.value) filledItems++;

        totalItems++; // Education Level is always required
        if (eduLevelInput.value) filledItems++;

        // B. BED Specifics (Grade & Strand)
        if (selectedType === 'bed') {
            // Grade Level
            totalItems++;
            if (gradeLevelSelect.value) filledItems++;

            // Strand (Only if SHS)
            if (selectedLevel === 'senior_high') {
                totalItems++;
                if (strandSelect.value) filledItems++;
            }
        }

        // C. Standard Form Fields
        const allRequired = Array.from(form.querySelectorAll('input[required]:not(:disabled), select[required]:not(:disabled), textarea[required]:not(:disabled)'));
        
        // Filter only visible fields
        const visibleRequired = allRequired.filter(el => {
            // Check if element is visible and its parent section is visible
            return el.offsetParent !== null && 
                   el.id !== 'campusSelected' && 
                   el.id !== 'educationLevel' &&
                   el.id !== 'gradeLevel' && // Handled manually above
                   el.id !== 'strand';       // Handled manually above
        });

        totalItems += visibleRequired.length;

        visibleRequired.forEach(field => {
            if (field.type === 'checkbox' || field.type === 'radio') {
                if (field.checked) filledItems++;
            } else if (field.type === 'file') {
                if (field.files.length > 0) filledItems++;
            } else {
                if (field.value.trim() !== '') filledItems++;
            }
        });

        // Update Progress Bar
        const progressBar = document.getElementById('mainProgressBar');
        const percent = totalItems === 0 ? 0 : Math.round((filledItems / totalItems) * 100);
        progressBar.style.width = `${percent}%`;

        // Update Submit Button State
        // We require 100% completion to unlock
        const isComplete = (filledItems >= totalItems) && totalItems > 0;
        if (isComplete) {
            submitBtn.disabled = false;
            submitBtn.style.opacity = '1';
            submitBtn.style.cursor = 'pointer';
            submitErrorMessage.style.display = 'none';
        } else {
            submitBtn.disabled = true;
            submitBtn.style.opacity = '0.5';
            submitBtn.style.cursor = 'not-allowed';
            submitErrorMessage.style.display = 'block';
        }

        return isComplete;
    }

    // Initialize
    document.addEventListener('DOMContentLoaded', () => {
        initSelect2();
        initCampus();
        initScrollSpy();
        
        // Listeners for real-time validation
        form.addEventListener('input', checkGlobalValidity);
        form.addEventListener('change', checkGlobalValidity);
        
        // Run once on load
        checkGlobalValidity();
        
        // Animation Observer
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) entry.target.classList.add('visible');
            });
        }, { threshold: 0.1 });
        document.querySelectorAll('.animate-section').forEach(section => observer.observe(section));
    });

})();
</script>
{% endblock %}