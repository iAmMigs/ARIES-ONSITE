{# templates/enrollment-onsite/enroll.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Application{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('metronic/vendors/keenicons/styles.bundle.css') }}" rel="stylesheet"/>
    <link rel="stylesheet" href="{{ asset('css/variables.css') }}?v=2">
    <link rel="stylesheet" href="{{ asset('css/base.css') }}?v=2">
    <link rel="stylesheet" href="{{ asset('css/animations.css') }}?v=2">
    <link rel="stylesheet" href="{{ asset('css/components.css') }}?v=2">
    <link rel="stylesheet" href="{{ asset('css/pages/admission.css') }}?v=22">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    
    <style>
        :root {
            --feu-green-dark: #143d24;
            --feu-green: #1a4d2e;
            --feu-gold: #d4af37; /* Gold 300 approx */
        }

        /* --- 1. STICKY HEADER STYLES --- */
        .aries-sticky-header {
            position: fixed;
            top: 0; left: 0; right: 0; z-index: 999;
            padding: 1.5rem 0;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            background: transparent;
        }
        .aries-sticky-header.scrolled {
            padding: 0.75rem 0;
            background: var(--feu-green-dark);
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        }
        .header-content {
            display: flex;
            align-items: center; justify-content: center; position: relative;
        }
        .header-logo-area {
            position: absolute;
            left: 0; display: flex; align-items: center; gap: 10px;
            opacity: 0; transition: opacity 0.3s;
        }
        .aries-sticky-header.scrolled .header-logo-area { opacity: 1;
        }
        
        .header-title {
            font-weight: 900;
            font-size: 1.5rem; color: white; letter-spacing: 2px;
            opacity: 0; transform: translateY(-10px); transition: all 0.3s;
        }
        .aries-sticky-header.scrolled .header-title {
            opacity: 1;
            transform: translateY(0);
        }

        /* Adjust body padding for sticky header */
        .page-banner { padding-top: 8rem !important;
        }

        /* --- 2. FORM & CARD STYLES --- */
        .text-feu-gold { color: var(--feu-gold) !important;
        }
        
        .campus-selector-row { display: flex;
        gap: 1.5rem; justify-content: center; margin-bottom: 2rem; flex-wrap: wrap; }
        .campus-option {
            background: white;
            border: 2px solid #e5e7eb; border-radius: 16px; padding: 1.5rem; width: 280px;
            cursor: pointer; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative; overflow: hidden;
        }
        .campus-option:hover { transform: translateY(-5px); border-color: var(--feu-green);
        box-shadow: 0 15px 30px rgba(0,0,0,0.08); }
        .campus-option.active { border-color: var(--feu-green-dark); background: #f0fdf4;
        ring: 4px solid rgba(26,77,46,0.1); }
        .campus-option .check-icon {
            position: absolute;
            top: 1rem; right: 1rem; width: 24px; height: 24px; background: var(--feu-green-dark);
            color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center;
            opacity: 0; transform: scale(0); transition: all 0.3s ease;
        }
        .campus-option.active .check-icon { opacity: 1;
        transform: scale(1); }
        
        /* Styled Checkboxes for Family */
        .status-checkbox-group { display: flex;
        gap: 10px; }
        .btn-check-custom { position: absolute; clip: rect(0,0,0,0); pointer-events: none;
        }
        .btn-check-label {
            display: inline-flex;
            align-items: center; gap: 6px; padding: 0.5rem 1rem;
            border: 1px solid #e5e7eb; border-radius: 50px; font-size: 0.85rem; font-weight: 600; color: #6b7280;
            cursor: pointer; transition: all 0.2s; background: white;
        }
        .btn-check-custom:checked + .btn-check-label {
            background-color: #fef3c7;
            color: #92400e; border-color: #f59e0b;
        }
        .btn-check-custom:disabled + .btn-check-label {
            opacity: 0.5;
            cursor: not-allowed; background-color: #f3f4f6;
        }

        /* Sibling Styling */
        .sibling-row { position: relative;
        padding: 1.5rem; background: #f9fafb; border-radius: 8px; border: 1px dashed #d1d5db; margin-bottom: 1rem;
        }
        .btn-remove-sibling {
            position: absolute;
            top: -10px; left: -10px;
            width: 28px; height: 28px; border-radius: 50%;
            background: #ef4444; color: white; border: none;
            display: flex; align-items: center;
            justify-content: center;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1); cursor: pointer; transition: all 0.2s;
        }
        .btn-remove-sibling:hover { background: #dc2626; transform: scale(1.1);
        }

        /* Card Adjustments */
        .card { border: none;
        border-radius: 12px; box-shadow: 0 0 20px rgba(0,0,0,0.03); margin-bottom: 2rem; }
        .card-header { padding: 1.5rem 2rem;
        border-bottom: 1px solid #f3f4f6; background: white; border-top-left-radius: 12px; border-top-right-radius: 12px;
        }
        .card-title { font-size: 1.15rem; font-weight: 700; color: var(--feu-green-dark); margin: 0; display: flex;
        align-items: center; gap: 10px; }
        .card-body { padding: 2rem; background: white; border-bottom-left-radius: 12px;
        border-bottom-right-radius: 12px; }

        .btn-submit {
            background: linear-gradient(135deg, var(--feu-green), var(--feu-green-dark));
            color: white;
            padding: 1rem 3rem; border-radius: 50px; font-weight: 700; border: none;
            box-shadow: 0 10px 20px rgba(26,77,46,0.2); transition: all 0.3s ease;
            width: 100%;
        }
        .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 15px 30px rgba(26,77,46,0.3);
        }
        .btn-submit:disabled { background: #9ca3af; transform: none; box-shadow: none; cursor: not-allowed;
        }

        .form-label { font-weight: 600; color: #374151; font-size: 0.9rem; margin-bottom: 0.5rem;
        }
        .form-control, .form-select { border-radius: 8px; border: 1px solid #d1d5db; padding: 0.75rem 1rem;
        }
        .required { color: #dc2626; margin-left: 2px;
        }
        
        .animate-section { opacity: 0;
        transform: translateY(20px); transition: opacity 0.6s ease, transform 0.6s ease; }
        .animate-section.visible { opacity: 1;
        transform: translateY(0); }
    </style>
{% endblock %}

{% block body %}

{# --- 1. STICKY HEADER --- #}
<header class="aries-sticky-header" id="stickyHeader">
    <div class="container mx-auto px-4 header-content">
        <div class="header-logo-area">
            <i class="ki-filled ki-abstract-26 text-warning fs-1"></i>
        </div>
        <div class="header-title">ARIES</div>
    </div>
</header>

{# --- BANNER --- #}
<section class="page-banner bg-gradient-to-r from-feu-green-900 to-feu-green-800 text-white py-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('{{ asset('images/hero/pic1.jpg') }}')] bg-cover bg-center opacity-10"></div>
    <div class="container mx-auto px-4 relative z-10 text-center pt-10">
        <span class="inline-block py-1 px-3 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-xs font-bold tracking-wider mb-4 animate-fade-in-up">Admissions 2025-2026</span>
        {# TITLE COLOR CHANGED TO FEU GOLD #}
        <h1 class="text-4xl md:text-6xl font-extrabold mb-4 tracking-tight animate-fade-in-up text-feu-gold" style="animation-delay: 0.1s">Application Form</h1>
        <p class="text-lg text-white/80 max-w-2xl mx-auto animate-fade-in-up" style="animation-delay: 0.2s">Begin your journey with Far Eastern University.</p>
    </div>
</section>

<div class="main-content py-16 bg-gray-50">
    <div class="container mx-auto px-4 max-w-5xl">
        
        <form action="{{ path('app_enrollment_apply_submit') }}" method="POST" enctype="multipart/form-data" id="enrollmentForm" class="needs-validation" novalidate>
            
            {# --- CARD 1: ADMISSION DETAILS --- #}
            <div class="card mb-5 animate-section">
                <div class="card-header">
                    <h3 class="card-title"><i class="ki-filled ki-bank text-feu-green-600 fs-1"></i>STEP 1 : Admission Information</h3>
                </div>
                <div class="card-body">
                    <div class="campus-selector-row">
                        <label class="campus-option {{ selected_campus == 'feu_alabang' ?
                        'active' : '' }}" onclick="selectCampus('feu_alabang')">
                            <input type="radio" name="campus_selected" value="feu_alabang" class="d-none" {{ selected_campus == 'feu_alabang' ? 'checked' : '' }} required>
                            <div class="check-icon"><i class="ki-filled ki-check text-white"></i></div>
                            <div class="text-center">
                                <img src="{{ asset('images/hero/alabang.png') }}" class="h-16 mx-auto mb-3" alt="Alabang">
                                <h5 class="font-bold text-gray-800">FEU Alabang</h5>
                                <p class="text-xs text-gray-500">Filinvest City, Alabang</p>
                            </div>
                        </label>

                        <label class="campus-option {{ selected_campus == 'feu_diliman' ?
                        'active' : '' }}" onclick="selectCampus('feu_diliman')">
                            <input type="radio" name="campus_selected" value="feu_diliman" class="d-none" {{ selected_campus == 'feu_diliman' ? 'checked' : '' }}>
                            <div class="check-icon"><i class="ki-filled ki-check text-white"></i></div>
                            <div class="text-center">
                                <img src="{{ asset('images/hero/diliman.png') }}" class="h-16 mx-auto mb-3" alt="Diliman">
                                <h5 class="font-bold text-gray-800">FEU Diliman</h5>
                                <p class="text-xs text-gray-500">Diliman, Quezon City</p>
                            </div>
                        </label>
                    </div>

            
                    <div class="row g-4 mt-4">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Admission Status</label>
                                <select name="admission_status" class="form-select">
                                    <option value="Freshman">Freshman</option>
                                    <option value="Transferee">Transferee</option>
                                    <option value="Cross Enrollee">Cross Enrollee</option>
                                </select>
                            </div>
                        </div>

                        {# --- NEW FIELD: Education Type (Primary/Secondary) --- #}
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Education Type</label>
                                <select name="education_type" id="educationType" class="form-select" required onchange="updateGradeLevels()">
                                    <option value="">Select Type</option>
                                    <option value="Primary">Primary (Kinder - Grade 6)</option>
                                    <option value="Secondary">Secondary (Grade 7 - Grade 12)</option>
                                </select>
                            </div>
                        </div>

                        {# --- UPDATED: Grade Level (Dynamic) --- #}
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Grade Level <span class="required">*</span></label>
                                <select name="grade_level" id="gradeLevel" class="form-select" required onchange="updateStrands()">
                                    <option value="">Select Education Type First</option>
                                </select>
                            </div>
                        </div>
                        
                        {# --- UPDATED: Strand (Only for 11/12) --- #}
                        <div class="col-md-6" id="strandGroup" style="display:none;">
                            <div class="form-group">
                                <label class="form-label">Strand <span class="required">*</span></label>
                                <select name="strand" id="strand" class="form-select">
                                    <option value="">Select Option</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">LRN (Learner Reference No.)</label>
                                <input type="text" name="lrn" class="form-control" placeholder="12-digit LRN" maxlength="12" minlength="12" pattern="\d{12}">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# --- CARD 2: PERSONAL INFORMATION --- #}
            <div class="card mb-5 animate-section">
                <div class="card-header">
                    <h3 class="card-title"><i class="ki-filled ki-user text-feu-green-600 fs-1"></i>STEP 2 : Personal Information</h3>
                </div>
                <div class="card-body">
                    {# 2x2 Photo Upload #}
                    <div class="row mb-5 justify-content-center">
                        <div class="col-md-6">
                            <div class="file-upload-group p-4 border rounded bg-light text-center">
                                <label class="form-label d-block mb-3">2x2 ID Picture <span class="required">*</span></label>
                                <input type="file" name="req_id_picture" id="reqIdPicture" class="form-control" required accept=".jpg,.jpeg,.png">
                                <p class="text-xs text-gray-500 mt-2">White background, formal attire. Max 5MB.</p>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-3">
                            <label class="form-label">Last Name <span class="required">*</span></label>
                            <input type="text" name="last_name" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">First Name <span class="required">*</span></label>
                            <input type="text" name="first_name" class="form-control" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Middle Name</label>
                            <input type="text" name="middle_name" class="form-control">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Suffix</label>
                            <input type="text" name="suffix" class="form-control" placeholder="e.g. Jr.">
                        </div>
                    </div>

                    <div class="row g-4 mt-2">
                        <div class="col-md-4">
                            <label class="form-label">Date of Birth <span class="required">*</span></label>
                            <input type="date" name="birthday" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Birth Place <span class="required">*</span></label>
                            <input type="text" name="birth_place" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Gender <span class="required">*</span></label>
                            <select name="gender" class="form-select" required>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-4 mt-2">
                        <div class="col-md-6">
                            <label class="form-label">Religion</label>
                            <input type="text" name="religion" class="form-control">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Citizenship <span class="required">*</span></label>
                            <select name="citizenship" id="citizenshipSelect" class="form-select" required>
                                <option value="Filipino">Filipino</option>
                                <option value="Foreign">Foreign</option>
                                <option value="Dual">Dual Citizenship</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="row g-4 mt-2">
                        <div class="col-md-12">
                            <label class="form-label">Indigenous Group</label>
                            <input type="text" name="indigenous_group" class="form-control" placeholder="If applicable">
                        </div>
                    </div>

                    {# VISA SECTION #}
                    <div id="visaSection" class="mt-4 p-4 bg-light rounded border border-dashed border-gray-300" style="display: none;">
                        <h5 class="text-primary fw-bold mb-3">Visa Details (For Foreign/Dual Citizens)</h5>
                        <div class="row g-4">
                            <div class="col-md-4">
                                <label class="form-label">Passport Number</label>
                                <input type="text" name="passport_number" class="form-control">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Visa Type</label>
                                <input type="text" name="visa_type" class="form-control">
                            </div>
                             <div class="col-md-4">
                                <label class="form-label">Visa Status</label>
                                <input type="text" name="visa" class="form-control">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# --- CARD 3: CONTACT & ADDRESS --- #}
            <div class="card mb-5 animate-section">
                <div class="card-header">
                    <h3 class="card-title"><i class="ki-filled ki-map text-feu-green-600 fs-1"></i>STEP 3 : Contact & Address</h3>
                </div>
                <div class="card-body">
                    <div class="row g-4 mb-5">
                        <div class="col-md-4">
                            <label class="form-label">Mobile Number <span class="required">*</span></label>
                            <input type="tel" name="contact_number" class="form-control" required placeholder="09xxxxxxxxx" maxlength="11" minlength="11" pattern="\d{11}">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Email Address <span class="required">*</span></label>
                            <input type="email" name="email" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Landline</label>
                            <input type="tel" name="landline" class="form-control">
                        </div>
                    </div>

                    <h5 class="fw-bold text-gray-600 mb-3 border-bottom pb-2">Current Address</h5>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Region <span class="required">*</span></label>
                            <select id="addr_region" name="region" class="form-select" required data-control="select2" data-placeholder="Select Region">
                                <option value=""></option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Province <span class="required">*</span></label>
                            <select id="addr_province" name="address_province" class="form-select" required disabled>
                                <option value=""></option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">City/Municipality <span class="required">*</span></label>
                            <select id="addr_city" name="address_city" class="form-select" required disabled>
                                <option value=""></option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Barangay <span class="required">*</span></label>
                            <select id="addr_barangay" name="address_barangay" class="form-select" required disabled>
                                <option value=""></option>
                            </select>
                        </div>
                        <div class="col-12 mt-3">
                            <label class="form-label">House No. / Street / Bldg <span class="required">*</span></label>
                            <input type="text" name="address" class="form-control" required>
                        </div>
                        <div class="col-md-12 mt-2">
                            <label class="form-label">Zip Code <span class="required">*</span></label>
                            <input type="text" name="address_zip" id="addr_zip" class="form-control" required placeholder="Enter Zip Code">
                        </div>
                    </div>

                    <h5 class="fw-bold text-gray-600 mt-5 mb-3 border-bottom pb-2">Permanent Address</h5>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="sameAsCurrent" onchange="togglePermanentAddress()" checked>
                        <label class="form-check-label text-sm" for="sameAsCurrent">Same as Current Address</label>
                    </div>

                    <div id="permanentAddressBlock" style="display:none;">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Region <span class="required">*</span></label>
                                <select id="perm_region" name="perm_region" class="form-select" data-control="select2" data-placeholder="Select Region">
                                    <option value=""></option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Province <span class="required">*</span></label>
                                <select id="perm_province" name="perm_province" class="form-select" disabled>
                                    <option value=""></option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">City/Municipality <span class="required">*</span></label>
                                <select id="perm_city" name="perm_city" class="form-select" disabled>
                                    <option value=""></option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Barangay <span class="required">*</span></label>
                                <select id="perm_barangay" name="perm_barangay" class="form-select" disabled>
                                    <option value=""></option>
                                </select>
                            </div>
                            <div class="col-12 mt-3">
                                <label class="form-label">House No. / Street / Bldg <span class="required">*</span></label>
                                <input type="text" name="perm_address" class="form-control">
                            </div>
                            <div class="col-md-12 mt-2">
                                <label class="form-label">Zip Code <span class="required">*</span></label>
                                <input type="text" name="perm_zip" id="perm_zip" class="form-control" placeholder="Enter Zip Code">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# --- CARD 4: FAMILY BACKGROUND --- #}
            <div class="card mb-5 animate-section">
                <div class="card-header">
                    <h3 class="card-title"><i class="ki-filled ki-people text-feu-green-600 fs-1"></i>STEP 4 : Family Background</h3>
                </div>
                <div class="card-body">
                    
                    {# Father #}
                    <div class="bg-gray-50 p-5 rounded mb-5">
                        <h6 class="fw-bold text-dark mb-4 border-bottom pb-2">Father's Information</h6>
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label class="form-label">Last Name <span class="required">*</span></label>
                                <input type="text" name="father_lastname" class="form-control" placeholder="Last Name" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">First Name <span class="required">*</span></label>
                                <input type="text" name="father_firstname" class="form-control" placeholder="First Name" required>
                            </div>
                        </div>
                        <div class="row g-4">
                            <div class="col-md-4">
                                <label class="form-label">Occupation</label>
                                <input type="text" name="father_occupation" class="form-control" placeholder="Occupation">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Contact No. <span class="required">*</span></label>
                                <input type="tel" name="father_contact" class="form-control" placeholder="Contact No." required maxlength="11" minlength="11" pattern="\d{11}">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label d-block">Status</label>
                                <div class="status-checkbox-group">
                                    <input type="checkbox" class="btn-check-custom" id="f_deceased" name="father_deceased" value="1" onchange="toggleParentStatus('f_deceased', 'f_ofw')">
                                    <label class="btn-check-label" for="f_deceased">
                                        <i class="ki-filled ki-cross-circle"></i> Deceased
                                    </label>

                                    <input type="checkbox" class="btn-check-custom" id="f_ofw" name="father_ofw" value="1" onchange="toggleParentStatus('f_ofw', 'f_deceased')">
                                    <label class="btn-check-label" for="f_ofw">
                                        <i class="ki-filled ki-airplane"></i> OFW
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Mother #}
                    <div class="bg-gray-50 p-5 rounded mb-5">
                        <h6 class="fw-bold text-dark mb-4 border-bottom pb-2">Mother's Information</h6>
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label class="form-label">Maiden Name <span class="required">*</span></label>
                                <input type="text" name="mother_lastname" class="form-control" placeholder="Maiden Name" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">First Name <span class="required">*</span></label>
                                <input type="text" name="mother_firstname" class="form-control" placeholder="First Name" required>
                            </div>
                        </div>
                        <div class="row g-4">
                            <div class="col-md-4">
                                <label class="form-label">Occupation</label>
                                <input type="text" name="mother_occupation" class="form-control" placeholder="Occupation">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Contact No. <span class="required">*</span></label>
                                <input type="tel" name="mother_contact" class="form-control" placeholder="Contact No." required maxlength="11" minlength="11" pattern="\d{11}">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label d-block">Status</label>
                                <div class="status-checkbox-group">
                                    <input type="checkbox" class="btn-check-custom" id="m_deceased" name="mother_deceased" value="1" onchange="toggleParentStatus('m_deceased', 'm_ofw')">
                                    <label class="btn-check-label" for="m_deceased">
                                        <i class="ki-filled ki-cross-circle"></i> Deceased
                                    </label>

                                    <input type="checkbox" class="btn-check-custom" id="m_ofw" name="mother_ofw" value="1" onchange="toggleParentStatus('m_ofw', 'm_deceased')">
                                    <label class="btn-check-label" for="m_ofw">
                                        <i class="ki-filled ki-airplane"></i> OFW
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Guardian #}
                    <div class="bg-blue-50 p-5 rounded">
                        <h6 class="fw-bold text-dark mb-4">Guardian / Emergency Contact</h6>
                        <div class="row g-4">
                            <div class="col-md-4">
                                <label class="form-label">Full Name <span class="required">*</span></label>
                                <input type="text" name="guardian_name" class="form-control" placeholder="Full Name" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Relationship <span class="required">*</span></label>
                                <input type="text" name="guardian_relation" class="form-control" placeholder="Relationship" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Contact No. <span class="required">*</span></label>
                                <input type="tel" name="guardian_contact" class="form-control" placeholder="Contact No." required maxlength="11" minlength="11" pattern="\d{11}">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# --- CARD 5: EDUCATION --- #}
            <div class="card mb-5 animate-section">
                <div class="card-header">
                    <h3 class="card-title"><i class="ki-filled ki-teacher text-feu-green-600 fs-1"></i>STEP 5 : Education History</h3>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-8">
                            <label class="form-label">Last School Attended <span class="required">*</span></label>
                            <input type="text" name="prev_school_name" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">School Year End</label>
                            <input type="text" name="prev_school_year" class="form-control" placeholder="e.g. 2024">
                        </div>
                    </div>
                </div>
            </div>

            {# --- CARD 6: SIBLINGS (Left Delete Button) --- #}
            <div class="card mb-5 animate-section">
                <div class="card-header">
                    <h3 class="card-title"><i class="ki-filled ki-profile-user text-feu-green-600 fs-1"></i> Siblings (Enrolled in FEU)</h3>
                </div>
                <div class="card-body">
                    <div id="siblings_container">
                        {# Dynamic Rows #}
                    </div>
                    <button type="button" class="btn btn-sm btn-light-primary mt-3" onclick="addSibling()">
                        <i class="ki-filled ki-plus"></i> Add Sibling
                    </button>
                </div>
            </div>

            {# --- CARD 7: REQUIREMENTS --- #}
            <div class="card mb-5 animate-section">
                <div class="card-header">
                    <h3 class="card-title"><i class="ki-filled ki-folder-added text-feu-green-600 fs-1"></i>STEP 6 : Submission of Documents</h3>
                </div>
                <div class="card-body">
                     <div class="file-upload-group mb-4">
                        <label class="form-label d-block">PSA Birth Certificate <span class="required">*</span></label>
                        <input type="file" name="req_psa" class="form-control" required accept=".pdf,.jpg,.png">
                    </div>
                    
                    <div class="file-upload-group mb-4">
                        <label class="form-label d-block">Report Card (Form 138) <span class="required">*</span></label>
                        <input type="file" name="req_card" class="form-control" required accept=".pdf,.jpg,.png">
                    </div>

                    <div class="file-upload-group">
                        <label class="form-label d-block">Good Moral Certificate</label>
                        <input type="file" name="req_moral" class="form-control" accept=".pdf,.jpg,.png">
                    </div>
                </div>
            </div>

            {# --- SUBMIT BUTTON (Locked) --- #}
            <div class="text-center pt-5 pb-10">
                <button type="submit" id="submitBtn" class="btn-submit" disabled>Submit Application</button>
                <div id="submitWarning" class="text-danger fw-bold fs-7 mt-3">
                    <i class="ki-filled ki-information-2 text-danger"></i> Please complete all required fields.
                </div>
            </div>

        </form>
    </div>
</div>

<script>
    // --- Data Dictionaries (Kinder to SHS only) ---
    const strandData = {
        'feu_alabang': ['STEM', 'ABM', 'HUMSS', 'GAS', 'ICT'],
        'feu_diliman': ['STEM', 'ABM', 'HUMSS', 'GAS', 'Sports Track']
    };
    
    const numericFields = ['lrn', 'contact_number', 'father_contact', 'mother_contact', 'guardian_contact'];

    numericFields.forEach(fieldName => {
        const input = document.querySelector(`[name="${fieldName}"]`);
        if (input) {
            input.addEventListener('input', function() {
                // Remove any non-numeric characters immediately
                this.value = this.value.replace(/\D/g, '');
                
                // Force re-validation for the submit button lock
                checkForm(); 
            });
        }
    });

    // --- NEW: Dynamic Grade Dictionary ---
    const educationGrades = {
        'Primary': [
            {val: 'kinder', label: 'Kindergarten'},
            {val: 'grade_1', label: 'Grade 1'},
            {val: 'grade_2', label: 'Grade 2'},
            {val: 'grade_3', label: 'Grade 3'},
            {val: 'grade_4', label: 'Grade 4'},
            {val: 'grade_5', label: 'Grade 5'},
            {val: 'grade_6', label: 'Grade 6'}
        ],
        'Secondary': [
            {val: 'grade_7', label: 'Grade 7'},
            {val: 'grade_8', label: 'Grade 8'},
            {val: 'grade_9', label: 'Grade 9'},
            {val: 'grade_10', label: 'Grade 10'},
            {val: 'grade_11', label: 'Grade 11'},
            {val: 'grade_12', label: 'Grade 12'}
        ]
    };

    let currentCampus = '{{ selected_campus|default("") }}';

    // --- Header Scroll Logic ---
    window.addEventListener('scroll', function() {
        const header = document.getElementById('stickyHeader');
        if (window.scrollY > 100) {
            header.classList.add('scrolled');
        } else {
            header.classList.remove('scrolled');
        }
    });

    // --- Core Logic ---
    function selectCampus(campus) {
        currentCampus = campus;
        // Visual toggle
        document.querySelectorAll('.campus-option').forEach(opt => opt.classList.remove('active'));
        const activeOpt = document.querySelector(`.campus-option input[value="${campus}"]`).parentElement;
        activeOpt.classList.add('active');
        activeOpt.querySelector('input').checked = true;

        // --- NEW: Handle FEU Alabang Restrictions ---
        const eduSelect = document.getElementById('educationType');
        const primaryOption = eduSelect.querySelector('option[value="Primary"]');
        
        // Reset selection
        eduSelect.value = "";
        
        if (campus === 'feu_alabang') {
            // Disable and Hide Primary for Alabang
            if(primaryOption) {
                primaryOption.disabled = true;
                primaryOption.style.display = 'none'; // Visual hide
                primaryOption.hidden = true;          // Attribute hide
            }
        } else {
            // Enable and Show Primary for Diliman
            if(primaryOption) {
                primaryOption.disabled = false;
                primaryOption.style.display = 'block';
                primaryOption.hidden = false;
            }
        }

        updateGradeLevels();
    }

    function updateGradeLevels() {
        const type = document.getElementById('educationType').value;
        const select = document.getElementById('gradeLevel');
        
        select.innerHTML = '<option value="">Select Level</option>';
        
        if (type && educationGrades[type]) {
            educationGrades[type].forEach(grade => {
                // --- NEW: Filter out Junior High (7-10) if Alabang is selected ---
                if (currentCampus === 'feu_alabang' && type === 'Secondary') {
                    if (['grade_7', 'grade_8', 'grade_9', 'grade_10'].includes(grade.val)) {
                        return; // Skip this grade
                    }
                }

                const opt = document.createElement('option');
                opt.value = grade.val;
                opt.textContent = grade.label;
                select.appendChild(opt);
            });
        }
        updateStrands();
    }

    function updateStrands() {
        const grade = document.getElementById('gradeLevel').value;
        const strandGroup = document.getElementById('strandGroup');
        const select = document.getElementById('strand');
        
        select.innerHTML = '<option value="">Select Option</option>';
        // Show Strand ONLY if Grade 11 or 12
        if(grade === 'grade_11' || grade === 'grade_12') {
            strandGroup.style.display = 'block';
            select.setAttribute('required', 'required');
            
            const strands = strandData[currentCampus] || [];
            strands.forEach(s => {
                const opt = document.createElement('option');
                opt.value = s;
                opt.textContent = s;
                select.appendChild(opt);
            });
        } else {
            strandGroup.style.display = 'none';
            select.removeAttribute('required');
        }
    }

    // --- REUSABLE ADDRESS LOOKUP FUNCTION ---
    function setupAddressLookup(prefix) {
        const regions = document.getElementById(prefix + '_region');
        const provinces = document.getElementById(prefix + '_province');
        const cities = document.getElementById(prefix + '_city');
        const barangays = document.getElementById(prefix + '_barangay');
        const zip = document.getElementById(prefix + '_zip');

        if(!regions) return;

        fetch('/api/address/regions').then(r => r.json()).then(data => {
            data.forEach(r => regions.innerHTML += `<option value="${r.code}">${r.name}</option>`);
        });

        regions.addEventListener('change', function() {
            provinces.innerHTML = '<option value="">Select Province</option>'; provinces.disabled = true;
            cities.innerHTML = '<option value="">Select City</option>'; cities.disabled = true;
            barangays.innerHTML = '<option value="">Select Barangay</option>'; barangays.disabled = true;
            
            if(this.value) {
                fetch(`/api/address/provinces/${this.value}`).then(r => r.json()).then(data => {
                    data.forEach(p => provinces.innerHTML += `<option value="${p.code}">${p.name}</option>`);
                    provinces.disabled = false;
                });
            }
        });

        provinces.addEventListener('change', function() {
            cities.innerHTML = '<option value="">Select City</option>'; cities.disabled = true;
            if(this.value) {
                fetch(`/api/address/cities/${this.value}`).then(r => r.json()).then(data => {
                    data.forEach(c => cities.innerHTML += `<option value="${c.code}">${c.name}</option>`);
                    cities.disabled = false;
                });
            }
        });

        cities.addEventListener('change', function() {
            barangays.innerHTML = '<option value="">Select Barangay</option>'; barangays.disabled = true;
            if(this.value) {
                fetch(`/api/address/barangays/${this.value}`).then(r => r.json()).then(data => {
                    data.forEach(b => barangays.innerHTML += `<option value="${b.name}" data-zip="${b.zip}">${b.name}</option>`);
                    barangays.disabled = false;
                });
            }
        });

        barangays.addEventListener('change', function() {
            const selected = this.options[this.selectedIndex];
            if(selected.dataset.zip) zip.value = selected.dataset.zip;
        });
    }

    // --- Toggles ---
    function togglePermanentAddress() {
        const isChecked = document.getElementById('sameAsCurrent').checked;
        const block = document.getElementById('permanentAddressBlock');
        block.style.display = isChecked ? 'none' : 'block';
        
        // Handle Required Attributes
        const inputs = block.querySelectorAll('select, input');
        inputs.forEach(i => {
            if (isChecked) {
                i.removeAttribute('required');
                i.value = ""; // Optional: clear values
            } else {
                i.setAttribute('required', 'required');
            }
        });
        // Force re-validation
        document.getElementById('enrollmentForm').dispatchEvent(new Event('change'));
    }

    function toggleParentStatus(currentId, otherId) {
        const current = document.getElementById(currentId);
        const other = document.getElementById(otherId);
        
        if (current.checked) {
            other.disabled = true;
            other.checked = false;
        } else {
            other.disabled = false;
        }
    }

    // --- Dynamic Siblings (Delete on Top Left) ---
    function addSibling() {
        const container = document.getElementById('siblings_container');
        const row = `
            <div class="sibling-row row g-3 mb-3 align-items-center">
                <button type="button" class="btn-remove-sibling" onclick="this.closest('.sibling-row').remove()" title="Remove Sibling">
                    <i class="ki-filled ki-trash"></i>
                </button>
                <div class="col-md-5">
                    <label class="form-label text-xs">Name</label>
                    <input type="text" name="sibling_name[]" class="form-control form-control-sm" placeholder="Full Name">
                </div>
                <div class="col-md-4">
                    <label class="form-label text-xs">School/Company</label>
                    <input type="text" name="sibling_school[]" class="form-control form-control-sm" placeholder="School">
                </div>
                 <div class="col-md-3">
                    <label class="form-label text-xs">Student No.</label>
                    <input type="text" name="sibling_student_no[]" class="form-control form-control-sm" placeholder="(If FEU)">
                </div>
            </div>`;
        container.insertAdjacentHTML('beforeend', row);
    }

    // --- Initialization ---
    document.addEventListener('DOMContentLoaded', function() {
        // Init Visa Toggle
        const citizenSelect = document.getElementById('citizenshipSelect');
        const visaSection = document.getElementById('visaSection');
        if(citizenSelect && visaSection) {
            citizenSelect.addEventListener('change', function() {
                if(this.value === 'Foreign' || this.value === 'Dual') {
                    visaSection.style.display = 'block';
                } else {
                    visaSection.style.display = 'none';
                }
            });
        }

        // Init Pre-selection
        if(currentCampus) {
            // If page reloads with alabang selected, trigger the hide logic
            selectCampus(currentCampus);
        } else {
            updateGradeLevels();
        }

        // Animation Observer
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.1 });
        document.querySelectorAll('.animate-section').forEach(section => observer.observe(section));

        // Form Validation (Bootstrap)
        const forms = document.querySelectorAll('.needs-validation');
        Array.prototype.slice.call(forms).forEach(function(form) {
            form.addEventListener('submit', function(event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });

        // Submit Button Lock
        const form = document.getElementById('enrollmentForm');
        const btn = document.getElementById('submitBtn');
        const warning = document.getElementById('submitWarning');

        function checkForm() {
            // Check HTML5 validity
            if (form.checkValidity()) {
                btn.disabled = false;
                warning.style.display = 'none';
            } else {
                btn.disabled = true;
                warning.style.display = 'block';
            }
        }

        form.addEventListener('change', checkForm);
        form.addEventListener('input', checkForm);

        // Init Address Lookups
        setupAddressLookup('addr'); // Current Address
        setupAddressLookup('perm'); // Permanent Address
    });
</script>
{% endblock %}