{# templates/admission/apply.html.twig #}
{# Unified Application Form - Modern Design with Campus Logic #}
{# BED: FEU Diliman (Elementary, JHS, SHS) & FEU Alabang (SHS only) #}
{% extends 'base.html.twig' %}

{% block title %}Application{% endblock %}
{% block og_title %}Apply Now - FEU Enrollment{% endblock %}
{% block og_description %}Start your academic journey at FEU{% endblock %}

{% block stylesheets %}
<link href="{{ asset('metronic/vendors/keenicons/styles.bundle.css') }}" rel="stylesheet"/>
<link rel="stylesheet" href="{{ asset('css/variables.css') }}?v=2">
<link rel="stylesheet" href="{{ asset('css/base.css') }}?v=2">
<link rel="stylesheet" href="{{ asset('css/animations.css') }}?v=2">
<link rel="stylesheet" href="{{ asset('css/components.css') }}?v=2">
<link rel="stylesheet" href="{{ asset('css/pages/admission.css') }}?v=22">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<style>
    /* Campus Selector Styles */
    .campus-selector-row { display: flex; gap: 1.5rem; justify-content: center; margin-bottom: 2rem; flex-wrap: wrap; }
    .campus-option {
        flex: 1; min-width: 280px; max-width: 350px;
        background: #fff; border: 2px solid var(--border-color);
        border-radius: 12px; padding: 2rem; text-align: center;
        cursor: pointer; transition: all 0.3s ease; opacity: 0.7; position: relative;
    }
    .campus-option:hover { border-color: var(--primary-color); opacity: 0.9; transform: translateY(-2px); }
    .campus-option.selected {
        border-color: #1a4d2e !important; background: #f0fdf4 !important;
        opacity: 1 !important; box-shadow: 0 10px 20px rgba(26, 77, 46, 0.15);
    }
    .campus-option.selected::after {
        content: '\2713'; position: absolute; top: 10px; right: 15px;
        color: #1a4d2e; font-size: 1.5rem; font-weight: bold;
    }
    .campus-option i { font-size: 3rem; color: var(--text-muted); margin-bottom: 1rem; display: block; transition: color 0.3s; }
    .campus-option.selected i { color: #1a4d2e; }
    .campus-option h4 { font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-dark); }
    .campus-option p { font-size: 0.9rem; color: var(--text-muted); margin: 0; line-height: 1.4; }
    
    .edu-option.hidden { display: none !important; }
    .section-disabled { opacity: 0.5; pointer-events: none; filter: grayscale(1); transition: all 0.3s ease; }
    .form-section-title { font-weight: 600; color: var(--text-dark); margin-bottom: 1rem; font-size: 1.1rem; border-bottom: 1px solid var(--border-light); padding-bottom: 0.5rem; margin-top: 1.5rem; }
    
    .app-type-container {
        display: flex; align-items: center; justify-content: space-between;
        border: 1px solid var(--border-color); padding: 1rem 1.25rem;
        border-radius: 12px; background: #fff; transition: border-color 0.3s ease;
    }
    .app-type-container:hover { border-color: var(--primary-color); }
    .app-type-info { display: flex; align-items: center; gap: 1rem; }
    .app-type-info i { font-size: 1.5rem; color: var(--primary-color); }
    .app-type-info span { font-weight: 600; font-size: 1.05rem; color: var(--text-dark); }

    .file-upload-group { margin-bottom: 1.25rem; }
    .file-hint { font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem; }
    
    .btn-submit:disabled { opacity: 0.5; cursor: not-allowed; background-color: var(--text-muted) !important; }
</style>
{% endblock %}

{% block body %}
<a href="#main-content" class="skip-link">Skip to main content</a>
<div class="apply-container">
    {# ===== Sidebar Brand Panel ===== #}
    <aside class="brand-panel" role="complementary" aria-label="Application progress sidebar">
        <div class="brand-content">
            <div>
                <a href="{{ path('app_home') }}" class="brand-logo" title="Go to Homepage">
                    <div class="brand-logo-icon">
                        <i class="ki-filled ki-abstract-26" aria-hidden="true"></i>
                    </div>
                    <div class="brand-logo-text">
                        <h2>ARIES</h2>
                        <p>On-site Basic Education</p>
                    </div>
                </a>
                
                <h1 class="brand-title">Start Your<br><span>Academic Journey</span></h1>
                <p class="brand-subtitle">Join the FEU Family. Complete this comprehensive application to begin your enrollment process.</p>
                
                {# Progress Indicator #}
                <div class="brand-progress-modern">
                    <div class="progress-label-row">
                        <span class="progress-label">Application Progress</span>
                    </div>
                    <div class="progress-track">
                        <div class="progress-fill" id="mainProgressBar" style="width: 0%;"></div>
                    </div>
                    <div class="progress-milestones">
                        <span class="milestone active">0%</span>
                        <span class="milestone">25%</span>
                        <span class="milestone">50%</span>
                        <span class="milestone">75%</span>
                        <span class="milestone">100%</span>
                    </div>
                </div>
                
                <nav class="progress-steps" aria-label="Application steps">
                    <div class="step-item" data-target="section-student">
                        <div class="step-circle active">1</div>
                        <div class="step-info active">
                            <h3>Student Details</h3>
                            <p>Personal & Contact Info</p>
                        </div>
                    </div>
                    <div class="step-item" data-target="section-academic">
                        <div class="step-circle inactive">2</div>
                        <div class="step-info inactive">
                            <h3>Academic History</h3>
                            <p>Previous School Info</p>
                        </div>
                    </div>
                    <div class="step-item" data-target="section-parent">
                        <div class="step-circle inactive">3</div>
                        <div class="step-info inactive">
                            <h3>Parent Details</h3>
                            <p>Family Information</p>
                        </div>
                    </div>
                    <div class="step-item" data-target="section-documents">
                        <div class="step-circle inactive">4</div>
                        <div class="step-info inactive">
                            <h3>Submission of Documents</h3>
                            <p>Upload Requirements</p>
                        </div>
                    </div>
                </nav>
            </div>
        </div>
    </aside>
    
    {# ===== Main Form Panel ===== #}
    <main class="form-panel" id="main-content">
        <header class="mobile-header">
            <a href="{{ path('app_home') }}" title="Back to Home" aria-label="Back to homepage">
                <i class="ki-filled ki-arrow-left text-lg" aria-hidden="true"></i>
            </a>
            <div class="mobile-logo">
                <div class="mobile-logo-icon">
                    <i class="ki-filled ki-abstract-26" aria-hidden="true"></i>
                </div>
                <div>
                    <span class="mobile-logo-text">ARIES</span>
                    <span class="mobile-logo-sub">FEU</span>
                </div>
            </div>
            <span style="width: 40px;"></span>
        </header>
        
        <div class="form-wrapper">
            <div class="form-container">
                <div class="form-header">
                    <h1>Registration Form</h1>
                    <p>Select your campus and fill out the details.</p>
                </div>
                
                <form id="applyForm" action="{{ path('app_enrollment_apply_submit') }}" method="POST" enctype="multipart/form-data" novalidate>
                    <input type="hidden" name="campus_selected" id="campusSelected" value="{{ selected_campus|default('') }}">
                    <input type="hidden" name="education_level" id="educationLevel" value="">
                    <input type="hidden" name="education_type" id="educationType" value="">
                    <input type="hidden" name="application_type" id="applicationType" value="">

                    {# ===== Section 0: Campus Selection ===== #}
                    <section class="form-section animate-section" aria-labelledby="campus-select-title" id="section-campus">
                        <div class="section-header">
                            <div class="section-icon"><i class="ki-filled ki-map" aria-hidden="true"></i></div>
                            <div>
                                <h3 class="section-title" id="campus-select-title">Select Campus</h3>
                                <p class="section-subtitle">Where do you intend to enroll?</p>
                            </div>
                        </div>

                        <div class="campus-selector-row">
                            <div class="campus-option" data-value="feu_diliman" role="button" tabindex="0">
                                <img src="{{ asset('images/hero/diliman.png') }}" alt="Campus Logo" class="w-25 h-25 mb-4 mx-auto object-contain">
                                <h4>FEU Diliman</h4>
                                <p>Quezon City<br><small>Kinder, JHS, SHS</small></p>
                            </div>
                            
                            <div class="campus-option" data-value="feu_alabang" role="button" tabindex="0">
                                <img src="{{ asset('images/hero/alabang.png') }}" alt="Campus Logo" class="w-25 h-25 mb-4 mx-auto object-contain">
                                <h4>FEU Alabang</h4>
                                <p>Muntinlupa<br><small>SHS Only</small></p>
                            </div>
                        </div>
                        <div class="error-message" id="campusError" style="text-align:center; margin-top: 0.5rem;"><i class="ki-filled ki-information-2"></i><span>Please select a campus first</span></div>
                    </section>

                    {# ===== Section 1: Education Selector ===== #}
                    <section class="form-section animate-section section-disabled" id="levelSection" aria-labelledby="applying-title">
                        <div class="section-header">
                            <div class="section-icon"><i class="ki-filled ki-graduation-cap" aria-hidden="true"></i></div>
                            <div>
                                <h3 class="section-title" id="applying-title">Intended Grade / Level</h3>
                                <p class="section-subtitle">Select the level you are applying for</p>
                            </div>
                        </div>
                        
                        <div class="education-selector" id="educationSelector" role="radiogroup">
                            <div class="edu-option diliman-only" data-level="elementary" data-type="bed" tabindex="0" role="radio">
                                <div class="edu-circle"><div class="edu-circle-inner"><i class="ki-filled ki-book" aria-hidden="true"></i></div></div>
                                <span class="edu-label">Kindergarten</span>
                                <span class="edu-sublabel">(Kinder)</span>
                            </div>
                            <div class="edu-option diliman-only" data-level="elementary" data-type="bed" tabindex="0" role="radio">
                                <div class="edu-circle"><div class="edu-circle-inner"><i class="ki-filled ki-book" aria-hidden="true"></i></div></div>
                                <span class="edu-label">Elementary</span>
                                <span class="edu-sublabel">(Grade 1 - Grade 6)</span>
                            </div>
                            <div class="edu-option diliman-only" data-level="junior_high" data-type="bed" tabindex="0" role="radio">
                                <div class="edu-circle"><div class="edu-circle-inner"><i class="ki-filled ki-book-open" aria-hidden="true"></i></div></div>
                                <span class="edu-label">Junior High</span>
                                <span class="edu-sublabel">(Grade 7 - 10)</span>
                            </div>
                            <div class="edu-option" data-level="senior_high" data-type="bed" tabindex="0" role="radio">
                                <div class="edu-circle"><div class="edu-circle-inner"><i class="ki-filled ki-teacher" aria-hidden="true"></i></div></div>
                                <span class="edu-label">Senior High</span>
                                <span class="edu-sublabel">(Grade 11 - 12)</span>
                            </div>
                        </div>
                        <div class="error-message" id="educationLevelError" role="alert"><i class="ki-filled ki-information-2"></i><span>Please select a level</span></div>
                        
                        <div class="selected-level-display" id="selectedLevelDisplay">
                            <div class="selected-level-info">
                                <i class="ki-filled ki-check-circle" aria-hidden="true"></i>
                                <span id="selectedLevelText">No level selected</span>
                            </div>
                            <button type="button" class="btn-change" id="changeLevelBtn">Change</button>
                        </div>
                    </section>

                    {# ===== Section 2: Application Type ===== #}
                    <section class="form-section animate-section conditional-section" id="applicationTypeSection">
                        <div class="section-header">
                            <div class="section-icon"><i class="ki-filled ki-document" aria-hidden="true"></i></div>
                            <div>
                                <h3 class="section-title">Application Type</h3>
                                <p class="section-subtitle">Your student status</p>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="app-type-container">
                                <div class="app-type-info">
                                    <i class="ki-filled ki-user-tick" id="appTypeIcon"></i>
                                    <span id="appTypeText">Freshman</span>
                                </div>
                                <button type="button" class="btn-link-sm" id="changeTypeBtn">Change</button>
                            </div>
                        </div>
                    </section>

                    {# ===== Section 3: Grade Specifics (BED Only) ===== #}
                    <section class="form-section animate-section conditional-section" id="bedSection">
                        <div class="section-header">
                            <div class="section-icon"><i class="ki-filled ki-book-open"></i></div>
                            <div>
                                <h3 class="section-title">Grade Level Details</h3>
                                <p class="section-subtitle">Specifics for your enrollment</p>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label" for="gradeLevel">Grade Level <span class="required">*</span></label>
                                <select name="grade_level" id="gradeLevel" class="form-control select-styled">
                                    <option value="">Select grade level</option>
                                </select>
                                <div class="error-message" id="gradeLevelError"><i class="ki-filled ki-information-2"></i><span>Required</span></div>
                            </div>
                            
                            <div class="form-group" id="strandSection" style="display: none;">
                                <label class="form-label" for="strand">SHS Track & Strand <span class="required">*</span></label>
                                <select name="strand" id="strand" class="form-control select-styled">
                                    <option value="">Select track and strand</option>
                                </select>
                                <div class="error-message" id="strandError"><i class="ki-filled ki-information-2"></i><span>Required</span></div>
                            </div>
                        </div>
                    </section>

                    {# ===== Section 4: Student Details (Expanded) ===== #}
                    <section class="form-section animate-section" id="section-student">
                        <div class="section-header">
                            <div class="section-icon"><i class="ki-filled ki-profile-circle"></i></div>
                            <div>
                                <h3 class="section-title">Student Details</h3>
                                <p class="section-subtitle">Personal Information</p>
                            </div>
                        </div>
                        
                        {# Name Fields #}
                        <div class="form-group">
                            <label class="form-label">Full Name <span class="required">*</span></label>
                            <div class="name-row">
                                <div class="name-field">
                                    <input type="text" name="last_name" id="lastName" class="form-control" placeholder="Last Name" required>
                                    <span class="field-label">Last Name*</span>
                                    <div class="error-message" id="lastNameError"><i class="ki-filled ki-information-2"></i><span>Required</span></div>
                                </div>
                                <div class="name-field">
                                    <input type="text" name="first_name" id="firstName" class="form-control" placeholder="First Name" required>
                                    <span class="field-label">First Name*</span>
                                    <div class="error-message" id="firstNameError"><i class="ki-filled ki-information-2"></i><span>Required</span></div>
                                </div>
                                <div class="name-field">
                                    <input type="text" name="middle_name" id="middleName" class="form-control" placeholder="Middle Name">
                                    <span class="field-label">Middle Name</span>
                                </div>
                                <div class="name-field suffix-field">
                                    <select name="suffix" class="form-control">
                                        <option value="">Suffix</option>
                                        <option value="Jr.">Jr.</option>
                                        <option value="Sr.">Sr.</option>
                                        <option value="II">II</option>
                                        <option value="III">III</option>
                                    </select>
                                    <span class="field-label">Suffix</span>
                                </div>
                            </div>
                        </div>

                        {# Contact, Birthday, Gender #}
                        <div class="form-row three-cols">
                            <div class="form-group" id="studentMobileContainer">
                                <label class="form-label" for="contactNumber">Mobile Number</label>
                                <div class="input-wrapper">
                                    <i class="ki-filled ki-phone input-icon-left"></i>
                                    <input type="tel" name="contact_number" id="contactNumber" class="form-control has-icon" placeholder="09XX XXX XXXX" maxlength="11">
                                </div>
                                <div class="error-message" id="contactError"><i class="ki-filled ki-information-2"></i><span>Invalid Format</span></div>
                            </div>

                            <div class="form-group">
                                <label class="form-label" for="birthday">Birthday <span class="required">*</span></label>
                                <input type="date" name="birthday" id="birthday" class="form-control" required>
                                <div class="error-message" id="birthdayError"><i class="ki-filled ki-information-2"></i><span>Required</span></div>
                            </div>
                            
                            <div class="form-group">
                                <label class="form-label" for="gender">Gender <span class="required">*</span></label>
                                <select name="gender" id="gender" class="form-control select-styled" required>
                                    <option value="">Select</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                                <div class="error-message" id="genderError"><i class="ki-filled ki-information-2"></i><span>Required</span></div>
                            </div>
                        </div>

                        {# Extra Personal Details #}
                        <div class="form-row three-cols">
                             <div class="form-group">
                                <label class="form-label">Citizenship <span class="required">*</span></label>
                                <select name="citizenship" class="form-control select-styled" required>
                                    <option value="Filipino">Filipino</option>
                                    <option value="Dual">Dual Citizen</option>
                                    <option value="Foreign">Foreign National</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Religion</label>
                                <input type="text" name="religion" class="form-control" placeholder="Optional">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Mother Tongue <span class="required">*</span></label>
                                <input type="text" name="mother_tongue" class="form-control" required placeholder="e.g. Tagalog">
                            </div>
                        </div>
                        
                        {# Birth Place #}
                         <div class="form-row three-cols">
                             <div class="form-group">
                                <label class="form-label">Birth Country</label>
                                <input type="text" name="birth_country" class="form-control" value="Philippines">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Birth Province</label>
                                <input type="text" name="birth_province" class="form-control">
                            </div>
                             <div class="form-group">
                                <label class="form-label">Birth City/Municipality</label>
                                <input type="text" name="birth_place" class="form-control">
                            </div>
                         </div>
                         
                        <div class="form-row">
                             <div class="form-group">
                                <label class="form-label">LRN (Learner Reference No.)</label>
                                <input type="text" name="lrn" class="form-control" placeholder="12-digit LRN" maxlength="12">
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="email">Email Address</label>
                            <div class="input-wrapper">
                                <i class="ki-filled ki-sms input-icon-left"></i>
                                <input type="email" name="email" id="email" class="form-control has-icon" placeholder="email@example.com">
                            </div>
                            <div class="error-message" id="emailError"><i class="ki-filled ki-information-2"></i><span>Invalid Email</span></div>
                        </div>
                        
                        <h4 class="form-section-title mt-4">Current Address</h4>
                        {# Address Fields Breakdown #}
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Street Address <span class="required">*</span></label>
                                <input type="text" name="address_street" id="addressStreet" class="form-control" placeholder="House No., Street Name" required>
                                <div class="error-message"><i class="ki-filled ki-information-2"></i><span>Required</span></div>
                            </div>
                             <div class="form-group">
                                <label class="form-label">Barangay <span class="required">*</span></label>
                                <input type="text" name="address_barangay" id="addressBarangay" class="form-control" required>
                            </div>
                        </div>
                        
                         <div class="form-row three-cols">
                             <div class="form-group">
                                <label class="form-label">City/Municipality <span class="required">*</span></label>
                                <input type="text" name="address_city" id="addressCity" class="form-control" required>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Province <span class="required">*</span></label>
                                <input type="text" name="address_province" id="addressProvince" class="form-control" required>
                            </div>
                             <div class="form-group">
                                <label class="form-label">Zip Code <span class="required">*</span></label>
                                <input type="text" name="address_zip" id="addressZip" class="form-control" required maxlength="4">
                            </div>
                        </div>
                    </section>

                    {# ===== Section 5: Academic History ===== #}
                    <section class="form-section animate-section" id="section-academic">
                        <div class="section-header">
                            <div class="section-icon"><i class="ki-filled ki-book-square"></i></div>
                            <div>
                                <h3 class="section-title">Academic History</h3>
                                <p class="section-subtitle">Previous School Information</p>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="prevSchool">Previous School Name <span class="required">*</span></label>
                            <input type="text" name="prev_school" id="prevSchool" class="form-control" required>
                            <div class="error-message" id="prevSchoolError"><i class="ki-filled ki-information-2"></i><span>Required</span></div>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="schoolAddress">School Address <span class="required">*</span></label>
                            <input type="text" name="school_address" id="schoolAddress" class="form-control" required>
                            <div class="error-message" id="schoolAddressError"><i class="ki-filled ki-information-2"></i><span>Required</span></div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label" for="schoolEmail">School's Email Address <span class="required">*</span></label>
                                <input type="email" name="school_email" id="schoolEmail" class="form-control" required>
                                <div class="error-message" id="schoolEmailError"><i class="ki-filled ki-information-2"></i><span>Required</span></div>
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="schoolContact">School Contact Number <span class="required">*</span></label>
                                <input type="tel" name="school_contact" id="schoolContact" class="form-control" required>
                                <div class="error-message" id="schoolContactError"><i class="ki-filled ki-information-2"></i><span>Required</span></div>
                            </div>
                        </div>
                    </section>

                    {# ===== Section 6: Parent Details (Expanded) ===== #}
                    <section class="form-section animate-section" id="section-parent">
                        <div class="section-header">
                            <div class="section-icon"><i class="ki-filled ki-people"></i></div>
                            <div>
                                <h3 class="section-title">Parent / Guardian Details</h3>
                                <p class="section-subtitle">Family Background</p>
                            </div>
                        </div>

                        <h4 class="form-section-title">Father's Information</h4>
                        <div class="form-row three-cols">
                            <div class="form-group">
                                <label class="form-label">Last Name <span class="required">*</span></label>
                                <input type="text" name="father_lastname" id="fatherLastname" class="form-control" required>
                                <div class="error-message" id="fatherLastnameError"><i class="ki-filled ki-information-2"></i><span>Required</span></div>
                            </div>
                            <div class="form-group">
                                <label class="form-label">First Name <span class="required">*</span></label>
                                <input type="text" name="father_firstname" id="fatherFirstname" class="form-control" required>
                                <div class="error-message" id="fatherFirstnameError"><i class="ki-filled ki-information-2"></i><span>Required</span></div>
                            </div>
                             <div class="form-group">
                                <label class="form-label">Middle Name</label>
