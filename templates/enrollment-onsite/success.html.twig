{# templates/enrollment-onsite/success.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Application Submitted{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-lg w-full space-y-8 bg-white p-10 rounded-xl shadow-feu border-t-4 border-feu-green-600">
        
        <div class="text-center">
            <div class="mx-auto flex items-center justify-center h-24 w-24 rounded-full bg-green-100 mb-6">
                <i class="ki-filled ki-check-circle text-5xl text-feu-green-600"></i>
            </div>
            
            <h2 class="text-3xl font-extrabold text-gray-900 tracking-tight">Application Received!</h2>
            <p class="mt-3 text-lg text-gray-500">
                Your application to <span class="font-semibold text-feu-green-700">FEU</span> has been successfully submitted.
            </p>
        </div>

        <div class="bg-feu-green-50 rounded-lg border border-feu-green-200 p-6 space-y-4">
            <div class="flex justify-between items-center border-b border-feu-green-200 pb-4">
                <div class="text-left">
                    <p class="text-xs text-feu-green-800 uppercase tracking-wider font-semibold">Admission Control No.</p>
                    <p class="text-2xl font-bold text-feu-green-900 font-mono">{{ adcon }}</p>
                </div>
                <button onclick="copyToClipboard('{{ adcon }}')" class="text-feu-green-600 hover:text-feu-green-800 transition-colors" title="Copy AdCon">
                    <i class="ki-filled ki-copy text-xl"></i>
                </button>
            </div>

            <div class="flex justify-between items-center pt-2">
                <div class="text-left">
                    <p class="text-xs text-feu-green-800 uppercase tracking-wider font-semibold">Student Number</p>
                    <p class="text-2xl font-bold text-feu-green-900 font-mono">{{ student_number }}</p>
                </div>
                <button onclick="copyToClipboard('{{ student_number }}')" class="text-feu-green-600 hover:text-feu-green-800 transition-colors" title="Copy Student ID">
                    <i class="ki-filled ki-copy text-xl"></i>
                </button>
            </div>
        </div>

        <div class="bg-blue-50 border-l-4 border-blue-400 p-4">
            <div class="flex">
                <div class="flex-shrink-0">
                    <i class="ki-filled ki-information-2 text-blue-400 text-xl"></i>
                </div>
                <div class="ml-3">
                    <p class="text-sm text-blue-700">
                        Please save these numbers. You will need your <strong>AdCon Number</strong> to check your application status and pay your examination fees.
                    </p>
                </div>
            </div>
        </div>

        <div class="space-y-4 pt-4">
            <a href="{{ path('app_home') }}" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-feu-green-700 hover:bg-feu-green-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-feu-green-500 transition-all">
                Return to Home
            </a>
            <a href="{{ path('app_enrollment_apply') }}" class="w-full flex justify-center py-3 px-4 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none transition-all">
                Submit Another Application
            </a>
        </div>
    </div>
</div>

<script>
    function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(() => {
            // Simple toast logic or alert
            const btn = event.currentTarget;
            const originalIcon = btn.innerHTML;
            btn.innerHTML = '<i class="ki-filled ki-check text-xl"></i>';
            setTimeout(() => { btn.innerHTML = originalIcon; }, 2000);
        });
    }
</script>
{% endblock %}