{% extends 'base.html.twig' %}

{% block title %}Application Submitted{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-lg w-full bg-white p-8 rounded-2xl shadow-xl text-center space-y-6 border-t-4 border-feu-green-600">
        
        <div class="flex justify-center mb-4">
            <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center">
                <i class="ki-filled ki-check-circle text-5xl text-feu-green-600"></i>
            </div>
        </div>

        <h2 class="text-3xl font-extrabold text-gray-900">Application Received!</h2>
        <p class="text-gray-500">
            Congratulations, <strong>{{ student_name }}</strong>! Your application form has been successfully submitted.
        </p>

        <div class="bg-feu-green-50 border border-feu-green-200 rounded-xl p-6 space-y-4 text-left">
            <div class="flex justify-between items-center border-b border-feu-green-200 pb-3">
                <div>
                    <p class="text-xs font-bold text-gray-500 uppercase tracking-wide">Admission Control No.</p>
                    <p class="text-2xl font-bold text-feu-green-800 font-mono">{{ adcon }}</p>
                </div>
            </div>
            
            <div class="flex justify-between items-center pt-1">
                <div>
                    <p class="text-xs font-bold text-gray-500 uppercase tracking-wide">Student Number</p>
                    <p class="text-2xl font-bold text-feu-green-800 font-mono">{{ student_number }}</p>
                </div>
            </div>
        </div>

        <div class="bg-blue-50 p-4 rounded-lg flex items-start gap-3 text-left">
            <i class="ki-filled ki-information-2 text-blue-500 text-xl mt-0.5"></i>
            <p class="text-sm text-blue-700">
                Please take a screenshot or copy these numbers. You will need your <strong>AdCon Number</strong> to pay for your entrance examination.
            </p>
        </div>

        <div class="pt-4 space-y-3">
            <a href="{{ path('app_home') }}" class="btn-feu-primary w-full block py-3 rounded-lg font-bold shadow-md hover:shadow-lg transition-all">
                Return to Homepage
            </a>
        </div>
    </div>
</div>
{% endblock %}