{# templates/enrollment-onsite/_duplicate_warning_modal.html.twig #}
{# Duplicate Applicant Blocking Modal #}

<div id="duplicateApplicantModal" class="fixed inset-0 z-[100002] hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4 transition-opacity duration-300 opacity-0" role="dialog" aria-modal="true" aria-labelledby="dupModalTitle">
    <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full overflow-hidden transform scale-95 transition-transform duration-300" id="duplicateApplicantDialog">
        
        {# Main Blocked View #}
        <div id="duplicatePromptView" class="p-6 sm:p-8 text-center">
            <div class="w-16 h-16 rounded-2xl bg-red-50 text-red-600 border border-red-200 flex items-center justify-center mx-auto mb-4 shadow-xs">
                <i class="ki-filled ki-shield-cross text-3xl"></i>
            </div>

            <h3 id="dupModalTitle" class="text-xl font-black text-gray-900 text-center tracking-tight">
                Duplicate Registration Blocked
            </h3>
            
            <p class="text-xs text-gray-500 text-center mt-2 leading-relaxed">
                An active application matching your full name, birthdate, and email address already exists in our system.
            </p>

            {# Existing Applicant Details Card #}
            <div class="my-5 bg-gray-50 border border-gray-200 rounded-2xl p-4 space-y-2.5 text-left text-sm">
                <div class="flex items-center justify-between pb-2 border-b border-gray-200/80">
                    <span class="text-xs font-bold text-gray-400 uppercase">Existing Applicant Record</span>
                    <span id="dupStudentNumberBadge" class="font-mono text-xs font-bold text-feu-green-800 bg-feu-green-50 px-2.5 py-0.5 rounded-md border border-feu-green-200"></span>
                </div>
                <div class="grid grid-cols-2 gap-2 text-xs">
                    <div>
                        <span class="text-gray-400 block font-semibold mb-0.5">Full Name</span>
                        <span id="dupApplicantName" class="font-bold text-gray-800 text-sm"></span>
                    </div>
                    <div>
                        <span class="text-gray-400 block font-semibold mb-0.5">Date of Birth</span>
                        <span id="dupApplicantDob" class="font-bold text-gray-800 text-sm"></span>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-2 text-xs pt-2 border-t border-gray-200/50">
                    <div>
                        <span class="text-gray-400 block font-semibold mb-0.5">Email</span>
                        <span id="dupApplicantEmail" class="font-bold text-gray-800 text-sm break-all"></span>
                    </div>
                    <div>
                        <span class="text-gray-400 block font-semibold mb-0.5">Application Date</span>
                        <span id="dupApplicantApplied" class="font-medium text-gray-700"></span>
                    </div>
                </div>
            </div>

            <p class="text-xs text-gray-600 text-center mb-6 leading-relaxed">
                To prevent duplicate student accounts and conflicting records, new submissions under these credentials are not allowed. Please keep your existing student number for inquiries and enrollment tracking.
            </p>

            <div class="flex flex-col sm:flex-row gap-3">
                <button type="button" 
                        onclick="closeDuplicateApplicantModal()" 
                        class="px-4 py-3 rounded-xl font-bold text-sm text-gray-700 bg-gray-100 hover:bg-gray-200 border border-gray-300 transition-all flex items-center justify-center gap-1.5 cursor-pointer flex-1">
                    <i class="ki-filled ki-pencil text-base"></i> Review Form
                </button>
                <a href="{% if selected_campus is defined and selected_campus == 'feu_alabang' %}{{ path('app_home_alabang') }}{% else %}{{ path('app_home_diliman') }}{% endif %}" 
                   class="px-4 py-3 rounded-xl font-bold text-sm text-white bg-feu-green-800 hover:bg-feu-green-900 transition-all shadow-md flex items-center justify-center gap-1.5 flex-1">
                    <i class="ki-filled ki-home text-base"></i> Back to Homepage
                </a>
            </div>
        </div>

    </div>
</div>
