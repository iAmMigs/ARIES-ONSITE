                                    {% set source_details = [
                                        {'name': 'Brochures/Flyers', 'icon': 'ki-document'},
                                        {'name': 'Banner', 'icon': 'ki-flag'},
                                        {'name': 'Campus Tour', 'icon': 'ki-geolocation'},
                                        {'name': 'Events', 'icon': 'ki-calendar'},
                                        {'name': 'Social Media', 'icon': 'ki-share'},
                                        {'name': 'Google/Website', 'icon': 'ki-compass'},
                                        {'name': 'Immersion', 'icon': 'ki-user-square'},
                                        {'name': 'Phone Inquiry', 'icon': 'ki-phone'},
                                        {'name': 'Poster', 'icon': 'ki-abstract-26'},
                                        {'name': 'Friends', 'icon': 'ki-users'},
                                        {'name': 'Family/Relatives', 'icon': 'ki-people'},
                                        {'name': 'School Visit/Career Talk', 'icon': 'ki-teacher'},
                                        {'name': 'Visibility: Signage/Billboard', 'icon': 'ki-eye'},
                                        {'name': 'Walk-in', 'icon': 'ki-exit-right'}
                                    ] %}
                                    {% for source in source_details %}
