                    <h3 class="card-title"><i class="ki-filled ki-questionnaire text-feu-green-600 fs-1"></i>STEP 7 : Survey</h3>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="form-label">How did you learn about {{ selected_campus == 'feu_alabang' ? 'FEU Alabang' : 'FEU Diliman' }}?<span class="required">*</span></label>
