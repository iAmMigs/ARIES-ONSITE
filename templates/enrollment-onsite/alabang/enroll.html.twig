                                            <input type="radio" name="marketing_source" id="source_{{ loop.index }}" value="{{ source.name }}" required class="survey-radio-input" onchange="toggleOtherSource()">
                                            <label for="source_{{ loop.index }}" class="survey-option-label">
                                                <div class="survey-icon-container">
                                                    <i class="ki-filled {{ source.icon }} fs-3"></i>
                                                </div>
                                                <span class="survey-option-text">{{ source.name }}</span>
