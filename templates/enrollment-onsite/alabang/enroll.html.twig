                                                    <i class="ki-filled ki-verify"></i>
                                                </div>
                                            </label>
                                        </div>
                                    {% endfor %}
                                    <div class="survey-option-card">
                                        <input type="radio" name="marketing_source" id="source_other" value="Other" required class="survey-radio-input" onchange="toggleOtherSource()">
                                        <label for="source_other" class="survey-option-label">
