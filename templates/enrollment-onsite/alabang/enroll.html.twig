                                    <div id="educ_kinder_0_province_suggestions" class="autocomplete-suggestions hidden"></div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label text-[10px] font-bold text-gray-500 uppercase mb-1">City/Municipality</label>
                                    <select id="educ_kinder_0_city" name="educ_kinder_city[]" class="form-select form-select-sm" disabled data-placeholder="City/Municipality">
                                        <option value=""></option>
                                    </select>
                                </div>
                            </div>
                            
                            <div class="row g-2 mt-2 location-intl-group" id="educ_kinder_0_intl_group" style="display:none;">
                                <div class="col-md-6">
                                    <label class="form-label text-[10px] font-bold text-gray-500 uppercase mb-1">Country</label>
                                    <select name="educ_kinder_country[]" class="form-select form-select-sm country-select" data-placeholder="Country">
