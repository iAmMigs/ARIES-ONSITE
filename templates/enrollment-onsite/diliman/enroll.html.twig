<script>
    function toggleOtherSource() {
        const otherInput = document.getElementById('marketing_source_other');
        const isOther = document.getElementById('source_other').checked;
        otherInput.style.display = isOther ? 'block' : 'none';
        otherInput.required = isOther;
    }

    const loader = document.getElementById('enrollmentLoader');
    if (loader) {
        const minLoadTime = 1500;
        const startTime = Date.now();
        
        window.addEventListener('load', function() {
            const timeElapsed = Date.now() - startTime;
            const remainingTime = Math.max(0, minLoadTime - timeElapsed);
            
            setTimeout(() => {
                loader.style.opacity = '0';
                loader.style.visibility = 'hidden';
                setTimeout(() => loader.remove(), 500);
            }, remainingTime); 
        });
    }

    // FEU Diliman specialized missing document warning flow overrides
    document.addEventListener('DOMContentLoaded', function() {
        // Override the global showDocWarningModal from enrollment.js to use our new premium waiver modal
        window.showDocWarningModal = function(missingDocs) {
            if (typeof window.showPremiumWaiverModal === 'function') {
                window.showPremiumWaiverModal(missingDocs);
            }
        };

        // We no longer need the confirmWaiverSubmission here because it's defined in premium_waiver_modal.html.twig
        
        const lrnInput = document.getElementById('lrnInput');
        if (lrnInput) {
            lrnInput.addEventListener('blur', function() {
                const lrn = this.value;
                if(lrn.length === 12) {
                    fetch('{{ path("app_enrollment_diliman_check_lrn") }}?lrn=' + encodeURIComponent(lrn))
                        .then(r => r.json())
                        .then(data => {
                            if (data.exists) {
                                this.classList.add('is-invalid', 'border-red-400');
                                this.setCustomValidity('LRN is already taken');
                                if (window.showToast) window.showToast('The provided LRN is already registered in the system.', 'error');
                            } else {
                                this.classList.remove('is-invalid', 'border-red-400');
                                this.setCustomValidity('');
                            }
                        });
                }
            });
        }
    });
</script>

