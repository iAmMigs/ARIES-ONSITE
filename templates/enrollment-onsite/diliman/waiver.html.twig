{% extends 'base.html.twig' %}

{% block title %}Document Submission Waiver | ARIES Diliman{% endblock %}

{% block stylesheets %}
    <link href="{{ asset('metronic/vendors/keenicons/styles.bundle.css') }}" rel="stylesheet"/>
    <link rel="stylesheet" href="{{ asset('css/variables.css') }}?v=2">
    <link rel="stylesheet" href="{{ asset('css/animations.css') }}?v=2">
    
    <style>
        :root {
            --feu-green: #1a4d2e;
            --feu-green-dark: #143d24;
            --feu-green-light: #2d6a4f;
            --feu-gold: #d4af37;
            --feu-gold-light: #fde68a;
        }

        /* Premium Paper-Like Form Container */
        .paper-container {
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05), 0 1px 3px rgba(0, 0, 0, 0.02);
            border: 1px solid rgba(0, 0, 0, 0.06);
            overflow: hidden;
            position: relative;
        }

        .paper-header-strip {
            height: 12px;
            background: linear-gradient(90deg, var(--feu-green) 0%, var(--feu-green-dark) 50%, var(--feu-gold) 100%);
        }

        .paper-watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-15deg);
            font-size: 8rem;
            font-weight: 900;
            color: rgba(26, 77, 70, 0.02);
            pointer-events: none;
            user-select: none;
            white-space: nowrap;
            z-index: 1;
        }

        .paper-content {
            position: relative;
            z-index: 2;
            padding: 3rem 2.5rem;
        }

        @media (max-width: 768px) {
            .paper-content {
                padding: 1.75rem 1.25rem;
            }
        }

        /* Document Table Styling */
        .requirement-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }
        .requirement-table th {
            background-color: #f8fafc;
            border-bottom: 2px solid #e2e8f0;
            color: #334155;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 0.75rem 1rem;
            text-align: left;
        }
        .requirement-table td {
            border-bottom: 1px solid #f1f5f9;
            padding: 0.75rem 1rem;
            color: #475569;
            vertical-align: top;
        }
        .requirement-table tr:hover td {
            background-color: #f8fafc;
        }

        /* Checkbox list cards */
        .interactive-check-card {
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            background: #ffffff;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }
        .interactive-check-card:hover {
            border-color: var(--feu-green-light);
            box-shadow: 0 4px 12px rgba(26, 77, 46, 0.05);
            transform: translateY(-1px);
        }
        .interactive-check-card.checked {
            border-color: var(--feu-green);
            background: #f0fdf4;
        }
        .interactive-check-card.checked::before {
            content: '';
            position: absolute;
            left: 0; top: 0; bottom: 0;
            width: 4px;
            background-color: var(--feu-green);
        }

        /* Date picker premium focus effect */
        .date-picker-wrapper input:focus {
            border-color: var(--feu-green) !important;
            box-shadow: 0 0 0 4px rgba(26, 77, 46, 0.15) !important;
        }

        /* Floating header styling */
        .aries-sticky-header {
            position: fixed;
            top: 0; left: 0; right: 0; z-index: 999;
            padding: 0.75rem 0;
            background: var(--feu-green-dark);
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        }
        .header-content {
            display: flex;
            align-items: center; justify-content: center; position: relative;
        }
        .header-logo-area {
            position: absolute;
            left: 0; display: flex; align-items: center; gap: 8px;
            color: white; text-decoration: none; cursor: pointer;
            transition: color 0.3s ease;
        }
        .header-logo-area:hover {
            color: var(--feu-gold) !important;
        }
        .header-title {
            font-weight: 900;
            font-size: 1.5rem; color: white; letter-spacing: 2px;
        }

        .page-banner-padding {
            padding-top: 5rem !important;
        }

        /* Signature Verification box styling */
        .signature-verify-box {
            background-color: #f8fafc;
            border: 2px dashed #cbd5e1;
            border-radius: 12px;
            transition: all 0.3s ease;
        }
        .signature-verify-box.verified {
            background-color: #f0fdf4;
            border-color: #22c55e;
        }
        
        /* Subtle custom checkbox animations */
        .custom-checkbox-input:checked + .custom-checkbox-design {
            background-color: var(--feu-green);
            border-color: var(--feu-green);
        }
        .custom-checkbox-input:checked + .custom-checkbox-design i {
            transform: scale(1);
            opacity: 1;
        }
    </style>
{% endblock %}

{% block body %}

{# --- STICKY HEADER --- #}
<header class="aries-sticky-header">
    <div class="container mx-auto px-4 header-content">
        <a href="{{ path('app_home_diliman') }}" class="header-logo-area">
            <i class="ki-filled ki-arrow-left fs-2"></i>
            <span class="font-bold text-sm hidden md:block">Go Back</span>
        </a>
        <div class="header-title">ARIES</div>
    </div>
</header>

<div class="min-h-screen bg-slate-50 page-banner-padding pb-16">
    <div class="container mx-auto px-4 max-w-4xl mt-6">
        
        {# --- WARNING BANNER / MISSING DOCUMENTS CALLOUT --- #}
        <div class="mb-8 rounded-2xl bg-amber-50 border border-amber-200 shadow-sm p-6 flex flex-col md:flex-row items-start gap-4 animate-fade-in-up">
            <div class="h-12 w-12 bg-amber-100 rounded-xl flex items-center justify-center text-amber-600 flex-shrink-0">
                <i class="ki-filled ki-warning text-3xl"></i>
            </div>
            <div class="flex-grow">
                <h2 class="text-lg font-black text-amber-900 mb-1">Incomplete Document Submission Waiver Required</h2>
                <p class="text-sm text-amber-800 leading-relaxed">
                    You have chosen to submit your application without uploading the complete set of required documents. 
                    To complete your registration, please review the dynamic waiver terms below and electronically sign the agreement to submit the missing documents on or before <strong class="bg-amber-200 text-amber-900 px-1 rounded">{{ active_sy.promissoryDeadline ? active_sy.promissoryDeadline|date('F j, Y') : 'the specified deadline' }}</strong>.
                </p>
                <div class="mt-4 bg-white/70 border border-amber-100 rounded-xl p-4">
                    <h3 class="text-xs font-bold text-amber-800 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                        <i class="ki-filled ki-folder-drop"></i> Documents Currently Outstanding:
                    </h3>
                    <ul class="grid grid-cols-1 md:grid-cols-2 gap-2">
                        {% for doc in missing_docs %}
                            <li class="flex items-center gap-2 text-sm text-slate-700 font-semibold">
                                <span class="h-1.5 w-1.5 bg-amber-500 rounded-full"></span>
                                {{ doc }}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>

        {# --- PREMIUM WAIVER PAPER FORM --- #}
        <form action="{{ path('app_enrollment_diliman_waiver', { studentNumber: applicant.studentNumber }) }}" method="POST" id="waiverForm" novalidate class="animate-fade-in-up" style="animation-delay: 0.15s">
            <div class="paper-container mb-8">
                <div class="paper-header-strip"></div>
                <span class="paper-watermark">FEU DILIMAN</span>

                <div class="paper-content">
                    {# Brand Header #}
                    <div class="text-center pb-6 mb-8">
                        <div class="text-2xl font-black text-slate-800 tracking-tight flex items-center justify-center gap-2">
                            <span class="text-emerald-800">FEU</span> 
                            <span class="text-amber-500 font-normal">|</span> 
                            <span class="text-emerald-900">DILIMAN</span>
                        </div>
                        <p class="text-xs font-bold text-slate-400 tracking-widest uppercase mt-1">Far Eastern University Diliman Campus</p>
                    </div>

                    {# Student Information Section #}
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8 bg-slate-50 border border-slate-200/80 rounded-xl p-5">
                        <div>
                            <span class="text-2xs font-bold text-slate-400 uppercase tracking-wider block">Candidate Name</span>
                            <span class="text-sm font-extrabold text-slate-800 uppercase">{{ applicant.firstName }} {{ applicant.lastName }}</span>
                        </div>
                        <div>
                            <span class="text-2xs font-bold text-slate-400 uppercase tracking-wider block">Reference Number</span>
                            <span class="text-sm font-extrabold text-[#1a4d2e] tracking-wide font-mono">{{ applicant.studentNumber }}</span>
                        </div>
                        <div>
                            <span class="text-2xs font-bold text-slate-400 uppercase tracking-wider block">Level & Program</span>
                            <span class="text-sm font-extrabold text-slate-800 uppercase">
                                {{ applicant.gradeLevel }} 
                                {% if applicant.trackStrand %}
                                    - {{ applicant.trackStrand }}
                                {% endif %}
                            </span>
                        </div>
                    </div>

                    {# Section 1: Credential Submission Agreement #}
                    <div class="mb-8">
                        <div class="bg-black text-white text-center font-bold py-1.5 uppercase text-[15px] mb-2">
                            CREDENTIAL SUBMISSION & RESERVATION AGREEMENT
                        </div>
                        <div class="text-[13px] font-semibold text-slate-800 mb-6">
                            Applicant is a <strong>CONFIRMED CANDIDATE FOR ADMISSION</strong> on the basis of the following credential/s submitted:
                        </div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 px-8">
                            {# Admissions Requirements #}
                            <div>
                                <div class="font-bold text-slate-800 mb-2 text-sm">Admissions Requirements:</div>
                                <div class="space-y-1.5 ml-6">
                                    {% if is_shs %}
                                        <label class="flex items-center gap-2 text-[13px] text-slate-700">
                                            <input type="checkbox" disabled class="w-3.5 h-3.5 border-gray-400" {% if 'Results of Entrance Exam' not in missing_docs and 'Entrance Exam' not in missing_docs %}checked{% endif %}>
                                            Results of Entrance Exam
                                        </label>
                                        <label class="flex items-center gap-2 text-[13px] text-slate-700">
                                            <input type="checkbox" disabled class="w-3.5 h-3.5 border-gray-400" {% if 'Grade 10 Report Card' not in missing_docs and 'Grade 10 Card' not in missing_docs %}checked{% endif %}>
                                            Grade 10 Report Card
                                        </label>
                                        <label class="flex items-center gap-2 text-[13px] text-slate-700">
                                            <input type="checkbox" disabled class="w-3.5 h-3.5 border-gray-400" {% if 'Good Moral Certificate' not in missing_docs and 'Certificate of Good Moral' not in missing_docs %}checked{% endif %}>
                                            Good Moral Certificate
                                        </label>
                                        <label class="flex items-center gap-2 text-[13px] text-slate-700">
                                            <input type="checkbox" disabled class="w-3.5 h-3.5 border-gray-400" {% if 'PSA Birth Certificate' not in missing_docs and 'Birth Certificate' not in missing_docs %}checked{% endif %}>
                                            PSA Birth Certificate
                                        </label>
                                        <label class="flex items-start gap-2 text-[13px] text-slate-700">
                                            <input type="checkbox" disabled class="w-3.5 h-3.5 border-gray-400 mt-0.5" {% if 'ESC or QVR Certificate' not in missing_docs and 'ESC/QVR' not in missing_docs %}checked{% endif %}>
                                            <span>ESC or QVR Certificate (if available)</span>
                                        </label>
                                        <label class="flex items-start gap-2 text-[13px] text-slate-700">
                                            <input type="checkbox" disabled class="w-3.5 h-3.5 border-gray-400 mt-0.5" {% if 'Grade 11 Report Card' not in missing_docs %}checked{% endif %}>
                                            <span>Grade 11 Report Card (Transferee)</span>
                                        </label>
                                        <label class="flex items-start gap-2 text-[13px] text-slate-700">
                                            <input type="checkbox" disabled class="w-3.5 h-3.5 border-gray-400 mt-0.5" {% if 'Transferee Recommendation Form' not in missing_docs and 'Recommendation Form' not in missing_docs %}checked{% endif %}>
                                            <span>Transferee Recommendation Form<br>(Grade 12 Transferee)</span>
                                        </label>
                                    {% else %}
                                        <label class="flex items-center gap-2 text-[13px] text-slate-700">
                                            <input type="checkbox" disabled class="w-3.5 h-3.5 border-gray-400" {% if 'Results of Entrance Exam' not in missing_docs and 'Entrance Exam' not in missing_docs %}checked{% endif %}>
                                            Results of Entrance Exam
                                        </label>
                                        <label class="flex items-center gap-2 text-[13px] text-slate-700">
                                            <input type="checkbox" disabled class="w-3.5 h-3.5 border-gray-400" {% if 'Current Level Report Card' not in missing_docs and 'Report Card' not in missing_docs %}checked{% endif %}>
                                            Current Level Report Card
                                        </label>
                                        <label class="flex items-center gap-2 text-[13px] text-slate-700">
                                            <input type="checkbox" disabled class="w-3.5 h-3.5 border-gray-400" {% if 'Good Moral Certificate' not in missing_docs and 'Certificate of Good Moral' not in missing_docs %}checked{% endif %}>
                                            Good Moral Certificate
                                        </label>
                                        <label class="flex items-center gap-2 text-[13px] text-slate-700">
                                            <input type="checkbox" disabled class="w-3.5 h-3.5 border-gray-400" {% if 'PSA Birth Certificate' not in missing_docs and 'Birth Certificate' not in missing_docs %}checked{% endif %}>
                                            PSA Birth Certificate
                                        </label>
                                        <label class="flex items-center gap-2 text-[13px] text-slate-700">
                                            <input type="checkbox" disabled class="w-3.5 h-3.5 border-gray-400" {% if 'PEAC Certificate' not in missing_docs %}checked{% endif %}>
                                            PEAC Certificate
                                        </label>
                                        <label class="flex items-start gap-2 text-[13px] text-slate-700">
                                            <input type="checkbox" disabled class="w-3.5 h-3.5 border-gray-400 mt-0.5" {% if 'Transferee Recommendation Form' not in missing_docs and 'Recommendation Form' not in missing_docs %}checked{% endif %}>
                                            <span>Transferee Recommendation Form<br>(Grade 2 to Grade 6) (Grade 8 to Grade 10)</span>
                                        </label>
                                    {% endif %}
                                </div>
                            </div>
                            
                            {# Medical Requirements #}
                            <div>
                                <div class="font-bold text-slate-800 mb-2 text-sm">Medical Requirements:</div>
                                <div class="space-y-1.5 ml-6">
                                    <label class="flex items-center gap-2 text-[13px] text-slate-700">
                                        <input type="checkbox" disabled class="w-3.5 h-3.5 border-gray-400" {% if 'Results of Entrance Exam / Medical clearance' not in missing_docs and 'Medical clearance' not in missing_docs %}checked{% endif %}>
                                        Results of Entrance Exam
                                    </label>
                                    <label class="flex items-center gap-2 text-[13px] text-slate-700">
                                        <input type="checkbox" disabled class="w-3.5 h-3.5 border-gray-400" {% if 'Dental Examination' not in missing_docs %}checked{% endif %}>
                                        Dental Examination
                                    </label>
                                    <label class="flex items-center gap-2 text-[13px] text-slate-700">
                                        <input type="checkbox" disabled class="w-3.5 h-3.5 border-gray-400" {% if 'Chest X-RAY PA' not in missing_docs %}checked{% endif %}>
                                        Chest X-RAY PA
                                    </label>
                                    <label class="flex items-center gap-2 text-[13px] text-slate-700">
                                        <input type="checkbox" disabled class="w-3.5 h-3.5 border-gray-400" {% if 'Others' not in missing_docs and 'Vaccination Records' not in missing_docs %}checked{% endif %}>
                                        Others:________________
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Section 2: AFFILIATION INFORMATION AND NOTICE OF SANCTION UNDERTAKING #}
                    <div class="mb-8 border-t pt-8">
                        <h4 class="text-sm font-black text-emerald-950 uppercase tracking-wider text-center mb-6">
                            AFFILIATION INFORMATION AND NOTICE OF SANCTION UNDERTAKING
                        </h4>



                        {# The 7 points list #}
                        <div class="space-y-4">
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-3">Please certify the following declarations:</p>
                            
                            {# Checkbox 1 #}
                            <div class="interactive-check-card p-4 flex gap-3 items-start" onclick="toggleCardCheckbox('cert_1')">
                                <div class="pt-0.5">
                                    <input type="checkbox" id="cert_1" class="custom-checkbox-input hidden" required>
                                    <div class="custom-checkbox-design w-5 h-5 rounded border border-slate-300 flex items-center justify-center text-white transition-all">
                                        <i class="ki-filled ki-check text-xs transition-transform duration-200 scale-0 opacity-0"></i>
                                    </div>
                                </div>
                                <span class="text-xs font-semibold text-slate-700 leading-relaxed">
                                    1. Non-compliance with the submission of documents will invalidate my admission and enrollment.
                                </span>
                            </div>

                            {# Checkbox 2 #}
                            <div class="interactive-check-card p-4 flex gap-3 items-start" onclick="toggleCardCheckbox('cert_2')">
                                <div class="pt-0.5">
                                    <input type="checkbox" id="cert_2" class="custom-checkbox-input hidden" required>
                                    <div class="custom-checkbox-design w-5 h-5 rounded border border-slate-300 flex items-center justify-center text-white transition-all">
                                        <i class="ki-filled ki-check text-xs transition-transform duration-200 scale-0 opacity-0"></i>
                                    </div>
                                </div>
                                <span class="text-xs font-semibold text-slate-700 leading-relaxed">
                                    2. The reservation fee of P5,000.00 is non-refundable should I decide not to enroll.
                                </span>
                            </div>

                            {# Checkbox 3 #}
                            <div class="interactive-check-card p-4 flex gap-3 items-start" onclick="toggleCardCheckbox('cert_3')">
                                <div class="pt-0.5">
                                    <input type="checkbox" id="cert_3" class="custom-checkbox-input hidden" required>
                                    <div class="custom-checkbox-design w-5 h-5 rounded border border-slate-300 flex items-center justify-center text-white transition-all">
                                        <i class="ki-filled ki-check text-xs transition-transform duration-200 scale-0 opacity-0"></i>
                                    </div>
                                </div>
                                <span class="text-xs font-semibold text-slate-700 leading-relaxed">
                                    3. There will be Php1,000.00 processing fee should I decide to withdraw my enrollment.
                                </span>
                            </div>

                            {# Checkbox 4 #}
                            <div class="interactive-check-card p-4 flex gap-3 items-start" onclick="toggleCardCheckbox('cert_4')">
                                <div class="pt-0.5">
                                    <input type="checkbox" id="cert_4" class="custom-checkbox-input hidden" required>
                                    <div class="custom-checkbox-design w-5 h-5 rounded border border-slate-300 flex items-center justify-center text-white transition-all">
                                        <i class="ki-filled ki-check text-xs transition-transform duration-200 scale-0 opacity-0"></i>
                                    </div>
                                </div>
                                <span class="text-xs font-semibold text-slate-700 leading-relaxed">
                                    4. Scholarship application is subject for approval of the scholarship committee.
                                </span>
                            </div>

                            {# Checkbox 5 #}
                            <div class="interactive-check-card p-4 flex gap-3 items-start" onclick="toggleCardCheckbox('cert_5')">
                                <div class="pt-0.5">
                                    <input type="checkbox" id="cert_5" class="custom-checkbox-input hidden" required>
                                    <div class="custom-checkbox-design w-5 h-5 rounded border border-slate-300 flex items-center justify-center text-white transition-all">
                                        <i class="ki-filled ki-check text-xs transition-transform duration-200 scale-0 opacity-0"></i>
                                    </div>
                                </div>
                                <span class="text-xs font-semibold text-slate-700 leading-relaxed">
                                    5. Enrollment for this coming term will be null and void in case there will be any medical findings that may affect my studies.
                                </span>
                            </div>

                            {# Checkbox 6 #}
                            <div class="interactive-check-card p-4 flex gap-3 items-start" onclick="toggleCardCheckbox('cert_6')">
                                <div class="pt-0.5">
                                    <input type="checkbox" id="cert_6" class="custom-checkbox-input hidden" required>
                                    <div class="custom-checkbox-design w-5 h-5 rounded border border-slate-300 flex items-center justify-center text-white transition-all">
                                        <i class="ki-filled ki-check text-xs transition-transform duration-200 scale-0 opacity-0"></i>
                                    </div>
                                </div>
                                <span class="text-xs font-semibold text-slate-700 leading-relaxed">
                                    6. Any misinformation shall serve as a ground for the nullification of my enrolment at FEU Diliman.
                                </span>
                            </div>

                            {# Checkbox 7 #}
                            <div class="interactive-check-card p-4 flex gap-3 items-start" onclick="toggleCardCheckbox('cert_7')">
                                <div class="pt-0.5">
                                    <input type="checkbox" id="cert_7" class="custom-checkbox-input hidden" required>
                                    <div class="custom-checkbox-design w-5 h-5 rounded border border-slate-300 flex items-center justify-center text-white transition-all">
                                        <i class="ki-filled ki-check text-xs transition-transform duration-200 scale-0 opacity-0"></i>
                                    </div>
                                </div>
                                <span class="text-xs font-bold text-emerald-950 leading-relaxed">
                                    7. By signing this form, I agree to the terms and conditions, as well as the data privacy stated in this form.
                                </span>
                            </div>
                        </div>
                    </div>

                    {# Footer Document Form Codes #}
                    <div class="mt-12 pt-6 border-t border-slate-100 flex flex-col sm:flex-row justify-between items-center text-[10px] text-slate-400 font-bold tracking-wider">
                        <span>© {{ 'now'|date('Y') }} FAR EASTERN UNIVERSITY DILIMAN</span>
                        <span class="mt-2 sm:mt-0 font-mono uppercase bg-slate-100 text-slate-500 px-3 py-1 rounded">
                            {% if is_shs %}
                                FORM CODE: FO-ADMIN-AERO-002/DIL/11MAR2026/REV.3
                            {% else %}
                                FORM CODE: FO-ADMIN-AERO-003/DIL/11MAR2026/REV.5
                            {% endif %}
                        </span>
                    </div>
                </div>
            </div>

            {# --- SUBMIT WAIVER BUTTONS --- #}
            <div class="flex flex-col sm:flex-row gap-4 justify-end max-w-sm mx-auto">
                <button type="submit" id="btnSubmitWaiver" class="w-full py-4 rounded-xl font-extrabold text-white aries-gradient hover:opacity-90 shadow-lg shadow-feu-green/30 transition-all flex items-center justify-center gap-2 cursor-not-allowed" disabled>
                    Complete Submission
                    <i class="ki-filled ki-arrow-right text-lg"></i>
                </button>
            </div>
        </form>

    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const btnSubmit = document.getElementById('btnSubmitWaiver');

            // Interactive checkboxes card function
            window.toggleCardCheckbox = function(id) {
                const checkbox = document.getElementById(id);
                if (!checkbox) return;
                
                checkbox.checked = !checkbox.checked;
                const card = checkbox.closest('.interactive-check-card');
                if (checkbox.checked) {
                    card.classList.add('checked');
                } else {
                    card.classList.remove('checked');
                }
                
                // Trigger form check
                checkFormValidity();
            };
            
            // Track all checkboxes
            const inputs = document.querySelectorAll('#waiverForm input, #waiverForm select');
            inputs.forEach(input => {
                input.addEventListener('change', checkFormValidity);
            });

            function checkFormValidity() {
                // Check checkboxes
                const certsChecked = [
                    document.getElementById('cert_1').checked,
                    document.getElementById('cert_2').checked,
                    document.getElementById('cert_3').checked,
                    document.getElementById('cert_4').checked,
                    document.getElementById('cert_5').checked,
                    document.getElementById('cert_6').checked,
                    document.getElementById('cert_7').checked
                ].every(v => v === true);

                if (certsChecked) {
                    btnSubmit.disabled = false;
                    btnSubmit.classList.remove('cursor-not-allowed', 'opacity-90');
                } else {
                    btnSubmit.disabled = true;
                    btnSubmit.classList.add('cursor-not-allowed', 'opacity-90');
                }
            }

            // Custom submit validation trigger just in case
            document.getElementById('waiverForm').addEventListener('submit', function(e) {
                if (btnSubmit.disabled) {
                    e.preventDefault();
                    showToast('Please fulfill all terms before submitting.', 'error');
                } else {
                    setLoading(btnSubmit, true, 'Submitting agreement...');
                }
            });
        });
    </script>
{% endblock %}
