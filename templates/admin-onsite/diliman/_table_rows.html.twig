{% for registration in registrations %}
<tr>
    {# Col 1: Photo #}
    <td class="col-img">
        <div class="symbol symbol-40px overflow-hidden me-3">
            <div class="symbol-label">
                {% if registration.profilePicture %}
                    <img src="{{ asset(registration.profilePicture) }}" alt="Student" class="w-100 h-100 object-fit-cover"/>
                {% else %}
                    <div class="symbol-label fs-3 bg-light-success text-success fw-bold d-flex align-items-center justify-content-center h-100 w-100">
                        {{ registration.firstName|first|upper }}
                    </div>
                {% endif %}
            </div>
        </div>
    </td>

    {# Col 2: Student ID #}
    <td>
        <span class="text-gray-800 fw-bold">{{ registration.studentNumber }}</span>
        <span class="text-muted d-block fs-8">AdCon: {{ registration.adConNumber }}</span>
    </td>

    {# Col 3: Full Name #}
    <td>
        <div class="d-flex flex-column">
            <span class="text-gray-800 fw-bold mb-1">
                {{ registration.lastName }}, {{ registration.firstName }}
            </span>
            <span class="text-gray-400 fs-7">{{ registration.personalEmail }}</span>
        </div>
    </td>

    {# Col 4: Level #}
    <td>
        <div class="badge badge-light fw-bolder">{{ registration.gradeLevel }}</div>
        {% if registration.strand %}
            <div class="badge badge-light-primary fw-bolder mt-1">{{ registration.strand }}</div>
        {% endif %}
    </td>

    {# Col 5: Status #}
    <td>
        {% if registration.status == 'Enrolled' %}
            <span class="badge badge-light-success fw-bold">Enrolled</span>
        {% elseif registration.status == 'Pending' %}
            <span class="badge badge-light-warning fw-bold">Pending</span>
        {% else %}
            <span class="badge badge-light-info fw-bold">{{ registration.status }}</span>
        {% endif %}
    </td>

    {# Col 6: Date #}
    <td>
        <span class="text-gray-600 fw-bold">{{ registration.schoolYearStart }}</span>
    </td>

    {# Col 7: Actions (CENTERED) #}
    <td class="text-center">
        <div class="d-flex justify-content-center gap-2">
            <a href="{{ path('app_admin_diliman_registration_view', {'id': registration.id}) }}" class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm" title="View">
                <i class="ki-filled ki-eye fs-3"></i>
            </a>
            
            <a href="{{ path('app_admin_diliman_registration_edit', {'id': registration.id}) }}" class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm" title="Edit">
                <i class="ki-filled ki-pencil fs-3"></i>
            </a>
            
            <form method="post" action="{{ path('app_admin_diliman_delete', {'id': registration.id}) }}" onsubmit="return confirm('Delete this record?');" style="margin:0;">
                <button type="submit" class="btn btn-icon btn-bg-light btn-active-color-danger btn-sm" title="Delete">
                    <i class="ki-filled ki-trash fs-3"></i>
                </button>
            </form>
        </div>
    </td>
</tr>
{% else %}
<tr><td colspan="7" class="text-center py-5 text-gray-500">No registrations found.</td></tr>
{% endfor %}