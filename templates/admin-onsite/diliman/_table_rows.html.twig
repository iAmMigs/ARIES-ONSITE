{% for r in registrations %}
<tr class="hover:bg-gray-50/80 transition-colors group">
    
    {# --- 1. PHOTO COLUMN (Fixed: Circular Format) --- #}
    <td class="px-6 py-3">
        {% if r.photoSlug %}
            {# IMAGE: w-10 h-10 rounded-full object-cover border #}
            <img src="{{ asset(r.photoSlug) }}" class="w-10 h-10 rounded-full object-cover border border-gray-200" alt="Student Photo">
        {% else %}
            {# FALLBACK: w-10 h-10 rounded-full flex center #}
            <div class="w-10 h-10 rounded-full bg-feu-green-100 text-feu-green-700 flex items-center justify-center font-bold text-sm">
                {{ r.firstName|first }}
            </div>
        {% endif %}
    </td>

    {# --- 2. STUDENT ID --- #}
    <td class="px-6 py-3 font-mono text-sm text-gray-600">
        {{ r.studentNumber }}
    </td>

    {# --- 3. FULL NAME --- #}
    <td class="px-6 py-3 font-semibold text-gray-800">
        {{ r.lastName }}, {{ r.firstName }}
    </td>

    {# --- 4. LEVEL / STRAND --- #}
    <td class="px-6 py-3">
        <div class="flex gap-1">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-100">
                {{ r.gradeLevel|replace({'_': ' '})|title }}
            </span>
            {% if r.trackStrand %}
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700 border border-amber-100">
                    {{ r.trackStrand }}
                </span>
            {% endif %}
        </div>
    </td>

    {# --- 5. STATUS --- #}
    <td class="px-6 py-3">
        {% if r.admissionStatus == 'Pending' or r.admissionStatus == 'P' or r.admissionStatus == 'For Payment' %}
            <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-bold bg-yellow-100 text-yellow-800 border border-yellow-200">
                <i class="ki-filled ki-time text-[10px] mr-1"></i> {% if r.educationType == 'SHS' %}Pending Exam{% else %}For Payment{% endif %}
            </span>
        {% elseif r.admissionStatus == 'Paid' %}
            <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-bold bg-blue-100 text-blue-800 border border-blue-200">
                <i class="ki-filled ki-check-tick text-[10px] mr-1"></i> Paid
            </span>
        {% elseif r.admissionStatus == 'Enrolled' %}
            <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-bold bg-green-100 text-green-800 border border-green-200">
                Enrolled
            </span>
        {% else %}
            <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-bold bg-gray-100 text-gray-800 border border-gray-200">
                {{ r.admissionStatus }}
            </span>
        {% endif %}
    </td>

    {# --- 6. DATE APPLIED --- #}
    <td class="px-6 py-3 text-sm text-gray-500">
        {{ r.createdAt|date('M d, Y') }}
    </td>

    {# --- 7. ACTIONS --- #}
    <td class="px-6 py-3 text-center">
        <div class="flex items-center justify-center gap-2">
            {# View Button #}
            <a href="{{ path('app_admin_diliman_registration_view', {'id': r.studentNumber}) }}" class="w-8 h-8 flex items-center justify-center rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-100 transition-colors" title="View Details">
                <i class="ki-filled ki-eye text-lg"></i>
            </a>
            
            {# Edit Button #}
            <a href="{{ path('app_admin_diliman_registration_edit', {'id': r.studentNumber}) }}" class="w-8 h-8 flex items-center justify-center rounded-lg bg-amber-50 text-amber-600 hover:bg-amber-100 transition-colors" title="Edit Application">
                <i class="ki-filled ki-pencil text-lg"></i>
            </a>
        </div>
    </td>
</tr>
{% else %}
<tr>
    <td colspan="7" class="px-6 py-12 text-center text-gray-400 italic">
        No applicants found matching your criteria.
    </td>
</tr>
{% endfor %}