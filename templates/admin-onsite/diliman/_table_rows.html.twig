{% for registration in registrations %}
<tr class="border-bottom border-gray-200">
    {# Col 1: Photo #}
    <td class="ps-4">
        <div class="symbol symbol-40px overflow-hidden me-3">
            <div class="symbol-label">
                {% if registration.photoSlug %}
                    <img src="{{ asset(registration.photoSlug) }}" alt="Student" class="w-100 h-100 object-fit-cover"/>
                {% else %}
                    <div class="symbol-label fs-3 bg-light-primary text-primary fw-bold d-flex align-items-center justify-content-center h-100 w-100">
                        {{ registration.firstName|first|upper }}
                    </div>
                {% endif %}
            </div>
        </div>
    </td>

    {# Col 2: Student ID #}
    <td>
        <span class="text-gray-800 fw-bolder fs-6">{{ registration.studentNumber }}</span>
    </td>

    {# Col 3: AdCon #}
    <td>
        <span class="badge badge-light-dark fw-bolder fs-7 px-3 py-2">{{ registration.adCon }}</span>
    </td>

    {# Col 4: Full Name #}
    <td>
        <div class="d-flex flex-column">
            <a href="#" class="text-gray-800 text-hover-primary mb-1 fs-6 fw-bolder">
                {{ registration.lastName }}, {{ registration.firstName }}
            </a>
        </div>
    </td>

    {# Col 5: Level / Strand #}
    <td>
        <div class="d-flex flex-column gap-2 align-items-start">
            <span class="badge badge-light-primary fw-bolder fs-7 px-3 py-2">
                {{ registration.gradeLevel }}
            </span>
            {% if registration.trackStrand %}
                <span class="badge badge-light-warning fw-bolder fs-7 px-3 py-2">
                    {{ registration.trackStrand }}
                </span>
            {% endif %}
        </div>
    </td>

    {# Col 6: Status #}
    <td>
        {% if registration.admissionStatus == 'Enrolled' %}
            <span class="badge badge-light-success fw-bolder fs-7 px-3 py-2">Enrolled</span>
        {% elseif registration.admissionStatus == 'P' or registration.admissionStatus == 'Pending' %}
            <span class="badge badge-light-warning fw-bolder fs-7 px-3 py-2">Pending</span>
        {% else %}
            <span class="badge badge-light-info fw-bolder fs-7 px-3 py-2">{{ registration.admissionStatus }}</span>
        {% endif %}
    </td>

    {# Col 7: Date #}
    <td>
        <span class="text-gray-600 fw-bold fs-7">{{ registration.schoolYearOfEntry }}</span>
    </td>

    {# Col 8: Actions #}
    <td class="text-center pe-4">
        <div class="d-flex justify-content-center align-items-center gap-2">
            <a href="{{ path('app_admin_diliman_registration_view', {'id': registration.id}) }}" 
               class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm" 
               title="View Details">
                <i class="ki-filled ki-eye fs-3"></i>
            </a>
            
            <a href="{{ path('app_admin_diliman_registration_edit', {'id': registration.id}) }}" 
               class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm" 
               title="Edit Status">
                <i class="ki-filled ki-pencil fs-3"></i>
            </a>
            
            <form method="post" action="{{ path('app_admin_diliman_delete', {'id': registration.id}) }}" 
                  onsubmit="return confirm('Delete this record permanently?');" class="m-0 p-0">
                <button type="submit" 
                        class="btn btn-icon btn-bg-light btn-active-color-danger btn-sm" 
                        title="Delete">
                    <i class="ki-filled ki-trash fs-3"></i>
                </button>
            </form>
        </div>
    </td>
</tr>
{% endfor %}