                                {% endif %}

                                {# Dynamic Requirements Rows #}
                                {% for setup in documentSetups %}
                                    {% set req = null %}
                                    {% for r in registration.requirements %}
                                        {% if r.Slug|lower == setup.slug|lower and not r.isDeleted %}
                                            {% set req = r %}
                                        {% endif %}
                                    {% endfor %}

                                    <input type="file" id="doc-file-input-{{ setup.slug }}" name="{{ setup.slug }}" accept=".pdf,.jpg,.jpeg,.png" class="hidden" onchange="handleDocFileSelected(this, '{{ setup.slug }}')">

                                    {% if req and req.status == 'W' %}
                                        <div class="flex items-center justify-between gap-2 p-3 rounded-xl border border-amber-200 bg-amber-50/40">
                                            <div class="flex items-center gap-3 min-w-0 flex-1">
                                                <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-amber-100 text-amber-600 flex items-center justify-center font-bold text-xs">
                                                    <i class="ki-filled ki-shield-cross text-base"></i>
                                                </div>
                                                <div class="min-w-0 flex-1">
                                                    <div class="text-xs font-bold text-gray-800 truncate">{{ req.requirement }}</div>
