<script src="{{ asset('js/ph-address-lookup.js') }}"></script>
<script src="{{ asset('js/validation.js') }}"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    let isDirty = false;
    const form = document.getElementById('editForm');
    const backBtn = document.getElementById('btn_discard');

    if(form) {
        form.addEventListener('change', () => { isDirty = true; });
        form.addEventListener('input', () => { isDirty = true; });
        
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            if(confirm('Are you sure you want to save these changes?')) {
                isDirty = false;
                this.submit();
            }
        });
    }

    if(backBtn) {
        backBtn.addEventListener('click', function(e) {
            if(isDirty) {
                if(!confirm('You have unsaved changes. Are you sure you want to discard them and exit?')) {
                    e.preventDefault();
                }
            }
        });
    }

    window.addEventListener('beforeunload', function(e) {
        if(isDirty) { e.preventDefault(); e.returnValue = ''; }
    });

    if(typeof ARIESValidation !== 'undefined') {
        const nameInputs = document.querySelectorAll('input[name="last_name"], input[name="first_name"], input[name="middle_name"]');
        nameInputs.forEach(el => ARIESValidation.setupFormatting(el, 'name'));

        const addressInputs = document.querySelectorAll('input[name="current_address"], input[name="permanent_address"]');
        addressInputs.forEach(el => ARIESValidation.setupFormatting(el, 'address'));

        const textInputs = document.querySelectorAll('input[name="birth_place"], input[name="religion"]');
        textInputs.forEach(el => ARIESValidation.setupFormatting(el, 'text'));

        const arrayInputs = document.querySelectorAll('input[name^="guardians"][type="text"], input[name^="siblings"][type="text"], input[name^="schools"][type="text"]');
        arrayInputs.forEach(el => {
            const isName = el.name.includes('[name]') || el.name.includes('full_name') || el.name.includes('last_name') || el.name.includes('first_name') || el.name.includes('middle_name') || el.name.includes('parentName') || el.name.includes('SiblingName');
            const isAddress = el.name.includes('address') || el.name.includes('street');
            ARIESValidation.setupFormatting(el, isName ? 'name' : (isAddress ? 'address' : 'text'));
        });
    }

    function findOptionMatch(selectEl, searchVal) {
        if (!selectEl || !searchVal) return null;
        const clean = searchVal.toString().trim().toUpperCase();
        if (!clean) return null;

        const opts = Array.from(selectEl.options).filter(o => o.value !== '');
        if (opts.length === 0) return null;

        let m = opts.find(o => o.value.toString().trim().toUpperCase() === clean);
        if (m) return m;

        m = opts.find(o => o.textContent.toString().trim().toUpperCase() === clean);
        if (m) return m;

        const cleanAlpha = clean.replace(/[^A-Z0-9]/g, '');
        if (cleanAlpha) {
            m = opts.find(o => o.textContent.toString().trim().toUpperCase().replace(/[^A-Z0-9]/g, '') === cleanAlpha);
            if (m) return m;
        }

        const cleanCity = clean.replace(/^CITY OF\s+/i, '').replace(/\s+CITY$/i, '').trim();
        if (cleanCity && cleanCity.length >= 3) {
            m = opts.find(o => {
                const optCity = o.textContent.toUpperCase().replace(/^CITY OF\s+/i, '').replace(/\s+CITY$/i, '').trim();
                return optCity === cleanCity;
            });
            if (m) return m;
        }

        if (clean === 'NCR' || clean.includes('NCR')) {
            m = opts.find(o => o.textContent.toUpperCase().includes('NATIONAL CAPITAL REGION') || o.textContent.toUpperCase().includes('NCR'));
            if (m) return m;
        }
        if (clean.includes('CALABARZON') || clean === 'REGION IV-A' || clean === 'REGION 4A' || clean === 'IV-A') {
            m = opts.find(o => o.textContent.toUpperCase().includes('REGION IV-A') || o.textContent.toUpperCase().includes('CALABARZON'));
            if (m) return m;
        }
        if (clean.includes('MIMAROPA') || clean === 'REGION IV-B' || clean === 'REGION 4B' || clean === 'IV-B') {
            m = opts.find(o => o.textContent.toUpperCase().includes('REGION IV-B') || o.textContent.toUpperCase().includes('MIMAROPA'));
            if (m) return m;
        }
        if (clean.includes('CAR') || clean === 'CORDILLERA') {
            m = opts.find(o => o.textContent.toUpperCase().includes('CORDILLERA') || o.textContent.toUpperCase().includes('CAR'));
            if (m) return m;
        }
        if (clean.includes('BARMM') || clean.includes('ARMM')) {
            m = opts.find(o => o.textContent.toUpperCase().includes('MUSLIM MINDANAO') || o.textContent.toUpperCase().includes('ARMM') || o.textContent.toUpperCase().includes('BARMM'));
            if (m) return m;
        }

        if (clean.length >= 3) {
            m = opts.find(o => {
                const text = o.textContent.toString().trim().toUpperCase();
                return text.includes(clean) || clean.includes(text);
            });
            if (m) return m;
        }

        return null;
    }

    async function setupAddressLookup(prefix) {
        const regions = document.getElementById(prefix + '_region');
        const provinces = document.getElementById(prefix + '_province');
        const cities = document.getElementById(prefix + '_city');
        const barangays = document.getElementById(prefix + '_barangay');

        if(!regions) return;

        const selR = regions.getAttribute('data-selected') || '';
        const selP = provinces ? (provinces.getAttribute('data-selected') || '') : '';
        const selC = cities ? (cities.getAttribute('data-selected') || '') : '';
        const selB = barangays ? (barangays.getAttribute('data-selected') || '') : '';

        const loadRegions = async () => {
            try {
                const res = await fetch('/api/address/regions');
                const data = await res.json();
                regions.innerHTML = '<option value="">Select Region</option>';
                data.forEach(r => {
                    const opt = document.createElement('option');
                    opt.value = r.code;
                    opt.textContent = r.name;
                    regions.appendChild(opt);
                });
            } catch (e) {
                console.error('Failed to load regions', e);
            }
        };
        
        const loadProvinces = async (rCode) => {
            if(!provinces) return;
            provinces.innerHTML = '<option value="">Select Province</option>';
            provinces.disabled = true;
            if(!rCode) return;
            try {
                const res = await fetch(`/api/address/provinces/${encodeURIComponent(rCode)}`);
                const data = await res.json();
                data.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.code;
                    opt.textContent = p.name;
                    provinces.appendChild(opt);
                });
                provinces.disabled = false;
            } catch (e) {
                console.error('Failed to load provinces', e);
            }
        };

        const loadCities = async (pCode) => {
            if(!cities) return;
            cities.innerHTML = '<option value="">Select City</option>';
            cities.disabled = true;
            if(!pCode) return;
            try {
                const res = await fetch(`/api/address/cities/${encodeURIComponent(pCode)}`);
                const data = await res.json();
                data.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.code;
                    opt.textContent = c.name;
                    cities.appendChild(opt);
                });
                cities.disabled = false;
            } catch (e) {
                console.error('Failed to load cities', e);
            }
        };

        const loadBarangays = async (cCode) => {
            if(!barangays) return;
            barangays.innerHTML = '<option value="">Select Barangay</option>';
            barangays.disabled = true;
            if(!cCode) return;
            try {
                const res = await fetch(`/api/address/barangays/${encodeURIComponent(cCode)}`);
                const data = await res.json();
                data.forEach(b => {
                    const opt = document.createElement('option');
                    opt.value = b.name;
                    opt.textContent = b.name;
                    if (b.zip) opt.setAttribute('data-zip', b.zip);
                    barangays.appendChild(opt);
                });
                barangays.disabled = false;
            } catch (e) {
                console.error('Failed to load barangays', e);
            }
        };

        regions.addEventListener('change', async function() {
            await loadProvinces(this.value);
            if(cities) { cities.innerHTML = '<option value="">Select City</option>'; cities.disabled = true; }
            if(barangays) { barangays.innerHTML = '<option value="">Select Barangay</option>'; barangays.disabled = true; }
        });

        if(provinces) {
            provinces.addEventListener('change', async function() {
                await loadCities(this.value);
                if(barangays) { barangays.innerHTML = '<option value="">Select Barangay</option>'; barangays.disabled = true; }
            });
        }

        if(cities && barangays) {
            cities.addEventListener('change', async function() {
                await loadBarangays(this.value);
            });
        }

        if(barangays) {
            barangays.addEventListener('change', function() {
                const selectedOpt = this.options[this.selectedIndex];
                const zip = selectedOpt ? selectedOpt.getAttribute('data-zip') : null;
                const zipInput = document.getElementById(prefix + '_zip');
                if (zip && zipInput && !zipInput.value) {
                    zipInput.value = zip;
                }
            });
        }

        // Initial Load Pre-selection
        await loadRegions();
        let activeRCode = null;
        if(selR) {
            const matchedR = findOptionMatch(regions, selR);
            if(matchedR) {
                regions.value = matchedR.value;
                activeRCode = matchedR.value;
            } else {
                const fallbackOpt = new Option(selR, selR, true, true);
                regions.add(fallbackOpt);
                activeRCode = selR;
            }
        }

        if(activeRCode && provinces) {
            await loadProvinces(activeRCode);
            let activePCode = null;
            if(selP) {
                const matchedP = findOptionMatch(provinces, selP);
                if(matchedP) {
                    provinces.value = matchedP.value;
                    activePCode = matchedP.value;
                } else {
                    const fallbackOpt = new Option(selP, selP, true, true);
                    provinces.add(fallbackOpt);
                    activePCode = selP;
                }
            } else if (provinces.options.length === 2) {
                provinces.selectedIndex = 1;
                activePCode = provinces.value;
            }

            if(activePCode && cities) {
                await loadCities(activePCode);
                let activeCCode = null;
                if(selC) {
                    const matchedC = findOptionMatch(cities, selC);
                    if(matchedC) {
                        cities.value = matchedC.value;
                        activeCCode = matchedC.value;
                    } else {
                        const fallbackOpt = new Option(selC, selC, true, true);
                        cities.add(fallbackOpt);
                        activeCCode = selC;
                    }
                }

                if(activeCCode && barangays) {
                    await loadBarangays(activeCCode);
                    if(selB) {
                        const matchedB = findOptionMatch(barangays, selB);
                        if(matchedB) {
                            barangays.value = matchedB.value;
                        } else {
                            const fallbackOpt = new Option(selB, selB, true, true);
                            barangays.add(fallbackOpt);
                        }
                    }
                }
            }
        }
    }

    setupAddressLookup('addr');
    setupAddressLookup('perm');
    setupAddressLookup('guardian_addr');
    
    document.querySelectorAll('[id^="school_"][id$="_intl"]').forEach((cb) => {
        const index = cb.id.split('_')[1];
        setupAddressLookup(`school_${index}`);
    });

    window.toggleGuardianAddress = function() {
        const cb = document.getElementById('guardian_same_as_applicant');
        const block = document.getElementById('guardian_address_block');
        const preview = document.getElementById('guardian_same_preview');
        if (cb && block) {
            block.style.display = cb.checked ? 'none' : '';
        }
        if (cb && preview) {
            preview.style.display = cb.checked ? '' : 'none';
        }
    };

    document.querySelectorAll('[id^="parent_same_"]').forEach((cb) => {
        const idx = cb.id.replace('parent_same_', '');
        setupAddressLookup(`parent_${idx}`);
        setupAddressLookup(`parent_ofw_${idx}`);
    });

    window.toggleParentEditAddress = function(idx) {
        const cb = document.getElementById(`parent_same_${idx}`);
        const block = document.getElementById(`parent_addr_block_${idx}`);
        const preview = document.getElementById(`parent_same_preview_${idx}`);
        if (cb && block) {
            block.style.display = cb.checked ? 'none' : '';
        }
        if (cb && preview) {
            preview.style.display = cb.checked ? '' : 'none';
        }
    };

    window.toggleAdminParentStatus = function(idx, clickedType) {
        const deceasedEl = document.getElementById(`parent_deceased_${idx}`);
        const ofwEl = document.getElementById(`parent_ofw_${idx}`);
        if (!deceasedEl || !ofwEl) return;

        if (clickedType === 'deceased' && deceasedEl.checked) {
            ofwEl.checked = false;
        } else if (clickedType === 'ofw' && ofwEl.checked) {
            deceasedEl.checked = false;
        }

        const isDeceased = deceasedEl.checked;
        const isOfw = ofwEl.checked;

        const addrSection = document.getElementById(`parent_addr_section_${idx}`);
        const stdAddrBlock = document.getElementById(`parent_standard_addr_${idx}`);
        const ofwAddrBlock = document.getElementById(`parent_ofw_addr_${idx}`);
        const sameCheck = document.getElementById(`parent_same_${idx}`);

        if (addrSection) {
            addrSection.style.display = isDeceased ? 'none' : '';
        }

        if (isOfw) {
            if (stdAddrBlock) stdAddrBlock.style.display = 'none';
            if (ofwAddrBlock) ofwAddrBlock.style.display = '';
            if (sameCheck) {
                sameCheck.checked = false;
            }
        } else {
            if (ofwAddrBlock) ofwAddrBlock.style.display = 'none';
            if (stdAddrBlock && !isDeceased) stdAddrBlock.style.display = '';
        }
    };

    window.toggleAdminOfwPermSame = function(idx) {
        const cb = document.getElementById(`parent_ofw_perm_same_${idx}`);
        const diffBlock = document.getElementById(`parent_ofw_perm_diff_${idx}`);
        if (cb && diffBlock) {
            diffBlock.style.display = cb.checked ? 'none' : '';
        }
    };

    window.toggleAdminOfwPermInPh = function(idx, val) {
        const phBlock = document.getElementById(`parent_ofw_perm_ph_${idx}`);
        const intlBlock = document.getElementById(`parent_ofw_perm_intl_${idx}`);
        if (val === 'yes') {
            if (phBlock) phBlock.style.display = '';
            if (intlBlock) intlBlock.style.display = 'none';
        } else {
            if (phBlock) phBlock.style.display = 'none';
            if (intlBlock) intlBlock.style.display = '';
        }
    };

    window.toggleParentDeceased = function(idx, isChecked) {
        window.toggleAdminParentStatus(idx, 'deceased');
    };

    window.toggleAdminSchoolLocation = function(index) {
        const isIntl = document.getElementById(`school_${index}_intl`).checked;
        const localGroup = document.getElementById(`school_${index}_local_group`);
        const intlGroup = document.getElementById(`school_${index}_intl_group`);

        if(isIntl) {
            localGroup.style.display = 'none';
            intlGroup.style.display = '';
        } else {
            localGroup.style.display = '';
            intlGroup.style.display = 'none';
        }
    };

    window.previewImage = function(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                const img = document.getElementById('applicantAvatarImg');
                if (img) img.src = e.target.result;
                const thumb = document.getElementById('submittedFiles2x2Thumb');
                if (thumb) thumb.src = e.target.result;
            };
            reader.readAsDataURL(input.files[0]);
        }
    };

    // --- DYNAMIC FORM LOGIC ---

    const gradeSelect = document.querySelector('select[name="grade_level"]');
    const strandSelect = document.querySelector('select[name="track_strand"]');
    const shsSection = document.getElementById('shsExamSection');
    const k10Section = document.getElementById('k10PaymentSection');

    window.updateGradeDependents = function() {
        if (!gradeSelect) return;
        
        const level = gradeSelect.value.toLowerCase();
        const isSHS = level.includes('11') || level.includes('12') || level.includes('shs');
        
        // 1. Toggle Strand Dropdown
        if (strandSelect) {
            if (isSHS) {
                strandSelect.style.display = ''; 
                strandSelect.disabled = false;
            } else {
                strandSelect.style.display = 'none';
                strandSelect.disabled = true;
                strandSelect.value = ''; 
            }
        }

        // 2. Toggle Examination vs Payment Sections
        if (shsSection && k10Section) {
            shsSection.style.display = isSHS ? '' : 'none';
            k10Section.style.display = isSHS ? 'none' : '';
            const k10Payment = document.getElementById('paymentPaidCheck');
            const shsPayment = document.getElementById('shsPaymentPaidCheck');
            if (k10Payment) k10Payment.disabled = isSHS;
            if (shsPayment) shsPayment.disabled = !isSHS;
        }
    };

    if (gradeSelect) {
        gradeSelect.addEventListener('change', window.updateGradeDependents);
        gradeSelect.addEventListener('input', window.updateGradeDependents);
        window.updateGradeDependents();
    }

    // Exam Checkbox Toggle
    const examCheck = document.getElementById('examCheck');
    const scoreBox = document.getElementById('scoreBox');
    const pendingBox = document.getElementById('pendingBox');
    
    window.updateExamUI = function() {
        if (!examCheck) return;
        if (scoreBox) scoreBox.style.display = examCheck.checked ? '' : 'none';
        if (pendingBox) pendingBox.style.display = examCheck.checked ? 'none' : '';
    };

    if (examCheck) {
        examCheck.addEventListener('change', window.updateExamUI);
        window.updateExamUI();
    }

    // SHS Payment Checkbox Toggle
    const shsPaymentPaidCheck = document.getElementById('shsPaymentPaidCheck');
    const shsPaymentPaidBox = document.getElementById('shsPaymentPaidBox');
    const shsPaymentPendingBox = document.getElementById('shsPaymentPendingBox');

    window.updateShsPaymentUI = function() {
        if (!shsPaymentPaidCheck) return;
        if (shsPaymentPaidBox) shsPaymentPaidBox.style.display = shsPaymentPaidCheck.checked ? '' : 'none';
        if (shsPaymentPendingBox) shsPaymentPendingBox.style.display = shsPaymentPaidCheck.checked ? 'none' : '';
    };

    if (shsPaymentPaidCheck) {
        shsPaymentPaidCheck.addEventListener('change', window.updateShsPaymentUI);
        window.updateShsPaymentUI();
    }

    // Payment Checkbox Toggle
    const paymentPaidCheck = document.getElementById('paymentPaidCheck');
    const paymentPendingBox = document.getElementById('paymentPendingBox');
    const paymentPaidBox = document.getElementById('paymentPaidBox');
    
    window.updatePaymentUI = function() {
        if (!paymentPaidCheck) return;
        if (paymentPendingBox) paymentPendingBox.style.display = paymentPaidCheck.checked ? 'none' : '';
        if (paymentPaidBox) paymentPaidBox.style.display = paymentPaidCheck.checked ? '' : 'none';
    };

    if (paymentPaidCheck) {
        paymentPaidCheck.addEventListener('change', window.updatePaymentUI);
        window.updatePaymentUI();
    }

    // --- INTERNATIONAL SCHOOL LOGIC ---
    window.toggleAdminSchoolLocation = function(index) {
        const isIntl = document.getElementById(`school_${index}_intl`).checked;
        const localGroup = document.getElementById(`school_${index}_local_group`);
        const intlGroup = document.getElementById(`school_${index}_intl_group`);

        if(isIntl) {
            localGroup.style.display = 'none';
            intlGroup.style.display = '';
        } else {
            localGroup.style.display = '';
            intlGroup.style.display = 'none';
        }
    };

    window.syncAdminSchoolType = function(index) {
        const typeSelect = document.querySelector(`select[name="schools[${index}][type]"]`);
        const cb = document.getElementById(`school_${index}_intl`);
        if (typeSelect && cb) {
            cb.checked = (typeSelect.value === 'International');
            window.toggleAdminSchoolLocation(index);
        }
    };

    let adminSiblingCounter = document.querySelectorAll('#adminSiblingsContainer .admin-sibling-row').length;
    window.addAdminSibling = function() {
        const container = document.getElementById('adminSiblingsContainer');
        const emptyMsg = document.getElementById('adminNoSiblingsMsg');
        if (!container) return;

        const idx = adminSiblingCounter++;
        const rowHtml = `
            <div class="admin-sibling-row p-3 rounded-xl bg-gray-50/60 border border-gray-200/60">
                <div class="flex justify-end mb-2">
                    <button type="button" onclick="window.removeAdminSibling(this)" class="inline-flex items-center gap-1 px-2 py-1 rounded-md text-[10px] font-bold bg-red-50 text-red-700 hover:bg-red-100 border border-red-200 transition-colors cursor-pointer" title="Delete Sibling">
                        <i class="ki-filled ki-trash text-xs"></i> Delete
                    </button>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                    <div>
                        <label class="text-[10px] font-bold text-gray-500 uppercase block mb-1">Sibling Name <span class="text-red-500">*</span></label>
                        <input type="text" name="siblings[${idx}][name]" class="w-full border border-gray-300 rounded-lg text-xs shadow-2xs px-3 py-2 bg-white font-medium uppercase" placeholder="Sibling Name" required oninput="this.value = this.value.toUpperCase();">
                    </div>
                    <div>
                        <label class="text-[10px] font-bold text-gray-500 uppercase block mb-1">FEU Campus / School</label>
                        <input type="text" name="siblings[${idx}][school]" class="w-full border border-gray-300 rounded-lg text-xs shadow-2xs px-3 py-2 bg-white font-medium uppercase" placeholder="e.g. FEU Diliman, FEU High School" oninput="this.value = this.value.toUpperCase();">
                    </div>
                    <div>
                        <label class="text-[10px] font-bold text-gray-500 uppercase block mb-1">FEU Student No.</label>
                        <input type="text" name="siblings[${idx}][feu_id]" class="w-full border border-gray-300 rounded-lg text-xs shadow-2xs px-3 py-2 bg-white font-medium" placeholder="20xxxxxx">
                    </div>
                </div>
            </div>`;
        container.insertAdjacentHTML('beforeend', rowHtml);
        if (emptyMsg) emptyMsg.classList.add('hidden');
    };

    window.removeAdminSibling = function(btn) {
        if (!confirm('Are you sure you want to delete this sibling? Changes will only apply once you click Save Changes.')) {
            return;
        }
        const row = btn.closest('.admin-sibling-row');
        if (row) row.remove();
        const container = document.getElementById('adminSiblingsContainer');
        const emptyMsg = document.getElementById('adminNoSiblingsMsg');
        if (container && emptyMsg && container.querySelectorAll('.admin-sibling-row').length === 0) {
            emptyMsg.classList.remove('hidden');
        }
    };

    window.closeAllDocActionMenus = function() {
        document.querySelectorAll('.doc-action-menu').forEach(function(menu) {
            menu.classList.add('hidden');
        });
        document.querySelectorAll('.doc-action-dropdown > button').forEach(function(trigger) {
            trigger.setAttribute('aria-expanded', 'false');
        });
    };

    window.toggleDocActionMenu = function(btn) {
        const wrapper = btn.closest('.doc-action-dropdown');
        if (!wrapper) return;
        const menu = wrapper.querySelector('.doc-action-menu');
        if (!menu) return;
        const willOpen = menu.classList.contains('hidden');
        window.closeAllDocActionMenus();
        if (willOpen) {
            menu.classList.remove('hidden');
            btn.setAttribute('aria-expanded', 'true');
        }
    };

    window.handleDocFileSelected = function(input, slug) {
        const badge = document.getElementById('doc-pending-' + slug);
        if (!badge) return;
        if (input.files && input.files.length > 0) {
            badge.textContent = 'Queued: ' + input.files[0].name + ' (Save Changes to upload)';
            badge.classList.remove('hidden');
        } else {
            badge.textContent = '';
            badge.classList.add('hidden');
        }
    };

    document.addEventListener('click', function(e) {
        if (!e.target.closest('.doc-action-dropdown')) {
            window.closeAllDocActionMenus();
        }
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            window.closeAllDocActionMenus();
        }
    });
});
</script>
{% if isFinanceOnly %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const editForm = document.getElementById('editForm');
    if (editForm) {
        const allowedNames = ['payment_paid', '_token'];
        const elements = editForm.querySelectorAll('input, select, textarea, button');
        elements.forEach(function(el) {
            if (el.type === 'submit' || el.id === 'btn_discard' || allowedNames.includes(el.name)) {
                return;
            }
            if (el.tagName === 'BUTTON' && el.type !== 'submit') {
                el.style.display = 'none';
                return;
            }
            el.setAttribute('disabled', 'disabled');
            el.classList.add('bg-gray-100', 'cursor-not-allowed', 'opacity-75');
            el.readOnly = true;
        });

        const uploadElements = editForm.querySelectorAll('input[type="file"], label[for="applicantAvatarInput"], label[for="applicantAvatarInputSidebar"], .upload-btn, .delete-doc-btn');
        uploadElements.forEach(function(el) {
            el.style.display = 'none';
        });
    }
});
</script>
{% endif %}
