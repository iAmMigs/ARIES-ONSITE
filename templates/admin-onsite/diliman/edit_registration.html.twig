                                                        <i class="ki-filled ki-verify text-xs flex-shrink-0"></i>
                                                        <span>Waived by Admin</span>
                                                    </div>
                                                    <div id="doc-pending-{{ setup.slug }}" class="hidden text-[10px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded px-1.5 py-0.5 mt-1 truncate"></div>
                                                </div>
                                            </div>
                                            <div class="relative flex-shrink-0 doc-action-dropdown">
                                                <button type="button" onclick="toggleDocActionMenu(this)" class="btn btn-xs btn-light-secondary text-gray-700 hover:text-feu-green-700 hover:bg-feu-green-50 font-bold text-[11px] px-2.5 py-1.5 rounded-lg border border-gray-200 shadow-2xs transition-all flex items-center gap-1 whitespace-nowrap" aria-expanded="false">
                                                    <i class="ki-filled ki-dots-vertical text-xs"></i>
                                                    <span>Actions</span>
                                                    <i class="ki-filled ki-down text-[10px] opacity-70"></i>
                                                </button>
                                                <div class="doc-action-menu hidden absolute right-0 mt-1.5 w-44 bg-white rounded-xl shadow-lg border border-gray-200/90 py-1.5 z-30">
                                                    <button type="button" onclick="closeAllDocActionMenus(); document.getElementById('doc-file-input-{{ setup.slug }}').click();" class="w-full text-left px-3 py-2 text-xs font-semibold text-gray-700 hover:bg-feu-green-50 hover:text-feu-green-700 flex items-center gap-2 transition-colors">
                                                        <i class="ki-filled ki-file-up text-sm text-emerald-600"></i>
                                                        <span>Upload</span>
                                                    </button>
                                                    <button type="button" onclick="closeAllDocActionMenus(); if(confirm('Remove waiver and restore this requirement?')) document.getElementById('unwaive-doc-diliman-{{ setup.slug }}').submit();" class="w-full text-left px-3 py-2 text-xs font-semibold text-gray-700 hover:bg-gray-50 hover:text-red-600 flex items-center gap-2 transition-colors">
                                                        <i class="ki-filled ki-cross text-sm text-gray-500"></i>
                                                        <span>Unwaive</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    {% elseif req and req.status == 'S' %}
                                        <div class="flex items-center justify-between gap-2 p-3 rounded-xl border border-gray-100 hover:bg-gray-50 hover:border-feu-green-200 transition-all group">
                                            {% if req.storedFileName %}
                                                <a href="{{ asset(req.storedFileName) }}" target="_blank" class="flex items-center gap-3 min-w-0 flex-1">
                                                    <div class="flex-shrink-0">
                                                        <img src="{{ asset('metronic/media/file-types/pdf.svg') }}" class="w-8 h-8" alt="PDF">
                                                    </div>
                                                    <div class="min-w-0 flex-1">
                                                        <div class="text-xs font-bold text-gray-800 truncate">{{ req.requirement }}</div>
                                                        <div class="text-[11px] text-gray-400 whitespace-nowrap">
                                                            Submitted {% if req.dateSubmitted %}• {{ req.dateSubmitted|date('M d, Y') }}{% endif %}
                                                        </div>
                                                        <div id="doc-pending-{{ setup.slug }}" class="hidden text-[10px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded px-1.5 py-0.5 mt-1 truncate"></div>
                                                    </div>
                                                </a>
                                            {% else %}
                                                <div class="flex items-center gap-3 min-w-0 flex-1">
                                                    <div class="flex-shrink-0">
                                                        <img src="{{ asset('metronic/media/file-types/pdf.svg') }}" class="w-8 h-8" alt="PDF">
                                                    </div>
                                                    <div class="min-w-0 flex-1">
                                                        <div class="text-xs font-bold text-gray-800 truncate">{{ req.requirement }}</div>
                                                        <div class="text-[11px] text-gray-400 whitespace-nowrap">
                                                            Submitted {% if req.dateSubmitted %}• {{ req.dateSubmitted|date('M d, Y') }}{% endif %}
                                                        </div>
                                                        <div id="doc-pending-{{ setup.slug }}" class="hidden text-[10px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded px-1.5 py-0.5 mt-1 truncate"></div>
                                                    </div>
                                                </div>
                                            {% endif %}
                                            <div class="relative flex-shrink-0 doc-action-dropdown">
                                                <button type="button" onclick="toggleDocActionMenu(this)" class="btn btn-xs btn-light-secondary text-gray-700 hover:text-feu-green-700 hover:bg-feu-green-50 font-bold text-[11px] px-2.5 py-1.5 rounded-lg border border-gray-200 shadow-2xs transition-all flex items-center gap-1 whitespace-nowrap" aria-expanded="false">
                                                    <i class="ki-filled ki-dots-vertical text-xs"></i>
                                                    <span>Actions</span>
                                                    <i class="ki-filled ki-down text-[10px] opacity-70"></i>
                                                </button>
                                                <div class="doc-action-menu hidden absolute right-0 mt-1.5 w-44 bg-white rounded-xl shadow-lg border border-gray-200/90 py-1.5 z-30">
                                                    <button type="button" onclick="closeAllDocActionMenus(); document.getElementById('doc-file-input-{{ setup.slug }}').click();" class="w-full text-left px-3 py-2 text-xs font-semibold text-gray-700 hover:bg-feu-green-50 hover:text-feu-green-700 flex items-center gap-2 transition-colors">
                                                        <i class="ki-filled ki-file-up text-sm text-feu-green-600"></i>
                                                        <span>Replace</span>
                                                    </button>
                                                    <button type="button" onclick="closeAllDocActionMenus(); if(confirm('WARNING: Are you sure you want to soft-delete this document?')) document.getElementById('delete-doc-diliman-{{ setup.slug }}').submit();" class="w-full text-left px-3 py-2 text-xs font-semibold text-red-600 hover:bg-red-50 flex items-center gap-2 transition-colors">
                                                        <i class="ki-filled ki-trash text-sm text-red-500"></i>
                                                        <span>Delete</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    {% else %}
                                        <div class="flex items-center justify-between gap-2 p-3 rounded-xl border border-red-100 bg-red-50/30">
                                            <div class="flex items-center gap-3 min-w-0 flex-1">
                                                <div class="flex-shrink-0">
                                                    <img src="{{ asset('metronic/media/file-types/pdf.svg') }}" class="w-8 h-8 opacity-20 grayscale" alt="PDF">
                                                </div>
                                                <div class="min-w-0 flex-1">
                                                    <div class="text-xs font-bold text-red-800 truncate">{{ setup.documentName }}</div>
                                                    <div class="text-[10px] text-red-500 font-bold uppercase whitespace-nowrap">Not Submitted</div>
                                                    <div id="doc-pending-{{ setup.slug }}" class="hidden text-[10px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded px-1.5 py-0.5 mt-1 truncate"></div>
                                                </div>
                                            </div>
                                            <div class="relative flex-shrink-0 doc-action-dropdown">
                                                <button type="button" onclick="toggleDocActionMenu(this)" class="btn btn-xs btn-light-secondary text-gray-700 hover:text-feu-green-700 hover:bg-feu-green-50 font-bold text-[11px] px-2.5 py-1.5 rounded-lg border border-gray-200 shadow-2xs transition-all flex items-center gap-1 whitespace-nowrap" aria-expanded="false">
                                                    <i class="ki-filled ki-dots-vertical text-xs"></i>
                                                    <span>Actions</span>
                                                    <i class="ki-filled ki-down text-[10px] opacity-70"></i>
                                                </button>
                                                <div class="doc-action-menu hidden absolute right-0 mt-1.5 w-44 bg-white rounded-xl shadow-lg border border-gray-200/90 py-1.5 z-30">
                                                    <button type="button" onclick="closeAllDocActionMenus(); document.getElementById('doc-file-input-{{ setup.slug }}').click();" class="w-full text-left px-3 py-2 text-xs font-semibold text-gray-700 hover:bg-feu-green-50 hover:text-feu-green-700 flex items-center gap-2 transition-colors">
                                                        <i class="ki-filled ki-file-up text-sm text-emerald-600"></i>
                                                        <span>Upload</span>
                                                    </button>
                                                    <button type="button" onclick="closeAllDocActionMenus(); if(confirm('Are you sure you want to officially waive this requirement for this applicant?')) document.getElementById('waive-doc-diliman-{{ setup.slug }}').submit();" class="w-full text-left px-3 py-2 text-xs font-semibold text-amber-700 hover:bg-amber-50 flex items-center gap-2 transition-colors">
                                                        <i class="ki-filled ki-shield-cross text-sm text-amber-600"></i>
                                                        <span>Waive</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endfor %}

                                {% if documentSetups|length == 0 %}
                                    <div class="text-center py-6 text-gray-400 text-xs italic">No document requirements for this student type.</div>
                                {% endif %}
                            </div>
                        </div>

                        {# General Information Card #}
                        <div class="bg-white rounded-2xl p-6 shadow-xs border border-gray-200/80">
                            <div class="flex items-center gap-3 mb-5 pb-4 border-b border-gray-100">
                                <div class="w-9 h-9 rounded-xl bg-feu-green-50 text-feu-green-700 flex items-center justify-center text-base border border-feu-green-100 flex-shrink-0">
                                    <i class="ki-filled ki-information-2 text-lg"></i>
                                </div>
                                <h3 class="text-lg font-bold text-gray-900 tracking-tight">General Information</h3>
                            </div>
                            <div class="space-y-3">
                                <div class="flex justify-between items-center text-xs">
                                    <span class="text-gray-400 font-semibold uppercase tracking-wider text-[10px]">Applied On</span>
                                    <span class="font-bold text-gray-800">{{ registration.createdAt|date('M d, Y') }}</span>
                                </div>
                                <div class="flex justify-between items-center text-xs">
                                    <span class="text-gray-400 font-semibold uppercase tracking-wider text-[10px]">School Year</span>
                                    <span class="px-2 py-0.5 rounded font-bold bg-gray-100 text-gray-800 border border-gray-200/60 font-mono">{{ registration.schoolYearOfEntry }}</span>
                                </div>
                                <div class="flex justify-between items-start text-xs pt-1 border-t border-gray-100">
                                    <span class="text-gray-400 font-semibold uppercase tracking-wider text-[10px] pt-1">Source</span>
                                    <div class="text-right">
                                        {% if registration.marketingSource %}
                                            <div class="flex flex-wrap justify-end gap-1">
                                                {% for src in registration.marketingSource|split(', ') %}
                                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
                                                        {{ src }}
                                                    </span>
                                                {% endfor %}
                                            </div>
                                        {% else %}
                                            <span class="font-medium text-gray-400">N/A</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>

                        {# Emergency Contact Edit Block #}
                        {% set emergencyContact = null %}
                        {% set emergencyIndex = 'new_999' %}
                        
                        {% for guardian in registration.guardians %}
                            {% set gType = guardian.guardianType|default(guardian.relationship|upper in ['FATHER', 'MOTHER'] ? guardian.relationship|upper : 'GUARDIAN') %}
                            {% if gType == 'GUARDIAN' %}
                                {% set emergencyContact = guardian %}
                                {% set emergencyIndex = loop.index0 %}
                            {% endif %}
                        {% endfor %}

                        {% set emergencyResolvedAddr = emergencyContact ? [emergencyContact.currentAddress, emergencyContact.currentBarangay, emergencyContact.currentCity, emergencyContact.currentProvince, emergencyContact.currentRegion, emergencyContact.currentZip]|filter(v => v is not empty and v|trim != '')|join(', ') : '' %}
                        {% if (not emergencyResolvedAddr or (emergencyContact and emergencyContact.sameAsApplicant)) and applicantFullAddr %}{% set emergencyResolvedAddr = applicantFullAddr %}{% endif %}

                        <div class="bg-white rounded-2xl p-6 shadow-xs border border-gray-200/80">
                            <div class="flex items-center gap-3 mb-5 pb-4 border-b border-gray-100">
                                <div class="w-9 h-9 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center text-base border border-orange-100 flex-shrink-0">
                                    <i class="ki-filled ki-phone text-lg"></i>
                                </div>
                                <h3 class="text-lg font-bold text-gray-900 tracking-tight">Emergency Contact</h3>
                            </div>
                            <div class="space-y-3">
                                <input type="hidden" name="guardians[{{ emergencyIndex }}][guardian_type]" value="GUARDIAN">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                    <div>
                                        <label class="text-xs font-bold text-gray-600 uppercase tracking-wider block mb-1">Full Name</label>
                                        <input type="text" name="guardians[{{ emergencyIndex }}][full_name]" value="{{ emergencyContact ? emergencyContact.parentName|default('')|trim(', ') : '' }}" class="w-full border border-gray-300 rounded-lg text-xs font-medium shadow-2xs px-3 py-2 bg-white" placeholder="Full Name">
                                    </div>
                                    <div>
                                        <label class="text-xs font-bold text-gray-600 uppercase tracking-wider block mb-1">Relationship</label>
                                        <input type="text" name="guardians[{{ emergencyIndex }}][relationship]" value="{{ emergencyContact ? emergencyContact.relationship : 'GUARDIAN' }}" class="w-full border border-gray-300 rounded-lg text-xs font-medium shadow-2xs px-3 py-2 bg-white">
                                    </div>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                    <div>
                                        <label class="text-xs font-bold text-gray-600 uppercase tracking-wider block mb-1">Occupation</label>
                                        <input type="text" name="guardians[{{ emergencyIndex }}][occupation]" value="{{ emergencyContact ? emergencyContact.occupation : '' }}" class="w-full border border-gray-300 rounded-lg text-xs font-medium shadow-2xs px-3 py-2 bg-white" placeholder="Occupation">
                                    </div>
                                    <div>
                                        <label class="text-xs font-bold text-gray-600 uppercase tracking-wider block mb-1">Email Address</label>
                                        <input type="email" name="guardians[{{ emergencyIndex }}][email]" value="{{ emergencyContact ? emergencyContact.email : '' }}" class="w-full border border-gray-300 rounded-lg text-xs font-medium shadow-2xs px-3 py-2 bg-white" placeholder="Email Address">
                                    </div>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                    <div>
                                        <label class="text-xs font-bold text-gray-600 uppercase tracking-wider block mb-1">Contact No.</label>
                                        <div>
                                            {% include 'enrollment-onsite/_phone_input.html.twig' with {
                                                prefix: 'emergency_contact_' ~ emergencyIndex,
                                                dial_name: 'guardians[' ~ emergencyIndex ~ '][country_dial_code]',
                                                input_name: 'guardians[' ~ emergencyIndex ~ '][contact]',
                                                input_id: 'emergency_contact_' ~ emergencyIndex,
                                                input_class: 'border border-gray-300 rounded-r-lg text-xs font-medium shadow-2xs px-3 py-2',
                                                value: emergencyContact ? emergencyContact.contactNo : '',
                                                placeholder: '9xxxxxxxxx',
                                                countries: countries
                                            } %}
                                        </div>
                                    </div>
                                    <div>
                                        <label class="text-xs font-bold text-gray-600 uppercase tracking-wider block mb-1">Nationality</label>
                                        <select name="guardians[{{ emergencyIndex }}][nationality]" class="w-full border border-gray-300 rounded-lg text-xs font-medium shadow-2xs px-3 py-2 bg-white">
                                            <option value="">Select Nationality</option>
                                            {% for nat in nationalities %}
                                                <option value="{{ nat.citizenshipName }}" {{ (emergencyContact and emergencyContact.nationality|upper == nat.citizenshipName|upper) ? 'selected' : '' }}>{{ nat.citizenshipName }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>

                                {# Guardian Address with Same as Applicant #}
                                <div class="mt-4 pt-3.5 border-t border-gray-200/80">
                                    <div class="flex items-center mb-2">
                                        <input class="rounded border-gray-300 text-feu-green-600 focus:ring-feu-green-500 w-4 h-4 mr-2" type="checkbox" id="guardian_same_as_applicant" name="guardians[{{ emergencyIndex }}][same_as_applicant]" value="1" onchange="toggleGuardianAddress()" {{ (emergencyContact and emergencyContact.sameAsApplicant) ? 'checked' : '' }}>
                                        <label class="text-xs font-bold text-gray-700 cursor-pointer" for="guardian_same_as_applicant">Same address as Applicant</label>
                                    </div>
                                    
                                    {# Resolved address preview box #}
                                    <div id="guardian_same_preview" style="{{ not (emergencyContact and emergencyContact.sameAsApplicant) ? 'display:none;' : '' }}" class="mt-2.5 p-3 rounded-lg bg-gray-50/90 border border-gray-200/70 text-xs text-gray-700 flex items-start gap-2.5">
                                        <i class="ki-filled ki-geolocation text-feu-green-600 mt-0.5 text-sm flex-shrink-0"></i>
                                        <div>
                                            <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider block">Resolved Complete Address</span>
                                            <span class="font-bold text-gray-800">{{ emergencyResolvedAddr|default(applicantFullAddr)|default('No complete address recorded') }}</span>
                                        </div>
                                    </div>

                                    <div id="guardian_address_block" style="{{ (emergencyContact and emergencyContact.sameAsApplicant) ? 'display:none;' : '' }}">
                                        <div class="grid grid-cols-2 gap-2 mb-2 mt-2">
                                            <div>
                                                <label class="text-[10px] font-bold text-gray-500 uppercase block mb-1">Region</label>
                                                <select id="guardian_addr_region" name="guardians[{{ emergencyIndex }}][addr_region]" class="w-full border border-gray-300 rounded-lg text-[10px] shadow-2xs px-2 py-1.5 bg-white" data-selected="{{ emergencyContact ? emergencyContact.currentRegion : '' }}"><option value="">Region</option></select>
                                            </div>
                                            <div>
                                                <label class="text-[10px] font-bold text-gray-500 uppercase block mb-1">Province</label>
                                                <select id="guardian_addr_province" name="guardians[{{ emergencyIndex }}][addr_province]" class="w-full border border-gray-300 rounded-lg text-[10px] shadow-2xs px-2 py-1.5 bg-white" data-selected="{{ emergencyContact ? emergencyContact.currentProvince : '' }}"><option value="">Province</option></select>
                                            </div>
                                            <div>
                                                <label class="text-[10px] font-bold text-gray-500 uppercase block mb-1">City/Municipality</label>
                                                <select id="guardian_addr_city" name="guardians[{{ emergencyIndex }}][addr_city]" class="w-full border border-gray-300 rounded-lg text-[10px] shadow-2xs px-2 py-1.5 bg-white" data-selected="{{ emergencyContact ? emergencyContact.currentCity : '' }}"><option value="">City</option></select>
                                            </div>
                                            <div>
                                                <label class="text-[10px] font-bold text-gray-500 uppercase block mb-1">Barangay</label>
                                                <select id="guardian_addr_barangay" name="guardians[{{ emergencyIndex }}][addr_barangay]" class="w-full border border-gray-300 rounded-lg text-[10px] shadow-2xs px-2 py-1.5 bg-white" data-selected="{{ emergencyContact ? emergencyContact.currentBarangay : '' }}"><option value="">Barangay</option></select>
                                            </div>
                                        </div>
                                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                                            <div class="sm:col-span-2">
                                                <label class="text-[10px] font-bold text-gray-500 uppercase block mb-1">House No. / Street</label>
                                                <input type="text" name="guardians[{{ emergencyIndex }}][addr_street]" value="{{ emergencyContact ? emergencyContact.currentAddress : '' }}" class="w-full border border-gray-300 rounded-lg text-xs shadow-2xs px-3 py-1.5 bg-white" placeholder="Street Address">
                                            </div>
                                            <div>
                                                <label class="text-[10px] font-bold text-gray-500 uppercase block mb-1">Zip Code</label>
                                                <input type="text" name="guardians[{{ emergencyIndex }}][addr_zip]" value="{{ emergencyContact ? emergencyContact.currentZip : '' }}" class="w-full border border-gray-300 rounded-lg text-xs shadow-2xs px-3 py-1.5 bg-white" placeholder="Zip Code">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </form>
        </div>
    </main>
</div>

