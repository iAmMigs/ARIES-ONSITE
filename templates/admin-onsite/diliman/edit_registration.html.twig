                                                <i class="ki-filled ki-dots-vertical text-xs"></i>
                                                <span>Actions</span>
                                                <i class="ki-filled ki-down text-[10px] opacity-70"></i>
                                            </button>
                                            <div class="doc-action-menu hidden absolute right-0 mt-1.5 w-44 bg-white rounded-xl shadow-lg border border-gray-200/90 py-1.5 z-30">
                                                <button type="button" onclick="closeAllDocActionMenus(); document.getElementById('applicantAvatarInput').click();" class="w-full text-left px-3 py-2 text-xs font-semibold text-gray-700 hover:bg-feu-green-50 hover:text-feu-green-700 flex items-center gap-2 transition-colors">
                                                    <i class="ki-filled ki-file-up text-sm text-emerald-600"></i>
