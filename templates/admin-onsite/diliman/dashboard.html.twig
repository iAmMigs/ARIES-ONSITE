{% extends 'base.html.twig' %}

{% block title %}Diliman Dashboard{% endblock %}

{% block body %}
<div class="flex h-screen overflow-hidden bg-gray-50">

    {% include 'admin-onsite/diliman/_sidebar.html.twig' with {'active_menu': 'dashboard'} %}

    {# --- MAIN CONTENT --- #}
    <main class="flex-1 flex flex-col min-w-0 overflow-hidden">
        {# Header #}
        {% include 'admin-onsite/diliman/_header.html.twig' with {'page_title': 'Dashboard'} %}

        {# Scrollable Content #}
        <div class="flex-1 overflow-y-auto p-8">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                {# Stat Cards #}
                {% for label, value in {'Today': stats.today, 'This Week': stats.week, 'This Month': stats.month, 'Total Applicants': stats.total} %}
                <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition-shadow">
                    <div class="text-sm text-gray-500 font-medium uppercase tracking-wide mb-2">{{ label }}</div>
                    <div class="flex items-end gap-2">
                        <span class="text-4xl font-bold text-feu-green-700">{{ value }}</span>
                        <span class="text-sm text-gray-400 mb-1">registrations</span>
                    </div>
                </div>
                {% endfor %}
            </div>

            {# Chart #}
            <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
                <h3 class="text-lg font-bold text-gray-800 mb-6">Registration Trends (Last 7 Days)</h3>
                <div id="registrationChart" style="height: 350px;"></div>
            </div>
        </div>
    </main>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var options = {
        series: [{
            name: 'Registrations',
            data: {{ chartData|map(d => d.count)|json_encode|raw }}
        }],
        chart: { type: 'area', height: 350, toolbar: { show: false } },
        colors: ['#1a4d2e'],
        fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.7, opacityTo: 0.9, stops: [0, 90, 100] } },
        dataLabels: { enabled: false },
        stroke: { curve: 'smooth', width: 2 },
        xaxis: { categories: {{ chartData|map(d => d.date)|json_encode|raw }} },
        tooltip: { y: { formatter: function (val) { return val + " Students" } } }
    };
    var chart = new ApexCharts(document.querySelector("#registrationChart"), options);
    chart.render();
});
</script>
{% endblock %}