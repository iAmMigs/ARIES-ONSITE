{% extends 'base.html.twig' %}

{% block title %}Diliman Dashboard{% endblock %}

{% block body %}
<div class="flex h-screen overflow-hidden bg-gray-50">

    {% include 'admin-onsite/diliman/_sidebar.html.twig' with {'active_menu': 'dashboard'} %}

    {# --- MAIN CONTENT --- #}
    <main class="flex-1 flex flex-col min-w-0 overflow-hidden">
        {# Header #}
        {% include 'admin-onsite/diliman/_header.html.twig' with {'page_title': 'Dashboard'} %}

        {# Scrollable Content #}
        <div class="flex-1 overflow-y-auto p-8">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                {# Stat Cards #}
                {% for label, value in {'Today': stats.today, 'This Week': stats.week, 'This Month': stats.month, 'Total Applicants': stats.total} %}
                <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition-shadow">
                    <div class="text-sm text-gray-500 font-medium uppercase tracking-wide mb-2">{{ label }}</div>
                    <div class="flex items-end gap-2">
                        <span class="text-4xl font-bold text-feu-green-700">{{ value }}</span>
                        <span class="text-sm text-gray-400 mb-1">registrations</span>
                    </div>
                </div>
                {% endfor %}
            </div>

            {# Chart #}
            <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm mb-8">
                <h3 class="text-lg font-bold text-gray-800 mb-6">Registration Trends (Last 7 Days)</h3>
                <div id="registrationChart" style="height: 350px;"></div>
            </div>

            {# Enrollment Summary Tables #}
            <div class="bg-white p-8 rounded-2xl border border-gray-200 shadow-sm mb-8">
                <div class="mb-6">
                    <h2 class="text-2xl font-black text-feu-green-900 uppercase tracking-tighter">Enrollment Summary - FEU DILIMAN</h2>
                    <p class="text-gray-500 font-bold">Current SY ({{ activeSY ? activeSY.label : 'N/A' }})</p>
                </div>

                <div class="overflow-x-auto mb-10">
                    <table class="w-full text-sm text-center border-collapse">
                        <thead>
                            <tr class="bg-black text-white uppercase text-[10px] tracking-widest font-black">
                                <th class="px-4 py-4 text-left border border-gray-800">Campus - Level</th>
                                <th class="px-4 py-4 border border-gray-800">New Students</th>
                                <th class="px-4 py-4 border border-gray-800">Transferees</th>
                                <th class="px-4 py-4 border border-gray-800">Total Applicants</th>
                            </tr>
                        </thead>
                        <tbody class="font-bold text-gray-700">
                            {% for row in summary.rows %}
                            <tr class="{% if loop.index is odd %}bg-gray-50{% endif %} hover:bg-feu-green-50 transition-colors">
                                <td class="px-4 py-3 text-left border border-gray-200">{{ row.name }}</td>
                                <td class="px-4 py-3 border border-gray-200">{{ row.new }}</td>
                                <td class="px-4 py-3 border border-gray-200">{{ row.transferee }}</td>
                                <td class="px-4 py-3 border border-gray-200">{{ row.current }}</td>
                            </tr>
                            {% endfor %}
                            <tr class="bg-gray-100 font-black text-black">
                                <td class="px-4 py-4 text-left border border-gray-200">Total</td>
                                <td class="px-4 py-4 border border-gray-200">{{ summary.total.new }}</td>
                                <td class="px-4 py-4 border border-gray-200">{{ summary.total.transferee }}</td>
                                <td class="px-4 py-4 border border-gray-200">{{ summary.total.current }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    {# GRS Table #}
                    <div>
                        <table class="w-full text-sm text-center border-collapse shadow-sm">
                            <thead>
                                <tr class="bg-black text-white uppercase text-[10px] tracking-widest font-black">
                                    <th class="px-4 py-3 border border-gray-800">GRS</th>
                                    <th class="px-4 py-3 border border-gray-800">New</th>
                                    <th class="px-4 py-3 border border-gray-800">Trans</th>
                                    <th class="px-4 py-3 border border-gray-800">Total</th>
                                </tr>
                            </thead>
                            <tbody class="font-bold">
                                {% set grsNew = 0 %}{% set grsTrans = 0 %}{% set grsTotal = 0 %}
                                {% for item in summary.grs %}
                                <tr class="{% if loop.index is odd %}bg-gray-50{% endif %}">
                                    <td class="px-4 py-2.5 text-left border border-gray-200 text-[11px]">{{ item.name }}</td>
                                    <td class="px-4 py-2.5 border border-gray-200">{{ item.new }}</td>
                                    <td class="px-4 py-2.5 border border-gray-200">{{ item.transferee }}</td>
                                    <td class="px-4 py-2.5 border border-gray-200">{{ item.total }}</td>
                                </tr>
                                {% set grsNew = grsNew + item.new %}{% set grsTrans = grsTrans + item.transferee %}{% set grsTotal = grsTotal + item.total %}
                                {% endfor %}
                                <tr class="bg-gray-100 font-black">
                                    <td class="px-4 py-3 text-left border border-gray-200">Total</td>
                                    <td class="px-4 py-3 border border-gray-200">{{ grsNew }}</td>
                                    <td class="px-4 py-3 border border-gray-200">{{ grsTrans }}</td>
                                    <td class="px-4 py-3 border border-gray-200">{{ grsTotal }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    {# JHS Table #}
                    <div>
                        <table class="w-full text-sm text-center border-collapse shadow-sm">
                            <thead>
                                <tr class="bg-black text-white uppercase text-[10px] tracking-widest font-black">
                                    <th class="px-4 py-3 border border-gray-800">JHS</th>
                                    <th class="px-4 py-3 border border-gray-800">New</th>
                                    <th class="px-4 py-3 border border-gray-800">Trans</th>
                                    <th class="px-4 py-3 border border-gray-800">Total</th>
                                </tr>
                            </thead>
                            <tbody class="font-bold">
                                {% set jhsNew = 0 %}{% set jhsTrans = 0 %}{% set jhsTotal = 0 %}
                                {% for item in summary.jhs %}
                                <tr class="{% if loop.index is odd %}bg-gray-50{% endif %}">
                                    <td class="px-4 py-2.5 text-left border border-gray-200 text-[11px]">{{ item.name }}</td>
                                    <td class="px-4 py-2.5 border border-gray-200">{{ item.new }}</td>
                                    <td class="px-4 py-2.5 border border-gray-200">{{ item.transferee }}</td>
                                    <td class="px-4 py-2.5 border border-gray-200">{{ item.total }}</td>
                                </tr>
                                {% set jhsNew = jhsNew + item.new %}{% set jhsTrans = jhsTrans + item.transferee %}{% set jhsTotal = jhsTotal + item.total %}
                                {% endfor %}
                                <tr class="bg-gray-100 font-black">
                                    <td class="px-4 py-3 text-left border border-gray-200">Total</td>
                                    <td class="px-4 py-3 border border-gray-200">{{ jhsNew }}</td>
                                    <td class="px-4 py-3 border border-gray-200">{{ jhsTrans }}</td>
                                    <td class="px-4 py-3 border border-gray-200">{{ jhsTotal }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    {# SHS Table #}
                    <div>
                        <table class="w-full text-sm text-center border-collapse shadow-sm">
                            <thead>
                                <tr class="bg-black text-white uppercase text-[10px] tracking-widest font-black">
                                    <th class="px-4 py-3 border border-gray-800">SHS (Frameworks)</th>
                                    <th class="px-4 py-3 border border-gray-800">New</th>
                                    <th class="px-4 py-3 border border-gray-800">Trans</th>
                                    <th class="px-4 py-3 border border-gray-800">Total</th>
                                </tr>
                            </thead>
                            <tbody class="font-bold">
                                {% set shsNew = 0 %}{% set shsTrans = 0 %}{% set shsTotal = 0 %}
                                {% for item in summary.shs %}
                                <tr class="{% if loop.index is odd %}bg-gray-50{% endif %}">
                                    <td class="px-4 py-2.5 text-left border border-gray-200 text-[11px]">{{ item.name }}</td>
                                    <td class="px-4 py-2.5 border border-gray-200">{{ item.new }}</td>
                                    <td class="px-4 py-2.5 border border-gray-200">{{ item.transferee }}</td>
                                    <td class="px-4 py-2.5 border border-gray-200">{{ item.total }}</td>
                                </tr>
                                {% set shsNew = shsNew + item.new %}{% set shsTrans = shsTrans + item.transferee %}{% set shsTotal = shsTotal + item.total %}
                                {% endfor %}
                                <tr class="bg-gray-100 font-black">
                                    <td class="px-4 py-3 text-left border border-gray-200">Total</td>
                                    <td class="px-4 py-3 border border-gray-200">{{ shsNew }}</td>
                                    <td class="px-4 py-3 border border-gray-200">{{ shsTrans }}</td>
                                    <td class="px-4 py-3 border border-gray-200">{{ shsTotal }}</td>
                                </tr>
                            </tbody>
                        </table>
                        <p class="text-[10px] text-red-500 font-bold italic mt-4">** enrollment breakdown per framework</p>
                    </div>
                </div>
            </div>

            {# University Discovery #}
            <div class="bg-white p-8 rounded-2xl border border-gray-200 shadow-sm mb-8">
                <div class="mb-6">
                    <h2 class="text-2xl font-black text-feu-green-900 uppercase tracking-tighter">University Discovery</h2>
                    <p class="text-gray-500 font-bold">Survey Tracking</p>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-center border-collapse">
                        <thead>
                            <tr class="bg-black text-white uppercase text-[10px] tracking-widest font-black">
                                <th class="px-4 py-4 text-left border border-gray-800">Source</th>
                                <th class="px-4 py-4 border border-gray-800">Count</th>
                                <th class="px-4 py-4 border border-gray-800">Percentage</th>
                            </tr>
                        </thead>
                        <tbody class="font-bold text-gray-700">
                            {% set discoveryTotal = 0 %}
                            {% for ds in discoveryStats %}{% set discoveryTotal = discoveryTotal + ds.cnt %}{% endfor %}

                            {% for ds in discoveryStats %}
                            <tr class="{% if loop.index is odd %}bg-gray-50{% endif %} hover:bg-feu-green-50 transition-colors">
                                <td class="px-4 py-3 text-left border border-gray-200">{{ ds.source }}</td>
                                <td class="px-4 py-3 border border-gray-200">{{ ds.cnt }}</td>
                                <td class="px-4 py-3 border border-gray-200">
                                    {{ discoveryTotal > 0 ? (ds.cnt / discoveryTotal * 100)|number_format(1) : 0 }}%
                                </td>
                            </tr>
                            {% endfor %}
                            <tr class="bg-gray-100 font-black text-black">
                                <td class="px-4 py-4 text-left border border-gray-200">Total Surveyed</td>
                                <td class="px-4 py-4 border border-gray-200">{{ discoveryTotal }}</td>
                                <td class="px-4 py-4 border border-gray-200">100%</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var options = {
        series: [{
            name: 'Registrations',
            data: {{ chartData|map(d => d.count)|json_encode|raw }}
        }],
        chart: { type: 'area', height: 350, toolbar: { show: false } },
        colors: ['#1a4d2e'],
        fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.7, opacityTo: 0.9, stops: [0, 90, 100] } },
        dataLabels: { enabled: false },
        stroke: { curve: 'smooth', width: 2 },
        xaxis: { categories: {{ chartData|map(d => d.date)|json_encode|raw }} },
        tooltip: { y: { formatter: function (val) { return val + " Students" } } }
    };
    var chart = new ApexCharts(document.querySelector("#registrationChart"), options);
    chart.render();
});
</script>
{% endblock %}