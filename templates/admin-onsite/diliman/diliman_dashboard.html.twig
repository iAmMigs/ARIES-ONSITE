{# templates/admin-onsite/diliman/diliman_dashboard.html.twig #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARIES Admin | Diliman Dashboard</title>
    <link href="{{ asset('metronic/vendors/keenicons/styles.bundle.css') }}" rel="stylesheet"/>
    <link rel="stylesheet" href="{{ asset('css/variables.css') }}">
    <link rel="stylesheet" href="{{ asset('css/base.css') }}">
    <link rel="stylesheet" href="{{ asset('css/pages/admin.css') }}">
</head>
<body>

<div class="admin-container" id="adminContainer">
    {# Sidebar with Flexbox for Bottom Alignment #}
    <aside class="admin-sidebar" style="display: flex; flex-direction: column;">
        <div class="sidebar-header">
            <div class="sidebar-logo">
                <div class="logo-icon"><i class="ki-filled ki-abstract-26"></i></div>
                <div class="logo-text"><h2>ARIES</h2><p>Diliman - Admin Console</p></div>
            </div>
            <button class="btn-toggle-sidebar" id="sidebarToggle"><i class="ki-filled ki-double-left"></i></button>
        </div>
        
        {# Main Nav grows to push logout to bottom #}
        <nav class="sidebar-nav" style="flex-grow: 1;">
            <a href="{{ path('app_admin_diliman_dashboard') }}" class="nav-item active"><i class="ki-filled ki-people"></i><span>Registrations</span></a>
        </nav>

        {# Logout Button at Bottom #}
        <div class="sidebar-footer" style="padding: 1rem; border-top: 1px solid rgba(255,255,255,0.1);">
            <a href="{{ path('app_logout') }}" class="nav-item" style="color: #fca5a5; display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-radius: 8px; transition: all 0.2s; text-decoration: none;">
                <i class="ki-filled ki-exit-right"></i>
                <span>Sign Out</span>
            </a>
        </div>
    </aside>

    <main class="admin-main">
        <header class="admin-header">
            <h1 class="page-title">
                Showing 
                {% if current_filter %}
                    {{ current_filter }} Applicants
                {% else %}
                    All Applicants
                {% endif %}
            </h1>
            
            <div class="header-actions">
                <form method="get" action="{{ path('app_admin_diliman_dashboard') }}" class="filter-form">
                    <div class="filter-wrapper">
                        <i class="ki-filled ki-filter"></i>
                        <select name="grade" onchange="this.form.submit()" class="form-select-sm">
                            <option value="">All Levels</option>
                            {% for grade in available_grades %}
                                <option value="{{ grade }}" {{ current_filter == grade ? 'selected' : '' }}>
                                    {{ grade }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </form>

                <div class="search-box">
                    <i class="ki-filled ki-magnifier"></i>
                    <input type="text" placeholder="Search student...">
                </div>
                
                <div class="admin-profile">
                    <img src="{{ asset('metronic/media/avatars/300-1.png') }}" alt="Admin">
                </div>
                {# Logout button removed from here #}
            </div>
        </header>

        <div class="admin-content">
            <div class="table-card">
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th class="col-img">Photo</th>
                                <th>Student ID</th>
                                <th>Full Name</th>
                                <th>Level / Strand</th>
                                <th>Status</th>
                                <th>Date Applied</th>
                                <th class="col-action">Action</th>
                            </tr>
                        </thead>
                        {# Added Stimulus Controller for Polling (Real-time updates) #}
                        <tbody data-controller="poll" 
                               data-poll-url-value="{{ path('app_admin_diliman_table_content') }}"
                               data-poll-refresh-interval-value="5000">
                            {% include 'admin-onsite/diliman/_table_rows.html.twig' %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>

<script>
    const toggleBtn = document.getElementById('sidebarToggle');
    const container = document.getElementById('adminContainer');
    if(toggleBtn){
        toggleBtn.addEventListener('click', () => {
            container.classList.toggle('sidebar-collapsed');
            const icon = toggleBtn.querySelector('i');
            if(container.classList.contains('sidebar-collapsed')) {
                icon.classList.remove('ki-double-left'); icon.classList.add('ki-double-right');
            } else {
                icon.classList.remove('ki-double-right'); icon.classList.add('ki-double-left');
            }
        });
    }
</script>
</body>
</html>