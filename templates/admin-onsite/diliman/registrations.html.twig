{% extends 'base.html.twig' %}

{% block title %}Diliman Registrations{% endblock %}

{% block body %}
<div class="flex h-screen overflow-hidden bg-gray-50">
    {% include 'admin-onsite/diliman/_sidebar.html.twig' with {'active_menu': 'registrations'} %}

    <main class="flex-1 flex flex-col min-w-0 overflow-hidden">
        {% include 'admin-onsite/diliman/_header.html.twig' with {'page_title': 'Registrations'} %}

        <div class="flex-1 overflow-y-auto p-8">
            <div class="max-w-7xl mx-auto">
                
                {# --- FILTER CARD --- #}
                <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-200 mb-6">
                    <form method="GET" action="{{ path('app_admin_diliman_registrations') }}" class="flex flex-col md:flex-row gap-4 items-end" id="filterForm">
                        
                        {# 1. Search Keyword #}
                        <div class="w-full md:w-1/4">
                            <label class="text-xs font-bold text-gray-500 uppercase mb-1 block">Search</label>
                            <div class="relative">
                                <i class="ki-filled ki-magnifier absolute left-3 top-2.5 text-gray-400"></i>
                                <input type="text" name="search" value="{{ filters.search|default('') }}" class="w-full border border-gray-300 rounded-lg pl-10 pr-3 py-2 text-sm outline-none focus:border-feu-green-500 transition-colors" placeholder="Name or Student No.">
                            </div>
                        </div>

                        {# 2. Education Level #}
                        <div class="w-full md:w-1/6">
                            <label class="text-xs font-bold text-gray-500 uppercase mb-1 block">Education</label>
                            <select name="education_type" id="eduSelect" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-feu-green-500 bg-white" onchange="toggleGradeOptions()">
                                <option value="">All Levels</option>
                                <option value="Primary" {{ filters.education_type|default('') == 'Primary' ? 'selected' : '' }}>Primary (K-6)</option>
                                <option value="Secondary" {{ filters.education_type|default('') == 'Secondary' ? 'selected' : '' }}>Secondary (7-12)</option>
                            </select>
                        </div>

                        {# 3. Grade Level (Custom Checkbox Dropdown) #}
                        <div class="w-full md:w-1/4 relative group">
                            <label class="text-xs font-bold text-gray-500 uppercase mb-1 block">Grade Level</label>
                            <button type="button" class="w-full text-left border border-gray-300 rounded-lg px-3 py-2 text-sm bg-white flex justify-between items-center" onclick="document.getElementById('gradeDropdown').classList.toggle('hidden')">
                                <span class="text-gray-600">Select Grades...</span>
                                <i class="ki-filled ki-down text-xs text-gray-400"></i>
                            </button>
                            
                            <div id="gradeDropdown" class="hidden absolute top-full left-0 w-full bg-white border border-gray-200 rounded-lg shadow-xl mt-1 z-50 p-3 max-h-60 overflow-y-auto">
                                <div class="space-y-2">
                                    {# Primary Options #}
                                    <div class="grade-group-primary">
                                        <div class="text-[10px] font-bold text-feu-green-600 uppercase bg-green-50 p-1 rounded mb-1">Primary</div>
                                        <label class="flex items-center gap-2 cursor-pointer hover:bg-gray-50 p-1 rounded"><input type="checkbox" name="grade_levels[]" value="kinder" {{ 'kinder' in filters.grade_levels|default([]) ? 'checked' : '' }} class="rounded border-gray-300 text-feu-green-600 focus:ring-feu-green-500"> <span class="text-sm">Kinder</span></label>
                                        {% for i in 1..6 %}
                                            <label class="flex items-center gap-2 cursor-pointer hover:bg-gray-50 p-1 rounded"><input type="checkbox" name="grade_levels[]" value="grade_{{ i }}" {{ ('grade_' ~ i) in filters.grade_levels|default([]) ? 'checked' : '' }} class="rounded border-gray-300 text-feu-green-600 focus:ring-feu-green-500"> <span class="text-sm">Grade {{ i }}</span></label>
                                        {% endfor %}
                                    </div>
                                    
                                    {# Secondary Options #}
                                    <div class="grade-group-secondary border-t pt-2 mt-2">
                                        <div class="text-[10px] font-bold text-feu-green-600 uppercase bg-green-50 p-1 rounded mb-1">Secondary</div>
                                        {% for i in 7..12 %}
                                            <label class="flex items-center gap-2 cursor-pointer hover:bg-gray-50 p-1 rounded"><input type="checkbox" name="grade_levels[]" value="grade_{{ i }}" {{ ('grade_' ~ i) in filters.grade_levels|default([]) ? 'checked' : '' }} class="rounded border-gray-300 text-feu-green-600 focus:ring-feu-green-500"> <span class="text-sm">Grade {{ i }}</span></label>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        </div>

                        {# 4. Date #}
                        <div class="w-full md:w-1/6">
                            <label class="text-xs font-bold text-gray-500 uppercase mb-1 block">Date Applied</label>
                            <input type="date" name="date" value="{{ filters.date|default('') }}" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-feu-green-500">
                        </div>

                        {# Actions #}
                        <div class="flex gap-2 w-full md:w-auto">
                            <button type="submit" class="bg-feu-green-700 hover:bg-feu-green-800 text-white font-bold px-4 py-2 rounded-lg text-sm transition-colors flex items-center gap-2">
                                <i class="ki-filled ki-filter"></i> Filter
                            </button>
                            <a href="{{ path('app_admin_diliman_registrations') }}" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold px-4 py-2 rounded-lg text-sm transition-colors" title="Reset">
                                <i class="ki-filled ki-cross"></i>
                            </a>
                        </div>
                    </form>
                </div>

                {# --- TABLE --- #}
                <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="table w-full">
                            <thead>
                                <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider font-bold border-b border-gray-200">
                                    <th class="px-6 py-4">2x2 Picture</th>
                                    <th class="px-6 py-4">Student ID</th>
                                    <th class="px-6 py-4">Name</th>
                                    <th class="px-6 py-4">Education</th>
                                    <th class="px-6 py-4">Status</th>
                                    <th class="px-6 py-4">Date Applied</th>
                                    <th class="px-6 py-4 text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                {% include 'admin-onsite/diliman/_table_rows.html.twig' %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

<script>
    // Close dropdown when clicking outside
    document.addEventListener('click', function(event) {
        const dropdown = document.getElementById('gradeDropdown');
        const button = dropdown.previousElementSibling;
        if (!button.contains(event.target) && !dropdown.contains(event.target)) {
            dropdown.classList.add('hidden');
        }
    });

    function toggleGradeOptions() {
        const eduType = document.getElementById('eduSelect').value;
        const primaryGroup = document.querySelector('.grade-group-primary');
        const secondaryGroup = document.querySelector('.grade-group-secondary');
        const checkboxes = document.querySelectorAll('#gradeDropdown input[type="checkbox"]');

        // 1. Reset Display
        if (primaryGroup) primaryGroup.style.display = 'block';
        if (secondaryGroup) secondaryGroup.style.display = 'block';

        // 2. Hide based on selection
        if (eduType === 'Primary') {
            if (secondaryGroup) secondaryGroup.style.display = 'none';
        } else if (eduType === 'Secondary') {
            if (primaryGroup) primaryGroup.style.display = 'none';
        }

        // Optional: Uncheck hidden boxes to prevent filtering confusion?
        // For now, we leave them checked so users don't lose state accidentally, 
        // but visually they are hidden.
    }

    // Run on load to set initial state
    document.addEventListener('DOMContentLoaded', toggleGradeOptions);
</script>
{% endblock %}