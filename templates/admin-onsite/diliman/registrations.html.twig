{% extends 'base.html.twig' %}

{% block title %}Diliman Registrations{% endblock %}

{% block body %}
<div class="flex h-screen overflow-hidden bg-gray-50">
    <aside class="w-[280px] bg-feu-green-900 text-white flex flex-col flex-shrink-0 transition-all duration-300 z-50">
        <div class="h-20 flex items-center gap-3 px-6 bg-feu-green-800/50">
            <i class="ki-filled ki-abstract-26 text-3xl text-feu-gold-400"></i>
            <div><h1 class="text-2xl font-bold tracking-tight">ARIES</h1><p class="text-xs text-feu-green-200 uppercase tracking-wider">Diliman Admin</p></div>
        </div>
        <nav class="flex-1 px-4 py-6 space-y-1 overflow-y-auto">
            <a href="{{ path('app_admin_diliman_dashboard') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl text-feu-green-100 hover:bg-feu-green-800 transition-all">
                <i class="ki-filled ki-chart-pie-simple text-xl"></i><span>Dashboard</span>
            </a>
            <a href="{{ path('app_admin_diliman_registrations') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-feu-gold-500 text-feu-green-900 font-bold transition-all shadow-lg shadow-feu-gold-500/20">
                <i class="ki-filled ki-people text-xl"></i><span>Registrations</span>
            </a>
        </nav>
        <div class="p-4 border-t border-feu-green-800">
            <a href="{{ path('app_logout') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl text-red-300 hover:bg-red-900/20 transition-all"><i class="ki-filled ki-exit-right text-xl"></i><span>Sign Out</span></a>
        </div>
    </aside>

    <main class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <header class="h-20 bg-white border-b border-gray-200 flex items-center justify-between px-8 flex-shrink-0">
            {# RENAMED TITLE #}
            <h2 class="text-xl font-bold text-gray-800">Student Registration List</h2>
            <div class="flex items-center gap-4">
                <div class="text-right hidden sm:block"><div class="text-sm font-bold text-gray-900">Admin User</div><div class="text-xs text-gray-500">Administrator</div></div>
                <img src="{{ asset('metronic/media/avatars/300-1.png') }}" class="w-10 h-10 rounded-lg object-cover ring-2 ring-gray-100">
            </div>
        </header>

        <div class="flex-1 overflow-y-auto p-8">
            <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
                <div class="p-5 border-b border-gray-200 bg-gray-50/50">
                    <form method="get" class="flex flex-wrap gap-4 items-end">
                        <div class="w-40">
                            <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Education</label>
                            <select name="edu_level" class="form-select w-full text-sm border-gray-300 rounded-lg" onchange="this.form.submit()">
                                <option value="">All Levels</option>
                                <option value="Primary" {{ filters.edu_level|default == 'Primary' ? 'selected' }}>Primary (K-6)</option>
                                <option value="Secondary" {{ filters.edu_level|default == 'Secondary' ? 'selected' }}>Secondary (7-12)</option>
                            </select>
                        </div>
                        <div class="w-32">
                            <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Grade</label>
                            <select name="grade" class="form-select w-full text-sm border-gray-300 rounded-lg" onchange="this.form.submit()">
                                <option value="">All</option>
                                {% for g in ['Kinder','Grade 1','Grade 2','Grade 3','Grade 4','Grade 5','Grade 6','Grade 7','Grade 8','Grade 9','Grade 10','Grade 11','Grade 12'] %}
                                    <option value="{{ g }}" {{ filters.grade|default == g ? 'selected' }}>{{ g }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="w-40">
                            <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Date Applied</label>
                            <input type="date" name="date" value="{{ filters.date|default }}" class="form-input w-full text-sm border-gray-300 rounded-lg" onchange="this.form.submit()">
                        </div>
                        <a href="{{ path('app_admin_diliman_registrations') }}" class="btn btn-sm btn-light text-gray-600 hover:bg-gray-200 mb-0.5">Reset</a>
                    </form>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider font-bold border-b border-gray-200">
                                <th class="px-6 py-4">Photo</th>
                                <th class="px-6 py-4">Student ID</th>
                                <th class="px-6 py-4">Full Name</th>
                                <th class="px-6 py-4">Level / Strand</th>
                                <th class="px-6 py-4">Status</th>
                                <th class="px-6 py-4">Date Applied</th>
                                <th class="px-6 py-4 text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            {% for r in registrations %}
                            <tr class="hover:bg-gray-50/80 transition-colors group">
                                <td class="px-6 py-3">
                                    {% if r.photoSlug %}
                                        <img src="{{ asset(r.photoSlug) }}" class="w-10 h-10 rounded-full object-cover border border-gray-200">
                                    {% else %}
                                        <div class="w-10 h-10 rounded-full bg-feu-green-100 text-feu-green-700 flex items-center justify-center font-bold text-sm">{{ r.firstName|first }}</div>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-3 font-mono text-sm text-gray-600">{{ r.studentNumber }}</td>
                                <td class="px-6 py-3 font-semibold text-gray-800">{{ r.lastName }}, {{ r.firstName }}</td>
                                <td class="px-6 py-3">
                                    <div class="flex gap-1">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-100">
                                            {{ r.gradeLevel|replace({'_': ' '})|title }}
                                        </span>
                                        {% if r.trackStrand %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700 border border-amber-100">{{ r.trackStrand }}</span>
                                        {% endif %}
                                    </div>
                                </td>
                                <td class="px-6 py-3">
                                    {% if r.admissionStatus == 'Pending' or r.admissionStatus == 'P' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-bold bg-yellow-100 text-yellow-800 border border-yellow-200">
                                            <i class="ki-filled ki-time text-[10px] mr-1"></i> Pending Exam
                                        </span>
                                    {% elseif r.admissionStatus == 'Enrolled' %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-bold bg-green-100 text-green-800 border border-green-200">Enrolled</span>
                                    {% else %}
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-bold bg-gray-100 text-gray-800 border border-gray-200">{{ r.admissionStatus }}</span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-3 text-sm text-gray-500">{{ r.createdAt|date('M d, Y') }}</td>
                                <td class="px-6 py-3 text-center">
                                    <div class="flex items-center justify-center gap-2">
                                        <a href="{{ path('app_admin_diliman_registration_view', {'id': r.studentNumber}) }}" class="w-8 h-8 flex items-center justify-center rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-100" title="View"><i class="ki-filled ki-eye"></i></a>
                                        <a href="{{ path('app_admin_diliman_registration_edit', {'id': r.studentNumber}) }}" class="w-8 h-8 flex items-center justify-center rounded-lg bg-amber-50 text-amber-600 hover:bg-amber-100" title="Edit"><i class="ki-filled ki-pencil"></i></a>
                                        {# DELETE BUTTON REMOVED #}
                                    </div>
                                </td>
                            </tr>
                            {% else %}
                            <tr><td colspan="7" class="px-6 py-12 text-center text-gray-400">No applicants found.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}