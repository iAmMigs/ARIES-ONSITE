{% extends 'base.html.twig' %}

{% block title %}Alabang Registrations{% endblock %}

{% block body %}
<div class="flex h-screen overflow-hidden bg-gray-50">

    {% include 'admin-onsite/alabang/_sidebar.html.twig' with {'active_menu': 'registrations'} %}

    <main class="flex-1 flex flex-col min-w-0 overflow-hidden">

        {% include 'admin-onsite/alabang/_header.html.twig' with {'page_title': 'Student Registrations List'} %}

        <div class="flex-1 overflow-y-auto p-8">
            <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
                <div class="p-5 border-b border-gray-200 bg-gray-50/50">
                    <form method="get" class="flex flex-wrap gap-4 items-end">
                        <div class="w-40">
                            <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Grade</label>
                            <select name="grade" class="form-select w-full text-sm border-gray-300 rounded-lg" onchange="this.form.submit()">
                                <option value="">All</option>
                                <option value="Grade 11" {{ filters.grade|default == 'Grade 11' ? 'selected' }}>Grade 11</option>
                                <option value="Grade 12" {{ filters.grade|default == 'Grade 12' ? 'selected' }}>Grade 12</option>
                            </select>
                        </div>
                        <div class="w-40">
                            <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Date Applied</label>
                            <input type="date" name="date" value="{{ filters.date|default }}" class="form-input w-full text-sm border-gray-300 rounded-lg" onchange="this.form.submit()">
                        </div>
                        <a href="{{ path('app_admin_alabang_registrations') }}" class="btn btn-sm btn-light text-gray-600 hover:bg-gray-200 mb-0.5">Reset</a>
                    </form>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider font-bold border-b border-gray-200">
                                <th class="px-6 py-4">Photo</th>
                                <th class="px-6 py-4">Student ID</th>
                                <th class="px-6 py-4">Full Name</th>
                                <th class="px-6 py-4">Level / Strand</th>
                                <th class="px-6 py-4">Status</th>
                                <th class="px-6 py-4">Date Applied</th>
                                <th class="px-6 py-4 text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            {% for r in registrations %}
                            <tr class="hover:bg-gray-50/80 transition-colors group">
                                <td class="px-6 py-3">
                                    {% if r.photoSlug %}
                                        <img src="{{ asset(r.photoSlug) }}" class="w-10 h-10 rounded-full object-cover border border-gray-200">
                                    {% else %}
                                        <div class="w-10 h-10 rounded-full bg-feu-green-100 text-feu-green-700 flex items-center justify-center font-bold text-sm">{{ r.firstName|first }}</div>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-3 font-mono text-sm text-gray-600">{{ r.studentNumber }}</td>
                                <td class="px-6 py-3 font-semibold text-gray-800">{{ r.lastName }}, {{ r.firstName }}</td>
                                <td class="px-6 py-3">
                                    <div class="flex gap-1">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-100">
                                            {{ r.gradeLevel|replace({'_': ' '})|title }}
                                        </span>
                                        {% if r.trackStrand %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700 border border-amber-100">{{ r.trackStrand }}</span>
                                        {% endif %}
                                    </div>
                                </td>
                                <td class="px-6 py-3">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-bold bg-gray-100 text-gray-800 border border-gray-200">{{ r.admissionStatus }}</span>
                                </td>
                                <td class="px-6 py-3 text-sm text-gray-500">{{ r.createdAt|date('M d, Y') }}</td>
                                <td class="px-6 py-3 text-center">
                                    <div class="flex items-center justify-center gap-2">
                                        <a href="{{ path('app_admin_alabang_registration_view', {'id': r.studentNumber}) }}" class="w-8 h-8 flex items-center justify-center rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-100" title="View"><i class="ki-filled ki-eye"></i></a>
                                        <a href="{{ path('app_admin_alabang_registration_edit', {'id': r.studentNumber}) }}" class="w-8 h-8 flex items-center justify-center rounded-lg bg-amber-50 text-amber-600 hover:bg-amber-100" title="Edit"><i class="ki-filled ki-pencil"></i></a>
                                        {# DELETE BUTTON REMOVED #}
                                    </div>
                                </td>
                            </tr>
                            {% else %}
                            <tr><td colspan="7" class="px-6 py-12 text-center text-gray-400">No applicants found.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}