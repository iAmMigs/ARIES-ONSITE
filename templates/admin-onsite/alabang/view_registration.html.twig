{% extends 'base.html.twig' %}

{% block title %}View Registration{% endblock %}

{% block body %}
<div class="flex h-screen overflow-hidden bg-gray-50">

    {% include 'admin-onsite/alabang/_sidebar.html.twig' with {'active_menu': 'registrations'} %}

    <main class="flex-1 flex flex-col min-w-0 overflow-hidden">
        {% include 'admin-onsite/alabang/_header.html.twig' with {'page_title': 'View Student Details'} %}

        <div class="flex-1 overflow-y-auto p-6 lg:p-8">
            {# Action Navigation Bar #}
            <div class="max-w-7xl mx-auto mb-6 flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <a href="{{ path('app_admin_alabang_registrations') }}" class="inline-flex items-center gap-2 px-3.5 py-2 bg-white border border-gray-200 rounded-xl text-gray-700 hover:text-feu-green-700 hover:border-feu-green-300 shadow-2xs transition-all font-semibold text-xs">
                        <i class="ki-filled ki-arrow-left text-sm"></i>
                        <span>Back to List</span>
                    </a>
                </div>
                <div class="flex items-center gap-2.5">
                    <a href="{{ path('app_admin_alabang_registration_pdf', {'id': registration.studentNumber}) }}" 
                       class="inline-flex items-center gap-2 bg-white border border-gray-200 text-gray-700 hover:text-feu-green-800 hover:border-feu-green-300 hover:bg-gray-50/80 px-4 py-2 rounded-xl text-xs font-bold transition-all shadow-2xs"
                       title="Export and Download Official PDF Record">
                        <i class="ki-filled ki-file-down text-base text-feu-green-700"></i>
                        <span>Export PDF</span>
                    </a>
                    <a href="{{ path('app_admin_alabang_registration_edit', {'id': registration.studentNumber}) }}" class="inline-flex items-center gap-2 bg-feu-green-600 hover:bg-feu-green-700 text-white px-4 py-2 rounded-xl text-xs font-bold shadow-sm shadow-feu-green-700/20 transition-all">
                        <i class="ki-filled ki-pencil text-sm"></i>
                        <span>Edit Details</span>
                    </a>
                </div>
            </div>

            <div class="max-w-7xl mx-auto grid grid-cols-12 gap-6">
                {# --- 1. APPLICANT CARD (Banner) --- #}
                <div class="col-span-12 bg-white rounded-2xl p-6 shadow-xs border border-gray-200/80 flex flex-col md:flex-row gap-6 md:gap-8 items-start relative overflow-hidden">
                    
                    <div class="flex-shrink-0">
                        {% if registration.photoSlug %}
                            <img src="{{ asset(registration.photoSlug) }}" class="w-36 h-36 rounded-2xl object-cover border-4 border-white shadow-md ring-1 ring-gray-200/60" alt="Student Photo">
                        {% else %}
                            <div class="w-36 h-36 rounded-2xl bg-feu-green-50 text-feu-green-700 flex items-center justify-center text-4xl font-black border-4 border-white shadow-md ring-1 ring-gray-200/60">
                                {{ registration.firstName|first }}
                            </div>
                        {% endif %}
                    </div>

                    <div class="flex-grow pt-1 min-w-0">
                        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-1 truncate">{{ registration.lastName }}, {{ registration.firstName }} {{ registration.middleName }}</h2>
                        {% if registration.preferredName %}
                            <div class="text-sm font-semibold text-gray-500 mb-2.5">
                                &ldquo;{{ registration.preferredName }}&rdquo;
                            </div>
                        {% endif %}
                        
                        <div class="flex flex-wrap items-center gap-2 mb-4">
                            <div class="px-3 py-1 rounded-lg bg-gray-100 text-gray-700 text-xs font-bold tracking-wide border border-gray-200/70 font-mono">
                                <span class="text-[10px] text-gray-400 uppercase mr-1">ID</span>{{ registration.studentNumber }}
                            </div>

                            {% if registration.lrn %}
                                <div class="px-3 py-1 rounded-lg bg-blue-50 text-blue-700 text-xs font-bold tracking-wide border border-blue-200/70 font-mono">
                                    <span class="text-[10px] text-blue-400 uppercase mr-1">LRN</span>{{ registration.lrn }}
                                </div>
                            {% endif %}

                            <div class="px-3 py-1 rounded-lg bg-purple-50 text-purple-700 text-xs font-bold border border-purple-200/60">
                                {{ registration.admissionType|default('New Student') }}
                            </div>

                            <div class="px-3 py-1 rounded-lg bg-emerald-50 text-emerald-800 text-xs font-bold border border-emerald-200/60">
                                {{ registration.gradeLevel|replace({'_': ' '})|title }}
                            </div>

                            {% if registration.trackStrand %}
                                <div class="px-3 py-1 rounded-lg bg-amber-50 text-amber-800 text-xs font-bold border border-amber-200/60">
                                    {{ registration.trackStrand }}
                                </div>
                            {% endif %}
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-2 gap-x-4 text-xs font-medium text-gray-600">
                            <div class="flex items-center gap-2 truncate">
                                <i class="ki-filled ki-sms text-feu-green-600 text-sm flex-shrink-0"></i>
                                <span class="truncate">{{ registration.personalEmail }}</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <i class="ki-filled ki-phone text-feu-green-600 text-sm flex-shrink-0"></i>
                                <span>{{ registration.mobileNumber }}</span>
                            </div>
                        </div>
                    </div>

                    {% if registration.educationType == 'SHS' %}
                    <div class="flex-shrink-0 self-stretch md:self-center bg-gray-50/80 p-4 rounded-xl border border-gray-200/70 text-center min-w-[170px] shadow-2xs">
                        <div class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1.5">
                            {% if registration.examinationScore is not null %}
                                Examination Score
                            {% else %}
                                Examination Status
                            {% endif %}
                        </div>
                        <div class="text-lg font-black text-feu-green-700">
                            {% if registration.examinationScore is not null %}
                                <span class="text-2xl">{{ registration.examinationScore }}</span>
                                {% if registration.examinationDate %}
                                    <div class="text-[10px] text-gray-400 uppercase font-semibold mt-1 pt-1 border-t border-gray-200/70">
                                        Taken: {{ registration.examinationDate|date('M d, Y') }}
                                    </div>
                                {% endif %}
                            {% else %}
                                <span class="text-sm font-bold text-amber-600">
                                    {{ registration.admissionStatus == 'Pending' or registration.admissionStatus == 'P' ? 'Pending Exam' : registration.admissionStatus }}
                                </span>
                            {% endif %}
                        </div>
                        <div class="mt-3 pt-3 border-t border-gray-200/70">
                            <div class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1">Payment Status</div>
                            <div>
                                {% if registration.examinationScore is not null or registration.admissionStatus in ['Paid', 'Enrolled', 'Completed', 'C'] %}
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">
                                        <i class="ki-filled ki-check-circle text-xs"></i> Paid
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800">
                                        <i class="ki-filled ki-time text-xs"></i> For Payment
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    {% else %}
                    <div class="flex-shrink-0 self-stretch md:self-center bg-gray-50/80 p-4 rounded-xl border border-gray-200/70 text-center min-w-[170px] shadow-2xs">
                        <div class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mb-1.5">Payment Status</div>
                        <div>
                            {% if registration.admissionStatus in ['Paid', 'Enrolled', 'Completed', 'C'] %}
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-extrabold bg-emerald-100 text-emerald-800">
                                    <i class="ki-filled ki-check-circle text-xs"></i> Paid
                                </span>
                            {% else %}
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-extrabold bg-amber-100 text-amber-800">
                                    <i class="ki-filled ki-time text-xs"></i> For Payment
                                </span>
                            {% endif %}
                        </div>
                    </div>
                    {% endif %}
                </div>

                {# --- 2. DETAILS GRID (Left Column 8-Cols) --- #}
                <div class="col-span-12 lg:col-span-8 space-y-6">
                    {# Personal Information Card #}
                    <div class="bg-white rounded-2xl p-6 shadow-xs border border-gray-200/80">
                        <div class="flex items-center gap-2.5 mb-5 pb-3 border-b border-gray-100">
                            <div class="w-8 h-8 rounded-lg bg-feu-green-50 text-feu-green-700 flex items-center justify-center text-sm border border-feu-green-100 flex-shrink-0">
                                <i class="ki-filled ki-user text-base"></i>
                            </div>
                            <h3 class="text-lg font-bold text-gray-900">Personal Information</h3>
                        </div>

                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3.5">
                            {% set genderFormatted = registration.gender|upper in ['M', 'MALE'] ? 'Male' : (registration.gender|upper in ['F', 'FEMALE'] ? 'Female' : registration.gender|default('N/A')) %}
                            {% set personalFields = [
                                {'label': 'Gender', 'value': genderFormatted},
                                {'label': 'Birthday', 'value': registration.birthDate|date('F j, Y')},
                                {'label': 'Birth Place', 'value': registration.birthPlace|default('N/A')},
                                {'label': 'Religion', 'value': registration.religion|default('N/A')},
                                {'label': 'Nationality', 'value': registration.nationality|default('FILIPINO')},
                                {'label': 'Citizenship', 'value': registration.citizenship},
                                {'label': 'LRN (Learner Ref. No.)', 'value': registration.lrn|default('N/A')},
                                {'label': 'Suffix', 'value': registration.suffix|default('N/A')},
                                {'label': 'Country of Birth', 'value': registration.countryOfBirth|default('N/A')},
                                {'label': 'Country of Residence', 'value': registration.countryOfResidence|default('N/A')}
                            ] %}
                            {% for f in personalFields %}
                                <div class="p-3.5 rounded-xl bg-gray-50/70 border border-gray-200/60 shadow-2xs hover:bg-white hover:shadow-xs transition-all">
                                    <div class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">{{ f.label }}</div>
                                    <div class="text-[15px] font-bold text-gray-900 leading-snug truncate" title="{{ f.value }}">{{ f.value }}</div>
                                </div>
                            {% endfor %}
                        </div>

                        {% if registration.citizenship|upper == 'INTERNATIONAL' %}
                            <div class="mt-6 pt-5 border-t border-gray-100">
                                <h4 class="text-xs font-bold text-feu-green-800 uppercase tracking-wider mb-3.5 flex items-center gap-2">
                                    <i class="ki-filled ki-profile-circle text-sm"></i> Passport & Visa Details
                                </h4>
                                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3.5">
                                    {% set passportFields = [
                                        {'label': 'Passport Number', 'value': registration.passport.passportNumber|default(registration.passportNumber)|default('N/A')},
                                        {'label': 'Country of Issue', 'value': registration.passport.countryOfIssue|default('N/A')},
                                        {'label': 'Date Issued', 'value': registration.passport.dateIssued ? registration.passport.dateIssued|date('F j, Y') : 'N/A'},
                                        {'label': 'Expiration Date', 'value': registration.passport.expirationDate ? registration.passport.expirationDate|date('F j, Y') : 'N/A'},
                                        {'label': 'Visa Type', 'value': registration.visaType|default('N/A')|title},
                                        {'label': 'Visa Status', 'value': registration.visaStatus|default('N/A')}
                                    ] %}
                                    {% for pf in passportFields %}
                                        <div class="p-3.5 rounded-xl bg-gray-50/70 border border-gray-200/60 shadow-2xs">
                                            <div class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">{{ pf.label }}</div>
                                            <div class="text-[15px] font-bold text-gray-900 leading-snug truncate" title="{{ pf.value }}">{{ pf.value }}</div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                    </div>

                    {# Address Information Card #}
                    <div class="bg-white rounded-2xl p-6 shadow-xs border border-gray-200/80">
                        <div class="flex items-center gap-2.5 mb-5 pb-3 border-b border-gray-100">
                            <div class="w-8 h-8 rounded-lg bg-feu-green-50 text-feu-green-700 flex items-center justify-center text-sm border border-feu-green-100 flex-shrink-0">
                                <i class="ki-filled ki-map text-base"></i>
                            </div>
                            <h3 class="text-lg font-bold text-gray-900">Address Information</h3>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            {# Current Address Block #}
                            <div class="p-5 rounded-2xl bg-white border border-gray-200/80 shadow-xs border-l-4 border-l-feu-green-600">
                                <div class="text-xs font-bold text-feu-green-700 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                                    <i class="ki-filled ki-geolocation text-sm"></i> Current Address
                                </div>
                                <p class="text-[15px] font-bold text-gray-900 leading-snug mt-2">{{ registration.currentAddress|default('No Street Address Provided') }}</p>
                                <div class="text-sm text-gray-600 mt-1">
                                    {{ [registration.currentBarangay|location_barangay, registration.currentCity|location_city, registration.currentProvince|location_province]|filter(v => v is not empty and v|trim != '')|join(', ') }}{% if registration.currentZip %} {{ registration.currentZip }}{% endif %}
                                </div>
                            </div>

                            {# Permanent Address Block #}
                            <div class="p-5 rounded-2xl bg-white border border-gray-200/80 shadow-xs border-l-4 border-l-amber-500">
                                <div class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                                    <i class="ki-filled ki-home text-sm"></i> Permanent Address
                                </div>
                                {% if registration.citizenship|upper == 'INTERNATIONAL' %}
                                    <p class="text-[15px] font-bold text-gray-900 leading-snug mt-2">{{ registration.permanentAddress|default('No Permanent Address Provided') }}</p>
                                    <div class="text-sm text-gray-600 mt-1">
                                        {{ [registration.permanentBarangay|default('')|location_barangay, registration.permanentCity|default('')|location_city, registration.permanentProvince|default('')|location_province, registration.permanentCountry|default('')]|filter(v => v is not empty and v|trim != '')|join(', ') }}{% if registration.permanentZip %} {{ registration.permanentZip }}{% endif %}
                                    </div>
                                {% else %}
                                    <p class="text-[15px] font-bold text-gray-900 leading-snug mt-2">{{ registration.permanentAddress|default('No Permanent Address Provided') }}</p>
                                    <div class="text-sm text-gray-600 mt-1">
                                        {{ [registration.permanentBarangay|location_barangay, registration.permanentCity|location_city, registration.permanentProvince|location_province]|filter(v => v is not empty and v|trim != '')|join(', ') }}{% if registration.permanentZip %} {{ registration.permanentZip }}{% endif %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    {# Parents / Family Background Card (Includes Siblings Subsection) #}
                    <div class="bg-white rounded-2xl p-6 shadow-xs border border-gray-200/80">
                        <div class="flex items-center gap-2.5 mb-5 pb-3 border-b border-gray-100">
                            <div class="w-8 h-8 rounded-lg bg-feu-green-50 text-feu-green-700 flex items-center justify-center text-sm border border-feu-green-100 flex-shrink-0">
                                <i class="ki-filled ki-people text-base"></i>
                            </div>
                            <h3 class="text-lg font-bold text-gray-900">Family Background</h3>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            {% for guardian in registration.guardians %}
                                {% set gType = guardian.guardianType|default(guardian.relationship|upper in ['FATHER', 'MOTHER'] ? guardian.relationship|upper : 'GUARDIAN') %}
                                {% if gType in ['FATHER', 'MOTHER'] %}
                                    <div class="p-5 rounded-2xl bg-white border border-gray-200/80 shadow-xs border-t-4 border-t-feu-gold-500 relative flex flex-col justify-between">
                                        <div>
                                            <div class="flex justify-between items-start mb-2">
                                                <span class="px-2.5 py-1 rounded-lg text-xs font-black uppercase tracking-wider bg-feu-gold-50 text-feu-gold-800 border border-feu-gold-200/60">
                                                    {{ guardian.relationship }}
                                                </span>
                                                <div class="flex gap-1.5">
                                                    {% if guardian.deceased %}
                                                        <span class="px-2.5 py-0.5 rounded-full bg-red-100 text-red-700 text-[11px] font-bold uppercase tracking-wider">Deceased</span>
                                                    {% endif %}
                                                    {% if guardian.OFW %}
                                                        <span class="px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-700 text-[11px] font-bold uppercase tracking-wider">OFW</span>
                                                    {% endif %}
                                                </div>
                                            </div>
                                            {% set rawParentName = guardian.parentName|default('')|trim(', ') %}
                                            {% if ',' in rawParentName %}
                                                {% set pParts = rawParentName|split(',') %}
                                                {% set displayParentName = (pParts[1]|trim ~ ' ' ~ pParts[0]|trim)|trim %}
                                            {% else %}
                                                {% set displayParentName = rawParentName %}
                                            {% endif %}
                                            <div class="text-base font-bold text-gray-900 mt-1.5">{{ displayParentName }}</div>
                                            <div class="text-xs text-gray-500 font-semibold mt-0.5">Nationality: {{ guardian.nationality|default('FILIPINO') }}</div>
                                            <div class="text-sm {{ guardian.occupation ? 'text-gray-700 font-semibold' : 'text-gray-400 italic' }} mt-2 flex items-center gap-1.5">
                                                <i class="ki-filled ki-briefcase text-xs text-feu-green-600"></i>
                                                <span>{{ guardian.occupation ?: 'Occupation Not Specified' }}</span>
                                            </div>
                                            <div class="text-sm text-gray-700 mt-1 flex items-center gap-1.5">
                                                <i class="ki-filled ki-phone text-xs text-feu-green-600"></i>
                                                <span>{{ guardian.contactNo ?: 'No Contact Provided' }}</span>
                                            </div>
                                        </div>

                                        {% if not guardian.deceased %}
                                            {% if guardian.OFW %}
                                                <div class="mt-3.5 pt-3 border-t border-gray-100 text-xs space-y-2">
                                                    <div>
                                                        <span class="font-bold text-gray-700 flex items-center gap-1 text-xs">
                                                            <i class="ki-filled ki-briefcase text-xs text-blue-600"></i> Workplace Address:
                                                        </span>
                                                        <span class="text-gray-600 block pl-4 text-xs mt-0.5">
                                                            {{ guardian.currentAddress }}{% if guardian.ofwCountry %}, {{ guardian.ofwCountry }}{% endif %}{% if guardian.currentZip %} ({{ guardian.currentZip }}){% endif %}
                                                        </span>
                                                    </div>
                                                    <div>
                                                        <span class="font-bold text-gray-700 flex items-center gap-1 text-xs">
                                                            <i class="ki-filled ki-home text-xs text-feu-green-600"></i> Permanent Address:
                                                        </span>
                                                        <span class="text-gray-600 block pl-4 text-xs mt-0.5">
                                                            {% if guardian.permanentCountry %}
                                                                {{ guardian.permanentAddress }}{% if guardian.permanentCountry %}, {{ guardian.permanentCountry }}{% endif %}{% if guardian.permanentZip %} ({{ guardian.permanentZip }}){% endif %}
                                                            {% elseif guardian.permanentCity or guardian.permanentProvince %}
                                                                {{ guardian.permanentAddress }}{% if guardian.permanentBarangay %}, {{ guardian.permanentBarangay|location_barangay }}{% endif %}{% if guardian.permanentCity %}, {{ guardian.permanentCity|location_city }}{% endif %}{% if guardian.permanentProvince %}, {{ guardian.permanentProvince|location_province }}{% endif %}{% if guardian.permanentZip %} {{ guardian.permanentZip }}{% endif %}
                                                            {% elseif guardian.permanentAddress %}
                                                                {{ guardian.permanentAddress }}{% if guardian.permanentZip %} ({{ guardian.permanentZip }}){% endif %}
                                                            {% else %}
                                                                <span class="italic text-gray-400">Same as workplace address</span>
                                                            {% endif %}
                                                        </span>
                                                    </div>
                                                </div>
                                            {% else %}
                                                {# Complete Address Fallback Resolution #}
                                                {% set pAddress = guardian.currentAddress ?: (guardian.sameAsApplicant ? registration.currentAddress : '') %}
                                                {% set pBarangay = guardian.currentBarangay ?: (guardian.sameAsApplicant ? registration.currentBarangay : '') %}
                                                {% set pCity = guardian.currentCity ?: (guardian.sameAsApplicant ? registration.currentCity : '') %}
                                                {% set pProvince = guardian.currentProvince ?: (guardian.sameAsApplicant ? registration.currentProvince : '') %}
                                                {% set pZip = guardian.currentZip ?: (guardian.sameAsApplicant ? registration.currentZip : '') %}
                                                {% set pFullLoc = [pBarangay|location_barangay, pCity|location_city, pProvince|location_province]|filter(v => v is not empty and v|trim != '')|join(', ') %}

                                                {% if pAddress or pCity %}
                                                    <div class="mt-3.5 pt-3 border-t border-gray-100 text-xs text-gray-600 flex items-start gap-1.5">
                                                        <i class="ki-filled ki-geolocation text-sm text-feu-green-600 flex-shrink-0 mt-0.5"></i>
                                                        <div>
                                                            <span class="font-bold text-gray-800 text-xs block leading-snug">{{ pAddress }}</span>
                                                            <span class="text-xs text-gray-500">{{ pFullLoc }}{% if pZip %} {{ pZip }}{% endif %}</span>
                                                        </div>
                                                    </div>
                                                {% endif %}
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>

                        {# Siblings Subsection (Nested Inside Family Background) #}
                        <div class="mt-6 pt-5 border-t border-gray-200/80">
                            <div class="flex items-center gap-2 mb-3">
                                <i class="ki-filled ki-profile-user text-feu-green-600 text-base"></i>
                                <h4 class="text-sm font-bold text-gray-800 uppercase tracking-wider">Siblings (Enrolled in FEU)</h4>
                            </div>
                            {% if registration.siblings|length > 0 %}
                                <div class="space-y-2">
                                    {% for sibling in registration.siblings %}
                                        <div class="flex flex-wrap items-center justify-between gap-3 p-3.5 rounded-xl bg-gray-50/70 border border-gray-200/70 shadow-2xs">
                                            <div>
                                                <span class="text-sm font-bold text-gray-900 block">{{ sibling.siblingName }}</span>
                                                <span class="text-xs text-gray-500">{{ sibling.school }}</span>
                                            </div>
                                            <div>
                                                {% if sibling.feuStudentNo %}
                                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                                                        <i class="ki-filled ki-verify text-xs"></i> FEU ID: {{ sibling.feuStudentNo }}
                                                    </span>
                                                {% else %}
                                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                                                        <i class="ki-filled ki-verify text-xs"></i> FEU Student
                                                    </span>
                                                {% endif %}
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <p class="text-xs text-gray-400 italic">No siblings enrolled in FEU.</p>
                            {% endif %}
                        </div>
                    </div>
                </div>

                {# --- 3. SIDEBAR GRID (Right Column 4-Cols) --- #}
                <div class="col-span-12 lg:col-span-4 space-y-6">
                    {# Education History Card #}
                    <div class="bg-white rounded-2xl p-6 shadow-xs border border-gray-200/80">
                        <div class="flex items-center gap-2.5 mb-4 pb-3 border-b border-gray-100">
                            <div class="w-8 h-8 rounded-lg bg-feu-green-50 text-feu-green-700 flex items-center justify-center text-sm border border-feu-green-100 flex-shrink-0">
                                <i class="ki-filled ki-teacher text-base"></i>
                            </div>
                            <h3 class="text-lg font-bold text-gray-900">Education History</h3>
                        </div>

                        {% if registration.lastGradeCompleted or registration.generalAverage is not null %}
                            <div class="grid grid-cols-2 gap-3 mb-4 p-3.5 bg-gray-50/80 rounded-xl border border-gray-200/60 shadow-2xs">
                                <div>
                                    <div class="text-xs text-gray-500 font-bold uppercase tracking-wider">Last Grade Completed</div>
                                    <div class="font-bold text-gray-900 text-sm mt-1">{{ registration.lastGradeCompleted|default('N/A') }}</div>
                                </div>
                                <div>
                                    <div class="text-xs text-gray-500 font-bold uppercase tracking-wider">General Average</div>
                                    <div class="font-extrabold text-feu-green-700 text-sm mt-1">
                                        {% if registration.generalAverage is not null and registration.generalAverage != '' %}
                                            {% if registration.generalAverage matches '/^[0-9]+(\\.[0-9]+)?$/' %}
                                                {{ registration.generalAverage|number_format(2) }}
                                            {% else %}
                                                {{ registration.generalAverage }}
                                            {% endif %}
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        <div class="space-y-4">
                            {% set levelMap = {'P': 'Elementary', 'I': 'Junior High', 'S': 'Senior High', 'E': 'Elementary', 'K': 'Kindergarten'} %}
                            {% for school in registration.schools %}
                                {% set sYear = school.schoolYear %}
                                {% if sYear|length == 4 %}
                                    {% set sYear = (sYear - 1) ~ '-' ~ sYear %}
                                {% endif %}
                                <div class="relative pl-4 border-l-2 border-feu-green-200">
                                    <span class="absolute top-1 -left-[5px] w-2 h-2 rounded-full bg-feu-green-600 ring-2 ring-white"></span>
                                    <div class="text-xs font-extrabold text-feu-green-700 uppercase tracking-wider mb-0.5">
                                        {{ levelMap[school.level]|default(school.level) }}
                                    </div>
                                    <div class="text-[15px] font-bold text-gray-900 leading-snug">{{ school.school }}</div>
                                    <div class="text-xs text-gray-600 mt-0.5">School Year: <span class="font-semibold text-gray-800">{{ sYear }}</span></div>
                                    {% if school.schoolType %}
                                        <div class="text-xs text-gray-500 mt-0.5 font-medium">{{ school.schoolType }}</div>
                                    {% endif %}
                                    {% if school.isInternational %}
                                        {% if school.addressLine %}
                                            <div class="text-xs text-gray-700 mt-0.5 flex items-center gap-1"><i class="ki-filled ki-map text-gray-400"></i> {{ school.addressLine }}</div>
                                        {% endif %}
                                        <div class="text-xs text-gray-500 mt-0.5 flex items-center gap-1"><i class="ki-filled ki-geolocation text-gray-400"></i> {{ school.country }}</div>
                                    {% else %}
                                        {% if school.addressLine %}
                                            <div class="text-xs text-gray-700 mt-0.5 flex items-center gap-1"><i class="ki-filled ki-map text-gray-400"></i> {{ school.addressLine }}</div>
                                        {% endif %}
                                        {% if school.region or school.province or school.city %}
                                            <div class="text-xs text-gray-500 mt-0.5 flex items-center gap-1"><i class="ki-filled ki-geolocation text-gray-400"></i> {{ school.city|location_city }}, {{ school.province|location_province }}, {{ school.region|location_region }}</div>
                                        {% endif %}
                                    {% endif %}
                                </div>
                            {% else %}
                                <div class="text-sm text-gray-400 italic">No history provided.</div>
                            {% endfor %}
                        </div>
                    </div>

                    {# Submitted Files Card #}
                    <div class="bg-white rounded-2xl p-6 shadow-xs border border-gray-200/80">
                        <div class="flex items-center gap-2.5 mb-4 pb-3 border-b border-gray-100">
                            <div class="w-8 h-8 rounded-lg bg-feu-green-50 text-feu-green-700 flex items-center justify-center text-sm border border-feu-green-100 flex-shrink-0">
                                <i class="ki-filled ki-folder-added text-base"></i>
                            </div>
                            <h3 class="text-lg font-bold text-gray-900">Submitted Files</h3>
                        </div>

                        {# Promissory Notice Banner (Read-Only) #}
                        {% if registration.documentsAgreedDate %}
                            <div class="mb-4 p-3.5 rounded-xl bg-amber-50/80 border border-amber-200/80 shadow-2xs">
                                <div class="flex items-center justify-between gap-2">
                                    <span class="text-xs font-bold uppercase tracking-wider text-amber-900 flex items-center gap-1.5">
                                        <i class="ki-filled ki-calendar text-amber-600 text-sm"></i> Promissory Deadline
                                    </span>
                                    <span class="text-xs font-black text-amber-950 bg-white/90 px-2 py-0.5 rounded-md border border-amber-200/60 shadow-2xs">
                                        {{ registration.documentsAgreedDate|date('M d, Y') }}
                                    </span>
                                </div>
                                <p class="text-xs text-amber-800/80 mt-1 leading-relaxed">
                                    Applicant promised to submit pending documents on or before this date.
                                </p>
                            </div>
                        {% endif %}

                        <div class="space-y-3">
                            {# 2x2 ID Picture Compliance #}
                            {% if registration.photoSlug %}
                                <a href="{{ asset(registration.photoSlug) }}" target="_blank" class="flex items-center gap-3 p-3 rounded-xl border border-gray-100 hover:bg-gray-50 hover:border-feu-green-200 transition-all group">
                                    <div class="flex-shrink-0">
                                        <img src="{{ asset(registration.photoSlug) }}" class="w-9 h-9 rounded-lg object-cover border border-gray-200" alt="2x2 Photo">
                                    </div>
                                    <div class="overflow-hidden">
                                        <div class="text-sm font-bold text-gray-900 truncate">2x2 ID Picture of the Applicant</div>
                                        <div class="text-xs text-emerald-600 font-semibold flex items-center gap-1 mt-0.5">
                                            <i class="ki-filled ki-check-circle text-xs"></i> Documents Complied / Submitted
                                        </div>
                                    </div>
                                </a>
                            {% else %}
                                <div class="flex items-center gap-3 p-3 rounded-xl border border-red-100 bg-red-50/30">
                                    <div class="flex-shrink-0 w-9 h-9 rounded-lg bg-red-100 text-red-500 flex items-center justify-center">
                                        <i class="ki-filled ki-picture text-base"></i>
                                    </div>
                                    <div class="overflow-hidden">
                                        <div class="text-sm font-bold text-red-900 truncate">2x2 ID Picture of the Applicant</div>
                                        <div class="text-xs text-red-600 font-bold uppercase mt-0.5">Missing / Not Complied (Promissory)</div>
                                    </div>
                                </div>
                            {% endif %}

                            {# Dynamic Requirement Rows #}
                            {% for setup in documentSetups %}
                                {% set req = null %}
                                {% for r in registration.requirements %}
                                    {% if r.Slug|lower == setup.slug|lower and not r.isDeleted %}
                                        {% set req = r %}
                                    {% endif %}
                                {% endfor %}

                                {% if req and req.status == 'W' %}
                                    <div class="flex items-center justify-between gap-2 p-3 rounded-xl border border-amber-200 bg-amber-50/40">
                                        <div class="flex items-center gap-3 min-w-0 flex-1">
                                            <div class="flex-shrink-0 w-9 h-9 rounded-lg bg-amber-100 text-amber-600 flex items-center justify-center font-bold text-xs">
                                                <i class="ki-filled ki-shield-cross text-base"></i>
                                            </div>
                                            <div class="min-w-0 flex-1">
                                                <div class="text-sm font-bold text-gray-900 truncate">{{ req.requirement }}</div>
                                                <div class="text-xs text-amber-800 font-bold uppercase flex items-center gap-1 whitespace-nowrap mt-0.5">
                                                    <i class="ki-filled ki-verify text-xs flex-shrink-0"></i>
                                                    <span>Waived by Admin</span>
                                                </div>
                                            </div>
                                        </div>
                                        <form method="POST" action="{{ path('app_admin_alabang_registration_doc_unwaive', {id: registration.studentNumber, slug: req.slug}) }}" class="m-0 flex-shrink-0" onsubmit="return confirm('Remove waiver and restore this requirement?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('unwaive_doc_' ~ registration.studentNumber ~ '_' ~ req.slug) }}">
                                            <button type="submit" class="btn btn-xs btn-light-secondary text-gray-600 hover:text-red-600 text-xs font-bold px-3 py-1.5 rounded-lg border border-gray-200 shadow-2xs hover:bg-white transition-all flex items-center gap-1 whitespace-nowrap" title="Cancel waiver">
                                                <i class="ki-filled ki-cross text-xs"></i> Unwaive
                                            </button>
                                        </form>
                                    </div>
                                {% elseif req and req.status == 'S' %}
                                    <div class="flex items-center justify-between gap-2 p-3 rounded-xl border border-gray-100 hover:bg-gray-50 hover:border-feu-green-200 transition-all group">
                                        {% if req.storedFileName %}
                                            <a href="{{ asset(req.storedFileName) }}" target="_blank" class="flex items-center gap-3 min-w-0 flex-1">
                                                <div class="flex-shrink-0">
                                                    <img src="{{ asset('metronic/media/file-types/pdf.svg') }}" class="w-9 h-9" alt="PDF">
                                                </div>
                                                <div class="min-w-0 flex-1">
                                                    <div class="text-sm font-bold text-gray-900 truncate">{{ req.requirement }}</div>
                                                    <div class="text-xs text-gray-500 whitespace-nowrap mt-0.5">
                                                        Submitted {% if req.dateSubmitted %}• {{ req.dateSubmitted|date('M d, Y') }}{% endif %}
                                                    </div>
                                                </div>
                                            </a>
                                        {% else %}
                                            <div class="flex items-center gap-3 min-w-0 flex-1">
                                                <div class="flex-shrink-0">
                                                    <img src="{{ asset('metronic/media/file-types/pdf.svg') }}" class="w-9 h-9" alt="PDF">
                                                </div>
                                                <div class="min-w-0 flex-1">
                                                    <div class="text-sm font-bold text-gray-900 truncate">{{ req.requirement }}</div>
                                                    <div class="text-xs text-gray-500 whitespace-nowrap mt-0.5">
                                                        Submitted {% if req.dateSubmitted %}• {{ req.dateSubmitted|date('M d, Y') }}{% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                        {% endif %}
                                    </div>
                                {% else %}
                                    <div class="flex items-center justify-between gap-2 p-3 rounded-xl border border-red-100 bg-red-50/30">
                                        <div class="flex items-center gap-3 min-w-0 flex-1">
                                            <div class="flex-shrink-0">
                                                <img src="{{ asset('metronic/media/file-types/pdf.svg') }}" class="w-9 h-9 opacity-25 grayscale" alt="PDF">
                                            </div>
                                            <div class="min-w-0 flex-1">
                                                <div class="text-sm font-bold text-red-900 truncate">{{ setup.documentName }}</div>
                                                <div class="text-xs text-red-600 font-bold uppercase whitespace-nowrap mt-0.5">Missing / Not Submitted</div>
                                            </div>
                                        </div>
                                        <form method="POST" action="{{ path('app_admin_alabang_registration_doc_waive', {id: registration.studentNumber, slug: setup.slug}) }}" class="m-0 flex-shrink-0" onsubmit="return confirm('Are you sure you want to officially waive this requirement for this applicant?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('waive_doc_' ~ registration.studentNumber ~ '_' ~ setup.slug) }}">
                                            <button type="submit" class="btn btn-xs btn-light-warning text-amber-800 hover:bg-amber-100 font-bold text-xs px-3 py-1.5 rounded-lg border border-amber-300/80 shadow-2xs transition-all flex items-center gap-1 whitespace-nowrap" title="Waive requirement">
                                                <i class="ki-filled ki-shield-cross text-xs"></i> Waive
                                            </button>
                                        </form>
                                    </div>
                                {% endif %}
                            {% endfor %}

                            {% if documentSetups|length == 0 %}
                                <div class="text-center py-6 text-gray-400 text-xs italic">No document requirements for this student type.</div>
                            {% endif %}
                        </div>
                    </div>

                    {# General Information Card #}
                    <div class="bg-white rounded-2xl p-6 shadow-xs border border-gray-200/80">
                        <div class="flex items-center gap-2.5 mb-4 pb-3 border-b border-gray-100">
                            <div class="w-8 h-8 rounded-lg bg-feu-green-50 text-feu-green-700 flex items-center justify-center text-sm border border-feu-green-100 flex-shrink-0">
                                <i class="ki-filled ki-information-2 text-base"></i>
                            </div>
                            <h3 class="text-lg font-bold text-gray-900">General Information</h3>
                        </div>
                        <div class="space-y-3">
                            <div class="flex justify-between items-center text-sm">
                                <span class="text-gray-500 font-semibold uppercase tracking-wider text-xs">Applied On</span>
                                <span class="font-bold text-gray-900">{{ registration.createdAt|date('M d, Y') }}</span>
                            </div>
                            <div class="flex justify-between items-center text-sm">
                                <span class="text-gray-500 font-semibold uppercase tracking-wider text-xs">School Year</span>
                                <span class="px-2.5 py-0.5 rounded font-bold bg-gray-100 text-gray-900 border border-gray-200/60 font-mono text-xs">{{ registration.schoolYearOfEntry }}</span>
                            </div>
                            <div class="flex justify-between items-start text-sm pt-2 border-t border-gray-100">
                                <span class="text-gray-500 font-semibold uppercase tracking-wider text-xs pt-1">Source</span>
                                <div class="text-right">
                                    {% if registration.marketingSource %}
                                        <div class="flex flex-wrap justify-end gap-1">
                                            {% for src in registration.marketingSource|split(', ') %}
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
                                                    {{ src }}
                                                </span>
                                            {% endfor %}
                                        </div>
                                    {% else %}
                                        <span class="font-medium text-gray-400">N/A</span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Emergency Contact Card #}
                    {% set emergencyContact = null %}
                    {% for guardian in registration.guardians %}
                        {% set gType = guardian.guardianType|default(guardian.relationship|upper in ['FATHER', 'MOTHER'] ? guardian.relationship|upper : 'GUARDIAN') %}
                        {% if gType == 'GUARDIAN' %}
                            {% set emergencyContact = guardian %}
                        {% endif %}
                    {% endfor %}

                    <div class="bg-white rounded-2xl p-6 shadow-xs border border-gray-200/80">
                        <div class="flex items-center gap-2.5 mb-4 pb-3 border-b border-gray-100">
                            <div class="w-8 h-8 rounded-lg bg-orange-50 text-orange-600 flex items-center justify-center text-sm border border-orange-100 flex-shrink-0">
                                <i class="ki-filled ki-phone text-base"></i>
                            </div>
                            <h3 class="text-lg font-bold text-gray-900">Emergency Contact</h3>
                        </div>
                        
                        {% if emergencyContact %}
                            <div class="p-4 rounded-xl border bg-orange-50/50 border-orange-100 relative">
                                <div class="flex justify-between items-start mb-2">
                                    <span class="px-2 py-0.5 rounded text-xs font-black uppercase tracking-wider bg-orange-100 text-orange-700">
                                        {{ emergencyContact.relationship }}
                                    </span>
                                    {% if emergencyContact.sameAsApplicant is defined and emergencyContact.sameAsApplicant %}
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-700 text-xs font-bold">
                                            <i class="ki-filled ki-check-circle text-xs"></i> Same as Applicant
                                        </span>
                                    {% endif %}
                                </div>
                                {% set rawEmergName = emergencyContact.parentName|default('')|trim(', ') %}
                                {% if ',' in rawEmergName %}
                                    {% set eParts = rawEmergName|split(',') %}
                                    {% set displayEmergName = (eParts[1]|trim ~ ' ' ~ eParts[0]|trim)|trim %}
                                {% else %}
                                    {% set displayEmergName = rawEmergName %}
                                {% endif %}
                                <div class="font-bold text-gray-900 text-base">{{ displayEmergName }}</div>
                                <div class="text-sm {{ emergencyContact.occupation ? 'text-gray-700 font-semibold' : 'text-gray-400 italic' }} mt-1.5 flex items-center gap-1.5">
                                    <i class="ki-filled ki-briefcase text-xs text-orange-400"></i>
                                    <span>{{ emergencyContact.occupation ?: 'Occupation Not Specified' }}</span>
                                </div>
                                <div class="text-sm text-gray-700 mt-1 flex items-center gap-1.5">
                                    <i class="ki-filled ki-phone text-xs text-orange-400"></i>
                                    <span>{{ emergencyContact.contactNo ?: 'No Contact Provided' }}</span>
                                </div>
                                <div class="text-sm text-gray-700 mt-1 flex items-center gap-1.5">
                                    <i class="ki-filled ki-sms text-xs text-orange-400"></i>
                                    <span>{{ emergencyContact.email ?: 'No Email Provided' }}</span>
                                </div>
                                {% if emergencyContact.currentAddress or emergencyContact.currentCity %}
                                    <div class="text-xs text-gray-600 mt-2.5 pt-2 border-t border-orange-200/60 flex items-start gap-1">
                                        <i class="ki-filled ki-map text-xs mr-1 text-orange-400 flex-shrink-0 mt-0.5"></i>
                                        <span>{{ emergencyContact.currentAddress }}{% if emergencyContact.currentBarangay %}, {{ emergencyContact.currentBarangay }}{% endif %}{% if emergencyContact.currentCity %}, {{ emergencyContact.currentCity }}{% endif %}{% if emergencyContact.currentProvince %}, {{ emergencyContact.currentProvince }}{% endif %} {{ emergencyContact.currentZip }}</span>
                                    </div>
                                {% endif %}
                            </div>
                        {% else %}
                            <div class="p-4 rounded-xl border bg-gray-50 border-gray-100 text-center">
                                <p class="text-xs text-gray-400 italic font-medium">No Emergency Contact provided.</p>
                            </div>
                        {% endif %}
                    </div>

                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}
