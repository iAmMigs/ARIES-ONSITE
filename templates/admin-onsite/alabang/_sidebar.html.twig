{# templates/admin-onsite/alabang/_sidebar.html.twig #}
<aside class="w-[280px] bg-feu-green-900 text-white flex flex-col flex-shrink-0 transition-all duration-300 z-50">
    <div class="h-20 flex items-center gap-3 px-6 bg-feu-green-800/50">
        <i class="ki-filled ki-abstract-26 text-3xl text-feu-gold-400"></i>
        <div>
            <h1 class="text-2xl font-bold tracking-tight">ARIES</h1>
            <p class="text-xs text-feu-green-200 uppercase tracking-wider">Alabang Admin</p>
        </div>
    </div>
    
    <nav class="flex-1 px-4 py-6 space-y-1 overflow-y-auto">
        {# Dashboard Link #}
        <a href="{{ path('app_admin_alabang_dashboard') }}" 
           class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all {{ active_menu|default('') == 'dashboard' ? 'bg-feu-gold-500 text-feu-green-900 font-bold shadow-lg shadow-feu-gold-500/20' : 'text-feu-green-100 hover:bg-feu-green-800' }}">
            <i class="ki-filled ki-chart-pie-simple text-xl"></i><span>Dashboard</span>
        </a>
        
        {# Registrations Link #}
        <a href="{{ path('app_admin_alabang_registrations') }}" 
           class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all {{ active_menu|default('') == 'registrations' ? 'bg-feu-gold-500 text-feu-green-900 font-bold shadow-lg shadow-feu-gold-500/20' : 'text-feu-green-100 hover:bg-feu-green-800' }}">
            <i class="ki-filled ki-people text-xl"></i><span>Registrations</span>
        </a>
        
        {# Document Setup Link #}
        <a href="{{ path('app_admin_alabang_documents') }}" 
           class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all {{ active_menu|default('') == 'documents' ? 'bg-feu-gold-500 text-feu-green-900 font-bold shadow-lg shadow-feu-gold-500/20' : 'text-feu-green-100 hover:bg-feu-green-800' }}">
            <i class="ki-filled ki-folder text-xl"></i><span>Document Setup</span>
        </a>

        {# School Year Management Link #}
        <a href="{{ path('app_admin_school_year_index', {campus: 'alabang'}) }}" 
           class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all {{ active_menu|default('') == 'school_year' ? 'bg-feu-gold-500 text-feu-green-900 font-bold shadow-lg shadow-feu-gold-500/20' : 'text-feu-green-100 hover:bg-feu-green-800' }}">
            <i class="ki-filled ki-calendar text-xl"></i><span>School Year</span>
        </a>
    </nav>
    
    <div class="p-4 border-t border-feu-green-800">
        <a href="{{ path('app_logout') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl text-red-300 hover:bg-red-900/20 transition-all">
            <i class="ki-filled ki-exit-right text-xl"></i><span>Sign Out</span>
        </a>
    </div>
</aside>