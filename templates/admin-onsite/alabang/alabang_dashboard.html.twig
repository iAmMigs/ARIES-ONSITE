{# templates/admin/dashboard.html.twig #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARIES Admin | Registration Management</title>
    <link href="{{ asset('metronic/vendors/keenicons/styles.bundle.css') }}" rel="stylesheet"/>
    <link rel="stylesheet" href="{{ asset('css/variables.css') }}">
    <link rel="stylesheet" href="{{ asset('css/base.css') }}">
    <link rel="stylesheet" href="{{ asset('css/pages/admin.css') }}">

    <link rel="shortcut icon" href="{{ asset('metronic/media/app/favicon.ico') }}"/>
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('metronic/media/app/apple-touch-icon.png') }}"/>
    <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('metronic/media/app/favicon-32x32.png') }}"/>
    <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('metronic/media/app/favicon-16x16.png') }}"/>
</head>
<body>

<div class="admin-container" id="adminContainer">
    {# ... Sidebar code remains the same ... #}
    <aside class="admin-sidebar">
        {# (Sidebar content omitted for brevity, stick with your previous code) #}
        <div class="sidebar-header">
            <div class="sidebar-logo">
                <div class="logo-icon"><i class="ki-filled ki-abstract-26"></i></div>
                <div class="logo-text"><h2>ARIES</h2><p>Alabang - Admin Console</p></div>
            </div>
            <button class="btn-toggle-sidebar" id="sidebarToggle"><i class="ki-filled ki-double-left"></i></button>
        </div>
        <nav class="sidebar-nav">
            <a href="{{ path('app_admin_alabang_dashboard') }}" class="nav-item active"><i class="ki-filled ki-people"></i><span>Registrations</span></a>
        </nav>
    </aside>

    <main class="admin-main">
        <header class="admin-header">
            <h1 class="page-title">
                Showing 
                {% if current_filter %}
                    {{ current_filter }} Applicants
                {% else %}
                    All Applicants
                {% endif %}
            </h1>
            
            <div class="header-actions">
                <form method="get" action="{{ path('app_admin_alabang_dashboard') }}" class="filter-form">
                    <div class="filter-wrapper">
                        <i class="ki-filled ki-filter"></i>
                        <select name="grade" onchange="this.form.submit()" class="form-select-sm">
                            <option value="">All Levels</option>
                            {% for grade in available_grades %}
                                <option value="{{ grade }}" {{ current_filter == grade ? 'selected' : '' }}>
                                    {{ grade }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </form>

                <form method="get" action="{{ path('app_admin_alabang_dashboard') }}" class="filter-form">
                    <div class="filter-wrapper">
                        <i class="ki-filled ki-calendar"></i>
                        <select name="date" onchange="this.form.submit()" class="form-select-sm">
                            <option value="">All Dates</option>
                        </select>
                    </div>
                </form>

                <div class="search-box">
                    <i class="ki-filled ki-magnifier"></i>
                    <input type="text" placeholder="Search student...">
                </div>
                <div class="admin-profile">
                    <img src="{{ asset('metronic/media/avatars/300-1.png') }}" alt="Admin">
                </div>
            </div>
        </header>

        <div class="admin-content">
            <div class="table-card">
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th class="col-img">Photo</th>
                                <th>Student ID</th>
                                <th>Full Name</th>
                                <th>Level / Strand</th>
                                <th>Status</th>
                                <th>Date Applied</th>
                                <th class="col-action">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for reg in registrations %}
                            <tr>
                                <td class="col-img">
                                    <div class="student-avatar">
                                        <img src="{{ asset('metronic/media/avatars/' ~ reg.avatar) }}" alt="Photo">
                                    </div>
                                </td>
                                <td><span class="text-mono">{{ reg.student_id }}</span></td>
                                <td>
                                    <div class="student-info">
                                        <strong>{{ reg.name }}</strong>
                                        <small>{{ reg.email }}</small>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge badge-outline">{{ reg.grade }}</span>
                                    {% if reg.track %}
                                        <span class="badge badge-primary">{{ reg.track }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% set statusClass = reg.status == 'Enrolled' ? 'status-verified' : 'status-pending' %}
                                    <span class="status {{ statusClass }}">{{ reg.status }}</span>
                                </td>
                                <td>{{ reg.date }}</td>
                                <td class="col-action">
                                    <a href="{{ path('app_admin_alabang_registration_view', {'id': reg.id}) }}" class="btn-icon btn-edit" title="View">
                                        <i class="ki-filled ki-eye"></i>
                                    </a>
                                    
                                    <a href="{{ path('app_admin_alabang_registration_edit', {'id': reg.id}) }}" class="btn-icon btn-edit" title="Edit">
                                        <i class="ki-filled ki-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="7" style="text-align:center; padding: 2rem;">No applicants found for this level.</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>

<script>
    const toggleBtn = document.getElementById('sidebarToggle');
    const container = document.getElementById('adminContainer');
    if(toggleBtn){
        toggleBtn.addEventListener('click', () => {
            container.classList.toggle('sidebar-collapsed');
            const icon = toggleBtn.querySelector('i');
            if(container.classList.contains('sidebar-collapsed')) {
                icon.classList.remove('ki-double-left'); icon.classList.add('ki-double-right');
            } else {
                icon.classList.remove('ki-double-right'); icon.classList.add('ki-double-left');
            }
        });
    }
</script>
</body>
</html>