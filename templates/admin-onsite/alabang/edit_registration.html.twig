{% extends 'base.html.twig' %}

{% block title %}Edit Registration{% endblock %}

{% block body %}
<div class="bg-gray-100 min-h-screen p-8 pb-24">
    <form method="post" id="editForm">
        {# Header #}
        <div class="max-w-5xl mx-auto mb-6 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <a href="{{ path('app_admin_alabang_registrations') }}" class="w-10 h-10 bg-white border border-gray-200 rounded-xl flex items-center justify-center text-gray-600 hover:text-feu-green-700 hover:border-feu-green-600 transition-all shadow-sm">
                    <i class="ki-filled ki-arrow-left"></i>
                </a>
                <h1 class="text-2xl font-bold text-gray-800">Edit Registration</h1>
            </div>
        </div>

        <div class="max-w-5xl mx-auto space-y-6">
            {# --- LOCKED FIELDS CARD --- #}
            <div class="bg-gray-50 rounded-2xl p-6 border border-gray-200 opacity-80">
                <h3 class="text-sm font-bold text-gray-500 uppercase mb-4 flex items-center gap-2">
                    <i class="ki-filled ki-lock-2"></i> Locked System Identifiers
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-bold text-gray-400 uppercase mb-1">AdCon Number</label>
                        <input type="text" value="{{ registration.adCon }}" class="w-full bg-gray-200 border-gray-300 text-gray-500 rounded-lg cursor-not-allowed font-mono" disabled>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-400 uppercase mb-1">Student ID</label>
                        <input type="text" value="{{ registration.studentNumber }}" class="w-full bg-gray-200 border-gray-300 text-gray-500 rounded-lg cursor-not-allowed font-mono" disabled>
                    </div>
                </div>
            </div>

            {# --- EDITABLE ACADEMIC INFO --- #}
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-200">
                <h3 class="text-lg font-bold text-feu-green-700 mb-6 flex items-center gap-2"><i class="ki-filled ki-book-open"></i> Academic Information</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Status</label>
                        <select name="status" class="w-full border-gray-300 rounded-lg focus:ring-feu-green-500 focus:border-feu-green-500">
                            {% for s in ['Pending', 'Enrolled', 'Dropped'] %}
                                <option value="{{ s }}" {{ registration.admissionStatus == s ? 'selected' }}>{{ s }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Grade Level</label>
                        <select name="grade" class="w-full border-gray-300 rounded-lg focus:ring-feu-green-500 focus:border-feu-green-500">
                            {% for g in ['Kinder','Grade 1','Grade 12'] %}
                                <option value="{{ g }}" {{ registration.gradeLevel == g ? 'selected' }}>{{ g }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Strand</label>
                        <select name="track" class="w-full border-gray-300 rounded-lg focus:ring-feu-green-500 focus:border-feu-green-500">
                            <option value="">None</option>
                            {% for t in ['STEM', 'ABM', 'HUMSS'] %}
                                <option value="{{ t }}" {{ registration.trackStrand == t ? 'selected' }}>{{ t }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
            </div>

            {# --- EDITABLE PERSONAL INFO --- #}
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-200">
                <h3 class="text-lg font-bold text-feu-green-700 mb-6 flex items-center gap-2"><i class="ki-filled ki-user"></i> Student Details</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div><label class="block text-xs font-bold text-gray-600 uppercase mb-1">First Name</label><input type="text" name="first_name" value="{{ registration.firstName }}" class="w-full border-gray-300 rounded-lg focus:border-feu-green-500"></div>
                    <div><label class="block text-xs font-bold text-gray-600 uppercase mb-1">Middle Name</label><input type="text" name="middle_name" value="{{ registration.middleName }}" class="w-full border-gray-300 rounded-lg focus:border-feu-green-500"></div>
                    <div><label class="block text-xs font-bold text-gray-600 uppercase mb-1">Last Name</label><input type="text" name="last_name" value="{{ registration.lastName }}" class="w-full border-gray-300 rounded-lg focus:border-feu-green-500"></div>
                    
                    <div><label class="block text-xs font-bold text-gray-600 uppercase mb-1">Gender</label><input type="text" name="gender" value="{{ registration.gender }}" class="w-full border-gray-300 rounded-lg focus:border-feu-green-500"></div>
                    <div class="col-span-2"><label class="block text-xs font-bold text-gray-600 uppercase mb-1">Email</label><input type="email" name="email" value="{{ registration.personalEmail }}" class="w-full border-gray-300 rounded-lg focus:border-feu-green-500"></div>
                </div>
            </div>
        </div>

        {# Floating Footer #}
        <div class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 p-4 z-50 shadow-[0_-4px_20px_rgba(0,0,0,0.05)]">
            <div class="max-w-5xl mx-auto flex justify-end gap-4">
                <a href="{{ path('app_admin_alabang_registrations') }}" class="px-6 py-2.5 rounded-xl border border-gray-300 text-gray-700 font-bold hover:bg-gray-50 transition-colors">Cancel</a>
                <button type="submit" class="btn-feu-primary px-8 py-2.5 rounded-xl font-bold shadow-lg shadow-feu-green-700/20">Save Changes</button>
            </div>
        </div>
    </form>
</div>
{% endblock %}