{% extends 'base.html.twig' %}

{% block title %}Edit Registration{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
{% endblock %}

{% block body %}
<div class="flex h-screen overflow-hidden bg-gray-50">

    {% include 'admin-onsite/alabang/_sidebar.html.twig' with {'active_menu': 'registrations'} %}

    <main class="flex-1 flex flex-col min-w-0 overflow-hidden">
        {% include 'admin-onsite/alabang/_header.html.twig' with {'page_title': 'Edit Student Details'} %}

        <div class="flex-1 overflow-y-auto p-8">
             <form method="post" class="max-w-7xl mx-auto" id="editForm" enctype="multipart/form-data">
        
                {# Header Actions #}
                <div class="mb-6 flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <a href="{{ path('app_admin_alabang_registrations') }}" id="btn_discard" class="w-10 h-10 bg-white border border-gray-200 rounded-xl flex items-center justify-center text-gray-600 hover:text-feu-green-700 hover:border-feu-green-600 transition-all shadow-sm">
                            <i class="ki-filled ki-arrow-left"></i>
                        </a>
                        <span class="text-gray-500 text-sm font-medium">Discard Changes</span>
                    </div>
                    <button type="submit" class="btn-feu-primary px-5 py-2.5 rounded-xl text-sm font-semibold shadow-lg shadow-feu-green-700/20">
                        <i class="ki-filled ki-check mr-2"></i> Save Changes
                    </button>
                </div>

                <div class="grid grid-cols-12 gap-6">
                    {# --- 1. APPLICANT CARD (Header) --- #}
                    <div class="col-span-12 bg-white rounded-2xl p-6 shadow-sm border border-gray-200 flex flex-col md:flex-row gap-8 items-start relative overflow-hidden">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-feu-gold-100 rounded-bl-full -mr-16 -mt-16 opacity-50 pointer-events-none"></div>
                        
                        {# Profile Picture (Editable) #}
                        <div class="flex-shrink-0 relative group">
                            <div class="w-40 h-40 rounded-2xl overflow-hidden border-4 border-white shadow-lg relative">
                                <img src="{{ registration.photoSlug ? asset(registration.photoSlug) : asset('metronic/media/avatars/blank.png') }}" class="w-full h-full object-cover">
                                
                                {# Hover Overlay for Upload #}
                                <label class="absolute inset-0 bg-black/50 flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer">
                                    <i class="ki-filled ki-pencil text-white text-2xl mb-1"></i>
                                    <span class="text-xs text-white font-bold uppercase">Change Photo</span>
                                    <input type="file" name="profile_picture" class="hidden" accept=".jpg,.jpeg,.png" onchange="previewImage(this)">
                                </label>
                            </div>
                        </div>

                        <div class="flex-grow pt-2 space-y-4">
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                                <div>
                                    <label class="text-xs text-gray-400 uppercase font-bold">Last Name</label>
                                    <input type="text" name="last_name" value="{{ registration.lastName }}" class="w-full font-bold text-gray-900 border border-gray-300 bg-gray-50 rounded px-3 py-2 focus:border-feu-green-600 focus:ring-1 focus:ring-feu-green-600 outline-none transition-colors" placeholder="Last Name">
                                </div>
                                <div>
                                    <label class="text-xs text-gray-400 uppercase font-bold">First Name</label>
                                    <input type="text" name="first_name" value="{{ registration.firstName }}" class="w-full font-bold text-gray-900 border border-gray-300 bg-gray-50 rounded px-3 py-2 focus:border-feu-green-600 focus:ring-1 focus:ring-feu-green-600 outline-none transition-colors" placeholder="First Name">
                                </div>
                                <div>
                                    <label class="text-xs text-gray-400 uppercase font-bold">Middle Name</label>
                                    <input type="text" name="middle_name" value="{{ registration.middleName }}" class="w-full font-bold text-gray-900 border border-gray-300 bg-gray-50 rounded px-3 py-2 focus:border-feu-green-600 focus:ring-1 focus:ring-feu-green-600 outline-none transition-colors" placeholder="Middle Name">
                                </div>
                            </div>
                            
                            <div class="flex flex-wrap gap-3">
                                <div class="px-3 py-1 rounded-lg bg-gray-100 text-gray-600 text-sm font-semibold border border-gray-200 cursor-not-allowed opacity-80">
                                    <span class="text-xs text-gray-400 uppercase mr-1">Student ID</span> {{ registration.studentNumber }}
                                </div>

                                <select name="admission_type" class="bg-purple-50 text-purple-700 text-sm font-semibold border border-purple-100 rounded-lg px-2 py-1">
                                    <option value="Freshman" {{ registration.admissionType == 'Freshman' ? 'selected' }}>Freshman</option>
                                    <option value="Transferee" {{ registration.admissionType == 'Transferee' ? 'selected' }}>Transferee</option>
                                </select>
                                                            
                                <select name="grade_level" class="bg-blue-50 text-blue-700 text-sm font-semibold border border-blue-100 rounded-lg px-2 py-1" onchange="if(window.updateGradeDependents) window.updateGradeDependents()">
                                    {% for level in ['grade_11', 'grade_12'] %}
                                        <option value="{{ level }}" {{ (registration.gradeLevel|lower|replace({' ': '_'}) == level|lower) ? 'selected' }}>{{ level|replace({'_': ' '})|title }}</option>
                                    {% endfor %}
                                </select>

                                <select name="track_strand" class="bg-amber-50 text-amber-700 text-sm font-semibold border border-amber-100 rounded-lg px-2 py-1">
                                    <option value="">Select Strand</option>
                                    {% for strand in ['STEM', 'ABM', 'HUMSS', 'GAS', 'ICT', 'TVL-HE', 'TVL-ICT'] %}
                                        <option value="{{ strand }}" {{ (registration.trackStrand|upper == strand|upper) ? 'selected' }}>{{ strand }}</option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="text-xs text-gray-400 uppercase font-bold flex items-center gap-1"><i class="ki-filled ki-sms"></i> Email</label>
                                    <input type="email" name="email" value="{{ registration.personalEmail }}" class="w-full text-sm text-gray-600 border border-gray-400 rounded-lg px-3 py-2.5 mt-1 shadow-sm focus:ring-2 focus:ring-feu-green-200 focus:border-feu-green-500">
                                </div>
                                <div>
                                    <label class="text-xs text-gray-400 uppercase font-bold flex items-center gap-1"><i class="ki-filled ki-phone"></i> Mobile</label>
                                    <input type="text" name="mobile" value="{{ registration.mobileNumber }}" class="w-full text-sm text-gray-600 border border-gray-400 rounded-lg px-3 py-2.5 mt-1 shadow-sm focus:ring-2 focus:ring-feu-green-200 focus:border-feu-green-500">
                                </div>
                            </div>
                        </div>

                        {# Dynamic Status Section #}
                        <div id="statusSectionContainer" class="flex-shrink-0 self-start md:self-center min-w-[200px]">
                            {# Examination Status - Only for SHS #}
                            <div id="shsExamSection" class="bg-gray-50 p-4 rounded-xl border border-gray-200 text-center" style="{{ registration.educationType == 'SHS' ? '' : 'display: none;' }}">
                                <div class="text-xs font-bold text-gray-400 uppercase mb-3">Examination Status</div>
                                
                                <label class="flex items-center justify-center gap-2 cursor-pointer mb-3">
                                    <input type="checkbox" name="exam_taken" id="examCheck" value="1" class="form-checkbox h-5 w-5 text-feu-green-600 rounded border-gray-300 focus:ring-feu-green-500" {{ registration.examinationScore is not null ? 'checked' : '' }}>
                                    <span class="text-sm font-bold text-gray-700">Exam Taken</span>
                                </label>

                                <div id="scoreBox" style="{{ registration.examinationScore is not null ? '' : 'display: none;' }}" class="space-y-3">
                                    <div>
                                        <input type="number" step="0.01" name="exam_score" value="{{ registration.examinationScore }}" class="w-full text-center border-gray-400 border-2 rounded-lg text-lg font-bold text-feu-green-700 shadow-inner px-3 py-2" placeholder="00.00">
                                        <div class="text-[10px] text-gray-400 mt-1 uppercase font-bold">Examination Score</div>
                                    </div>
                                    <div>
                                        <input type="date" name="exam_date" value="{{ registration.examinationDate ? registration.examinationDate|date('Y-m-d') : '' }}" class="w-full text-center border-gray-300 border rounded-lg text-sm font-bold text-gray-700 px-3 py-2 mt-2">
                                        <div class="text-[10px] text-gray-400 mt-1 uppercase font-bold">Examination Date</div>
                                    </div>
                                </div>
                                <div id="pendingBox" style="{{ registration.examinationScore is not null ? 'display: none;' : '' }}" class="text-sm font-bold text-orange-500">
                                    Pending Examination
                                </div>
                            </div>

                            {# Payment Status - For K-10 #}
                            <div id="k10PaymentSection" class="bg-gray-50 p-4 rounded-xl border border-gray-200 text-center" style="{{ registration.educationType != 'SHS' ? '' : 'display: none;' }}">
                                <div class="text-xs font-bold text-gray-400 uppercase mb-3">Payment Status</div>
                                
                                <label class="flex items-center justify-center gap-2 cursor-pointer mb-3">
                                    <input type="checkbox" name="payment_paid" id="paymentPaidCheck" value="1" class="form-checkbox h-5 w-5 text-feu-green-600 rounded border-gray-300 focus:ring-feu-green-500" {{ registration.admissionStatus == 'Paid' ? 'checked' : '' }}>
                                    <span class="text-sm font-bold text-gray-700">Paid</span>
                                </label>

                                <div id="paymentPendingBox" class="text-sm font-bold text-orange-500" style="{{ registration.admissionStatus == 'Paid' ? 'display: none;' : '' }}">
                                    For Payment
                                </div>
                                <div id="paymentPaidBox" class="text-sm font-bold text-green-600" style="{{ registration.admissionStatus == 'Paid' ? '' : 'display: none;' }}">
                                    Paid
                                </div>
                            </div>
                        </div>
                    </div>

                    {# --- 2. DETAILS GRID --- #}
                    <div class="col-span-12 lg:col-span-8 space-y-6">
                        {# Personal Info #}
                        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-200">
                            <h3 class="text-lg font-bold text-gray-800 mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
                                <i class="ki-filled ki-user text-feu-green-600"></i> Personal Information
                            </h3>
                            <div class="grid grid-cols-2 gap-y-4 gap-x-8">
                                <div>
                                    <label class="text-xs text-gray-400 uppercase font-bold">Gender</label>
                                    <select name="gender" class="w-full mt-1 border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5">
                                        <option value="Male" {{ registration.gender == 'Male' ? 'selected' : '' }}>Male</option>
                                        <option value="Female" {{ registration.gender == 'Female' ? 'selected' : '' }}>Female</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="text-xs text-gray-400 uppercase font-bold">Birthday</label>
                                    <input type="date" name="birth_date" value="{{ registration.birthDate|date('Y-m-d') }}" class="w-full mt-1 border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5">
                                </div>
                                <div>
                                    <label class="text-xs text-gray-400 uppercase font-bold">Birth Place</label>
                                    <input type="text" name="birth_place" value="{{ registration.birthPlace }}" class="w-full mt-1 border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5">
                                </div>
                                <div>
                                    <label class="text-xs text-gray-400 uppercase font-bold">Religion</label>
                                    <input type="text" name="religion" value="{{ registration.religion }}" class="w-full mt-1 border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5">
                                </div>
                                <div>
                                    <label class="text-xs text-gray-400 uppercase font-bold">Nationality</label>
                                    <select name="nationality" class="w-full mt-1 border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5">
                                        <option value="">Select Nationality</option>
                                        {% for nat in nationalities %}
                                            <option value="{{ nat.citizenshipName }}" {{ registration.nationality|upper == nat.citizenshipName|upper ? 'selected' : '' }}>{{ nat.citizenshipName }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div>
                                    <label class="text-xs text-gray-400 uppercase font-bold">Citizenship</label>
                                    <select name="citizenship" class="w-full mt-1 border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5">
                                        <option value="LOCAL" {{ registration.citizenship|upper == 'LOCAL' ? 'selected' : '' }}>Local</option>
                                        <option value="INTERNATIONAL" {{ registration.citizenship|upper == 'INTERNATIONAL' ? 'selected' : '' }}>International</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        {# Address Information #}
                        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-200">
                            <h3 class="text-lg font-bold text-gray-800 mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
                                <i class="ki-filled ki-map text-feu-green-600"></i> Address Information
                            </h3>
                            
                            {# Current #}
                            <div class="mb-6">
                                <div class="text-xs text-gray-400 uppercase font-bold mb-2">Current Address</div>
                                <div class="text-xs text-blue-600 mb-2 italic">Stored: {{ registration.currentAddress }}, {{ registration.currentBarangay }}, {{ registration.currentCity }}, {{ registration.currentProvince }}</div>
                                
                                <div class="grid grid-cols-2 gap-3 mb-3">
                                    <div>
                                        <label class="text-[10px] text-gray-500">Region</label>
                                        <select id="addr_region" name="addr_region" class="w-full border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5" data-selected="{{ registration.currentRegion }}"><option value=""></option></select>
                                    </div>
                                    <div>
                                        <label class="text-[10px] text-gray-500">Province</label>
                                        <select id="addr_province" name="addr_province" class="w-full border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5" disabled data-selected="{{ registration.currentProvince }}"><option value=""></option></select>
                                    </div>
                                    <div>
                                        <label class="text-[10px] text-gray-500">City</label>
                                        <select id="addr_city" name="addr_city" class="w-full border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5" disabled data-selected="{{ registration.currentCity }}"><option value=""></option></select>
                                    </div>
                                    <div>
                                        <label class="text-[10px] text-gray-500">Barangay</label>
                                        <select id="addr_barangay" name="addr_barangay" class="w-full border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5" disabled data-selected="{{ registration.currentBarangay }}"><option value=""></option></select>
                                    </div>
                                </div>
                                <input type="text" name="current_address" value="{{ registration.currentAddress }}" class="w-full border border-gray-400 rounded-lg text-sm mb-2 shadow-sm px-3 py-2.5" placeholder="Street Address">
                                <input type="text" name="current_zip" id="addr_zip" value="{{ registration.currentZip }}" class="w-full border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5" placeholder="Zip Code">
                            </div>

                            {# Permanent #}
                            <div class="pt-4 border-t border-gray-100">
                                <div class="text-xs text-gray-400 uppercase font-bold mb-2">Permanent Address</div>
                                <div class="text-xs text-blue-600 mb-2 italic">Stored: {{ registration.permanentAddress }}, {{ registration.permanentBarangay }}, {{ registration.permanentCity }}, {{ registration.permanentProvince }}</div>

                                <div class="grid grid-cols-2 gap-3 mb-3">
                                    <div>
                                        <label class="text-[10px] text-gray-500">Region</label>
                                        <select id="perm_region" name="perm_region" class="w-full border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5" data-selected="{{ registration.permanentRegion }}"><option value=""></option></select>
                                    </div>
                                    <div>
                                        <label class="text-[10px] text-gray-500">Province</label>
                                        <select id="perm_province" name="perm_province" class="w-full border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5" disabled data-selected="{{ registration.permanentProvince }}"><option value=""></option></select>
                                    </div>
                                    <div>
                                        <label class="text-[10px] text-gray-500">City</label>
                                        <select id="perm_city" name="perm_city" class="w-full border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5" disabled data-selected="{{ registration.permanentCity }}"><option value=""></option></select>
                                    </div>
                                    <div>
                                        <label class="text-[10px] text-gray-500">Barangay</label>
                                        <select id="perm_barangay" name="perm_barangay" class="w-full border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5" disabled data-selected="{{ registration.permanentBarangay }}"><option value=""></option></select>
                                    </div>
                                </div>
                                <input type="text" name="permanent_address" value="{{ registration.permanentAddress }}" class="w-full border border-gray-400 rounded-lg text-sm mb-2 shadow-sm px-3 py-2.5" placeholder="Street Address">
                                <input type="text" name="permanent_zip" id="perm_zip" value="{{ registration.permanentZip }}" class="w-full border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5" placeholder="Zip Code">
                            </div>
                        </div>

                        {# Parents / Family Background (FATHER and MOTHER ONLY) #}
                        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-200">
                            <h3 class="text-lg font-bold text-gray-800 mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
                                <i class="ki-filled ki-people text-feu-green-600"></i> Family Background
                            </h3>
                            <div class="space-y-4">
                                {% for guardian in registration.guardians %}
                                {% set gType = guardian.guardianType|default(guardian.relationship|upper in ['FATHER', 'MOTHER'] ? guardian.relationship|upper : 'GUARDIAN') %}
                                {% if gType in ['FATHER', 'MOTHER'] %}
                                <div class="p-4 bg-gray-50 rounded-xl border border-gray-100 relative">
                                    <input type="hidden" name="guardians[{{ loop.index0 }}][guardian_type]" value="{{ gType }}">
                                    <input type="hidden" name="guardians[{{ loop.index0 }}][relationship]" value="{{ guardian.relationship }}">
                                    
                                    <div class="flex justify-between items-center mb-2">
                                        <div class="text-xs text-feu-gold-600 font-bold uppercase">{{ guardian.relationship }}</div>
                                        <div class="flex gap-2">
                                            <label class="inline-flex items-center text-[10px]">
                                                <input type="checkbox" name="guardians[{{ loop.index0 }}][deceased]" value="1" {{ guardian.deceased ? 'checked' : '' }} class="rounded border-gray-300 text-feu-green-600 focus:ring-feu-green-50 w-3 h-3 mr-1">
                                                Deceased
                                            </label>
                                            <label class="inline-flex items-center text-[10px]">
                                                <input type="checkbox" name="guardians[{{ loop.index0 }}][ofw]" value="1" {{ guardian.OFW ? 'checked' : '' }} class="rounded border-gray-300 text-feu-green-600 focus:ring-feu-green-500 w-3 h-3 mr-1">
                                                OFW
                                            </label>
                                        </div>
                                    </div>
                                    
                                    {% set parentNameVal = guardian.parentName|default('') %}
                                    {% set nameParts = parentNameVal|split(',') %}
                                    {% set lastNameVal = nameParts[0]|default('')|trim %}
                                    {% set givenNameStr = nameParts|length > 1 ? nameParts[1] : '' %}
                                    {% set givenNameParts = givenNameStr|trim|split(' ') %}
                                    {% set middleNameVal = givenNameParts|length > 1 ? givenNameParts|last : '' %}
                                    {% set firstNameVal = givenNameParts|length > 1 ? givenNameParts|slice(0, -1)|join(' ') : givenNameParts|join(' ') %}

                                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-3">
                                        <div>
                                            <label class="text-[10px] text-gray-500 uppercase font-bold">
                                                {% if guardian.relationship|upper == 'MOTHER' %}Maiden Name{% else %}Last Name{% endif %}
                                            </label>
                                            <input type="text" name="guardians[{{ loop.index0 }}][last_name]" value="{{ lastNameVal }}" class="w-full border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5">
                                        </div>
                                        <div>
                                            <label class="text-[10px] text-gray-500 uppercase font-bold">First Name</label>
                                            <input type="text" name="guardians[{{ loop.index0 }}][first_name]" value="{{ firstNameVal }}" class="w-full border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5">
                                        </div>
                                        <div>
                                            <label class="text-[10px] text-gray-500 uppercase font-bold">Middle Name</label>
                                            <input type="text" name="guardians[{{ loop.index0 }}][middle_name]" value="{{ middleNameVal }}" class="w-full border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5">
                                        </div>
                                    </div>
                                    
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                        <div>
                                            <label class="text-[10px] text-gray-500 uppercase font-bold">Occupation</label>
                                            <input type="text" name="guardians[{{ loop.index0 }}][occupation]" value="{{ guardian.occupation }}" class="w-full border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5" placeholder="Occupation">
                                        </div>
                                        <div>
                                            <label class="text-[10px] text-gray-500 uppercase font-bold">Contact No.</label>
                                            <input type="text" name="guardians[{{ loop.index0 }}][contact]" value="{{ guardian.contactNo }}" class="w-full border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5" placeholder="Contact No">
                                        </div>
                                    </div>
                                </div>
                                {% endif %}
                                {% endfor %}
                            </div>
                        </div>

                        {# Siblings #}
                        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-200">
                            <h3 class="text-lg font-bold text-gray-800 mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
                                <i class="ki-filled ki-profile-user text-feu-green-600"></i> Siblings
                            </h3>
                            <div class="space-y-2">
                                {% for sibling in registration.siblings %}
                                <div class="grid grid-cols-3 gap-2">
                                    <input type="text" name="siblings[{{ loop.index0 }}][name]" value="{{ sibling.siblingName }}" class="border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5" placeholder="Sibling Name">
                                    <input type="text" name="siblings[{{ loop.index0 }}][school]" value="{{ sibling.school }}" class="border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5" placeholder="School">
                                    <input type="text" name="siblings[{{ loop.index0 }}][feu_id]" value="{{ sibling.feuStudentNo }}" class="border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5" placeholder="FEU ID (if any)">
                                </div>
                                {% else %}
                                <p class="text-sm text-gray-400 italic">No siblings listed.</p>
                                {% endfor %}
                            </div>
                        </div>
                    </div>

                    {# --- 3. SIDEBAR GRID --- #}
                    <div class="col-span-12 lg:col-span-4 space-y-6">
                        {# Education History #}
                        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-200">
                            <h3 class="text-lg font-bold text-gray-800 mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
                                <i class="ki-filled ki-teacher text-feu-green-600"></i> Education History
                            </h3>
                            <div class="space-y-4">
                                {% for school in registration.schools %}
                                {# Auto-convert old 4-digit entries (e.g. '2024') to '2023-2024' #}
                                {% set sYear = school.schoolYear %}
                                {% if sYear|length == 4 %}
                                    {% set sYear = (sYear - 1) ~ '-' ~ sYear %}
                                {% endif %}
                                <div class="relative pl-4 border-l-2 border-gray-200">
                                    <div class="text-[10px] font-bold text-feu-green-600 uppercase mb-1">
                                        {% if school.level == 'P' or school.level == 'E' or school.level|upper == 'ELEMENTARY' %}Elementary{% elseif school.level == 'I' or school.level|upper == 'JUNIOR HIGH SCHOOL' %}Junior High{% elseif school.level == 'K' or school.level|upper == 'KINDERGARTEN' %}Kindergarten{% else %}Senior High{% endif %}
                                    </div>
                                    <input type="text" name="schools[{{ loop.index0 }}][name]" value="{{ school.school }}" class="w-full border border-gray-400 rounded-lg text-sm mb-1 shadow-sm px-3 py-2.5" placeholder="School Name">
                                    <input type="text" name="schools[{{ loop.index0 }}][year]" value="{{ sYear }}" class="w-full border border-gray-400 rounded-lg text-sm mb-1 shadow-sm px-3 py-2.5" placeholder="YYYY-YYYY" pattern="\d{4}-\d{4}" maxlength="9">
                                    <select name="schools[{{ loop.index0 }}][type]" class="w-full border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5 mb-1">
                                        <option value="">School Type</option>
                                        <option value="Public" {{ school.schoolType == 'Public' ? 'selected' }}>Public</option>
                                        <option value="Private" {{ school.schoolType == 'Private' ? 'selected' }}>Private</option>
                                        <option value="International" {{ school.schoolType == 'International' ? 'selected' }}>International</option>
                                    </select>
                                    
                                    <div class="mt-2 mb-1 flex items-center">
                                        <input type="checkbox" id="school_{{ loop.index0 }}_intl" name="schools[{{ loop.index0 }}][is_international]" value="1" class="rounded border-gray-300 text-feu-green-600 focus:ring-feu-green-50 w-3 h-3 mr-1" {{ school.isInternational ? 'checked' : '' }} onchange="toggleAdminSchoolLocation({{ loop.index0 }})">
                                        <label for="school_{{ loop.index0 }}_intl" class="text-[10px] uppercase font-bold text-gray-500 cursor-pointer">International School</label>
                                    </div>
                                    <div id="school_{{ loop.index0 }}_local_group" class="grid grid-cols-3 gap-2 mb-2" style="{{ school.isInternational ? 'display:none;' : '' }}">
                                        <select id="school_{{ loop.index0 }}_region" name="schools[{{ loop.index0 }}][region]" class="w-full border border-gray-400 rounded-lg text-[10px] shadow-sm px-2 py-1" data-selected="{{ school.region }}"><option value="">Region</option></select>
                                        <select id="school_{{ loop.index0 }}_province" name="schools[{{ loop.index0 }}][province]" class="w-full border border-gray-400 rounded-lg text-[10px] shadow-sm px-2 py-1" data-selected="{{ school.province }}"><option value="">Province</option></select>
                                        <select id="school_{{ loop.index0 }}_city" name="schools[{{ loop.index0 }}][city]" class="w-full border border-gray-400 rounded-lg text-[10px] shadow-sm px-2 py-1" data-selected="{{ school.city }}"><option value="">City</option></select>
                                    </div>
                                    <div id="school_{{ loop.index0 }}_intl_group" class="mb-2" style="{{ not school.isInternational ? 'display:none;' : '' }}">
                                        <select name="schools[{{ loop.index0 }}][country]" class="w-full border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5">
                                            <option value="">Select Country</option>
                                            {% for country in countries %}
                                                <option value="{{ country.countryName }}" {{ school.country == country.countryName ? 'selected' : '' }}>{{ country.countryName }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <span class="absolute top-0 left-[-5px] w-2 h-2 rounded-full bg-gray-300"></span>
                                </div>
                                {% else %}
                                <div class="text-sm text-gray-400 italic">No history provided.</div>
                                {% endfor %}
                            </div>
                        </div>

                        {# Documents (Editable) #}
                        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-200">
                            <h3 class="text-lg font-bold text-gray-800 mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
                                <i class="ki-filled ki-folder-added text-feu-green-600"></i> Submitted Files
                            </h3>

                            {# Promissory Date Edit #}
                            <div class="mb-6 p-4 rounded-xl bg-amber-50 border border-amber-200">
                                <label class="block">
                                    <span class="text-[10px] text-amber-800 uppercase font-bold mb-2 block flex items-center gap-1">
                                        <i class="ki-filled ki-calendar"></i> Promissory Submission Date
                                    </span>
                                    <input type="date" name="documents_agreed_date" value="{{ registration.documentsAgreedDate ? registration.documentsAgreedDate|date('Y-m-d') : '' }}" 
                                           class="w-full border-gray-300 rounded-lg text-sm font-bold text-gray-700 px-3 py-2">
                                    <p class="text-[9px] text-amber-600 mt-2 italic">Leave blank if all documents are submitted.</p>
                                </label>
                            </div>

                            <div class="space-y-4">
                                {% set hasActiveDocs = false %}
                                {% for req in registration.requirements %}
                                    {% set isRelevant = false %}
                                    {% for setup in documentSetups %}
                                        {% if setup.slug|lower == req.Slug|lower %}
                                            {% set isRelevant = true %}
                                        {% endif %}
                                    {% endfor %}

                                    {% if not req.isDeleted and isRelevant %}
                                        {% set hasActiveDocs = true %}
                                        <div class="p-3 rounded-xl border border-gray-100 bg-gray-50">
                                            <div class="flex items-center justify-between mb-2">
                                                <div class="flex items-center gap-3">
                                                    <div class="w-8 h-8 flex items-center justify-center">
                                                        <img src="{{ asset('metronic/media/file-types/pdf.svg') }}" class="w-full h-full" alt="PDF">
                                                    </div>
                                                    <div>
                                                        <div class="text-sm font-bold text-gray-800">{{ req.requirement }}</div>
                                                        <a href="{{ asset(req.storedFileName) }}" target="_blank" class="text-xs text-blue-600 hover:underline flex items-center gap-1">
                                                            <i class="ki-filled ki-eye"></i> View Current File
                                                        </a>
                                                    </div>
                                                </div>
                                                
                                                {# Delete Trigger #}
                                                <button type="button" class="btn btn-sm btn-light-danger px-3 py-2 text-xs" onclick="if(confirm('WARNING: Are you sure you want to soft-delete this document?')) document.getElementById('delete-doc-alabang-{{ req.Slug }}').submit();">
                                                    <i class="ki-filled ki-trash"></i> Delete
                                                </button>
                                            </div>
                                            <div class="text-xs text-gray-400">
                                                {% if req.status == 'S' %}Submitted{% else %}Pending{% endif %}
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                                
                                {% if not hasActiveDocs %}
                                    <div class="text-center py-6 text-gray-400 text-sm italic">No relevant documents found.</div>
                                {% endif %}

                                <hr class="mt-6 mb-4 border-gray-200">
                        
                                {# Dynamic Uploads #}
                                <h6 class="text-sm font-bold mt-2 mb-3 text-gray-700">Upload / Replace Documents</h6>
                                {% if documentSetups is defined and documentSetups|length > 0 %}
                                    <div class="space-y-3">
                                        {% for docSetup in documentSetups %}
                                            <div>
                                                <label class="text-[10px] text-gray-500 uppercase font-bold mb-1 block">{{ docSetup.documentName }}</label>
                                                <input type="file" name="{{ docSetup.slug }}" accept=".pdf" class="block w-full text-xs text-gray-500 file:mr-2 file:py-1 file:px-2 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <p class="text-xs text-gray-400 italic">No document configurations set up by Admin.</p>
                                {% endif %}
                            </div>
                        </div>

                        {# System Info #}
                        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-200">
                            <h3 class="text-lg font-bold text-gray-800 mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
                                <i class="ki-filled ki-setting-2 text-feu-green-600"></i> System Info
                            </h3>
                            <div class="space-y-3">
                                <div class="flex justify-between text-sm">
                                    <span class="text-gray-500">Applied On</span>
                                    <span class="font-medium text-gray-800">{{ registration.createdAt|date('M d, Y') }}</span>
                                </div>
                                <div class="flex justify-between text-sm">
                                    <span class="text-gray-500">School Year</span>
                                    <span class="font-medium text-gray-800">{{ registration.schoolYearOfEntry }}</span>
                                </div>
                            </div>
                        </div>

                        {# Emergency Contact Edit Block (Always renders via GUARDIAN type) #}
                        {% set emergencyContact = null %}
                        {% set emergencyIndex = 'new_999' %}
                        
                        {% for guardian in registration.guardians %}
                            {% set gType = guardian.guardianType|default(guardian.relationship|upper in ['FATHER', 'MOTHER'] ? guardian.relationship|upper : 'GUARDIAN') %}
                            {% if gType == 'GUARDIAN' %}
                                {% set emergencyContact = guardian %}
                                {% set emergencyIndex = loop.index0 %}
                            {% endif %}
                        {% endfor %}

                        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-200">
                            <h3 class="text-lg font-bold text-gray-800 mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
                                <i class="ki-filled ki-phone text-orange-500"></i> Emergency Contact
                            </h3>
                            <div class="space-y-3">
                                <input type="hidden" name="guardians[{{ emergencyIndex }}][guardian_type]" value="GUARDIAN">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-3">
                                    <div>
                                        <label class="text-[10px] text-gray-500 uppercase font-bold">Full Name</label>
                                        <input type="text" name="guardians[{{ emergencyIndex }}][full_name]" value="{{ emergencyContact ? emergencyContact.parentName|default('')|trim(', ') : '' }}" class="w-full border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5" placeholder="Full Name">
                                    </div>
                                    <div>
                                        <label class="text-[10px] text-gray-500 uppercase font-bold">Relationship</label>
                                        <input type="text" name="guardians[{{ emergencyIndex }}][relationship]" value="{{ emergencyContact ? emergencyContact.relationship : 'GUARDIAN' }}" class="w-full border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5">
                                    </div>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                    <div>
                                        <label class="text-[10px] text-gray-500 uppercase font-bold">Occupation</label>
                                        <input type="text" name="guardians[{{ emergencyIndex }}][occupation]" value="{{ emergencyContact ? emergencyContact.occupation : '' }}" class="w-full border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5" placeholder="Occupation">
                                    </div>
                                    <div>
                                        <label class="text-[10px] text-gray-500 uppercase font-bold">Contact No.</label>
                                        <input type="text" name="guardians[{{ emergencyIndex }}][contact]" value="{{ emergencyContact ? emergencyContact.contactNo : '' }}" class="w-full border border-gray-400 rounded-lg text-sm shadow-sm px-3 py-2.5" placeholder="Contact No">
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </form>
        </div>
    </main>
</div>

{% for req in registration.requirements %}
    {% if not req.isDeleted %}
        <form id="delete-doc-alabang-{{ req.slug }}" action="{{ path('app_admin_alabang_registration_doc_delete', {id: registration.studentNumber, slug: req.slug}) }}" method="POST" class="hidden"></form>
    {% endif %}
{% endfor %}

<script src="{{ asset('js/ph-address-lookup.js') }}"></script>
<script src="{{ asset('js/validation.js') }}"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    let isDirty = false;
    const form = document.getElementById('editForm');
    const backBtn = document.getElementById('btn_discard');

    if(form) {
        form.addEventListener('change', () => { isDirty = true; });
        form.addEventListener('input', () => { isDirty = true; });
        
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            if(confirm('Are you sure you want to save these changes?')) {
                isDirty = false;
                this.submit();
            }
        });
    }

    if(backBtn) {
        backBtn.addEventListener('click', function(e) {
            if(isDirty) {
                if(!confirm('You have unsaved changes. Are you sure you want to discard them and exit?')) {
                    e.preventDefault();
                }
            }
        });
    }

    window.addEventListener('beforeunload', function(e) {
        if(isDirty) { e.preventDefault(); e.returnValue = ''; }
    });

    const check = document.getElementById('examCheck');
    const scoreBox = document.getElementById('scoreBox');
    const pendingBox = document.getElementById('pendingBox');

    function toggleScore() {
        if(check && check.checked) {
            scoreBox.style.display = 'block';
            pendingBox.style.display = 'none';
        } else if(check) {
            scoreBox.style.display = 'none';
            pendingBox.style.display = 'block';
        }
    }
    
    if(check) {
        check.addEventListener('change', () => {
            toggleScore();
            isDirty = true;
        });
        toggleScore();
    }

    if(typeof ARIESValidation !== 'undefined') {
        const nameInputs = document.querySelectorAll('input[name="last_name"], input[name="first_name"], input[name="middle_name"]');
        nameInputs.forEach(el => ARIESValidation.setupFormatting(el, 'name'));

        const textInputs = document.querySelectorAll('input[name="birth_place"], input[name="religion"], input[name="current_address"], input[name="permanent_address"]');
        textInputs.forEach(el => ARIESValidation.setupFormatting(el, 'text'));

        const arrayInputs = document.querySelectorAll('input[name^="guardians"][type="text"], input[name^="siblings"][type="text"], input[name^="schools"][type="text"]');
        arrayInputs.forEach(el => {
            const isName = el.name.includes('[name]') || el.name.includes('full_name') || el.name.includes('last_name') || el.name.includes('first_name') || el.name.includes('middle_name') || el.name.includes('parentName') || el.name.includes('SiblingName');
            ARIESValidation.setupFormatting(el, isName ? 'name' : 'text');
        });
    }

    async function setupAddressLookup(prefix) {
        const regions = document.getElementById(prefix + '_region');
        const provinces = document.getElementById(prefix + '_province');
        const cities = document.getElementById(prefix + '_city');
        const barangays = document.getElementById(prefix + '_barangay');

        if(!regions) return;

        const selR = regions.getAttribute('data-selected') || '';
        const selP = provinces ? (provinces.getAttribute('data-selected') || '') : '';
        const selC = cities ? (cities.getAttribute('data-selected') || '') : '';
        const selB = barangays ? (barangays.getAttribute('data-selected') || '') : '';

        const loadRegions = async () => {
            const res = await fetch('/api/address/regions');
            const data = await res.json();
            data.forEach(r => { regions.innerHTML += `<option value="${r.code}">${r.name}</option>`; });
        };
        
        const loadProvinces = async (rCode) => {
            if(!provinces) return;
            provinces.innerHTML = '<option value="">Select Province</option>';
            provinces.disabled = true;
            if(!rCode) return;
            const res = await fetch(`/api/address/provinces/${rCode}`);
            const data = await res.json();
            data.forEach(p => { provinces.innerHTML += `<option value="${p.code}">${p.name}</option>`; });
            provinces.disabled = false;
        };

        const loadCities = async (pCode) => {
            if(!cities) return;
            cities.innerHTML = '<option value="">Select City</option>';
            cities.disabled = true;
            if(!pCode) return;
            const res = await fetch(`/api/address/cities/${pCode}`);
            const data = await res.json();
            data.forEach(c => { cities.innerHTML += `<option value="${c.code}">${c.name}</option>`; });
            cities.disabled = false;
        };

        const loadBarangays = async (cCode) => {
            if(!barangays) return;
            barangays.innerHTML = '<option value="">Select Barangay</option>';
            barangays.disabled = true;
            if(!cCode) return;
            const res = await fetch(`/api/address/barangays/${cCode}`);
            const data = await res.json();
            data.forEach(b => { barangays.innerHTML += `<option value="${b.name}">${b.name}</option>`; });
            barangays.disabled = false;
        };

        regions.addEventListener('change', async function() {
            await loadProvinces(this.value);
            if(cities) { cities.innerHTML = '<option value="">Select City</option>'; cities.disabled = true; }
            if(barangays) { barangays.innerHTML = '<option value="">Select Barangay</option>'; barangays.disabled = true; }
        });

        if(provinces) {
            provinces.addEventListener('change', async function() {
                await loadCities(this.value);
                if(barangays) { barangays.innerHTML = '<option value="">Select Barangay</option>'; barangays.disabled = true; }
            });
        }

        if(cities && barangays) {
            cities.addEventListener('change', async function() {
                await loadBarangays(this.value);
            });
        }

        // Initial Load Pre-selection
        await loadRegions();
        if(selR) {
            regions.value = selR;
            await loadProvinces(selR);
            if(selP && provinces) {
                provinces.value = selP;
                await loadCities(selP);
                if(selC && cities) {
                    cities.value = selC;
                    await loadBarangays(selC);
                    if(selB && barangays) {
                        barangays.value = selB;
                    }
                }
            }
        }
    }

    setupAddressLookup('addr');
    setupAddressLookup('perm');
    
    document.querySelectorAll('[id^="school_"][id$="_intl"]').forEach((cb) => {
        const index = cb.id.split('_')[1];
        setupAddressLookup(`school_${index}`);
    });

    window.toggleAdminSchoolLocation = function(index) {
        const isIntl = document.getElementById(`school_${index}_intl`).checked;
        const localGroup = document.getElementById(`school_${index}_local_group`);
        const intlGroup = document.getElementById(`school_${index}_intl_group`);

        if(isIntl) {
            localGroup.style.display = 'none';
            intlGroup.style.display = '';
        } else {
            localGroup.style.display = '';
            intlGroup.style.display = 'none';
        }
    };

    window.previewImage = function(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                const img = input.closest('.group').querySelector('img');
                if(img) img.src = e.target.result;
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

    // --- DYNAMIC FORM LOGIC ---

    const gradeSelect = document.querySelector('select[name="grade_level"]');
    const strandSelect = document.querySelector('select[name="track_strand"]');
    const shsSection = document.getElementById('shsExamSection');
    const k10Section = document.getElementById('k10PaymentSection');

    window.updateGradeDependents = function() {
        if (!gradeSelect) return;
        
        const level = gradeSelect.value.toLowerCase();
        // Robust check for SHS: includes '11' or '12' or 'shs'
        const isSHS = level.includes('11') || level.includes('12') || level.includes('shs');
        
        // 1. Toggle Strand Dropdown
        if (strandSelect) {
            if (isSHS) {
                strandSelect.style.display = ''; 
                strandSelect.disabled = false;
            } else {
                strandSelect.style.display = 'none';
                strandSelect.disabled = true;
                strandSelect.value = ''; 
            }
        }

        // 2. Toggle Examination vs Payment Sections
        if (shsSection && k10Section) {
            shsSection.style.display = isSHS ? '' : 'none';
            k10Section.style.display = isSHS ? 'none' : '';
        }
    };

    if (gradeSelect) {
        gradeSelect.addEventListener('change', window.updateGradeDependents);
        gradeSelect.addEventListener('input', window.updateGradeDependents);
        window.updateGradeDependents();
    }

    // Exam Checkbox Toggle (Internal visibility)
    const examCheck = document.getElementById('examCheck');
    const scoreBox = document.getElementById('scoreBox');
    const pendingBox = document.getElementById('pendingBox');
    
    window.updateExamUI = function() {
        if (!examCheck) return;
        if (scoreBox) scoreBox.style.display = examCheck.checked ? '' : 'none';
        if (pendingBox) pendingBox.style.display = examCheck.checked ? 'none' : '';
    };

    if (examCheck) {
        examCheck.addEventListener('change', window.updateExamUI);
        window.updateExamUI();
    }

    // Payment Checkbox Toggle
    const paymentPaidCheck = document.getElementById('paymentPaidCheck');
    const paymentPendingBox = document.getElementById('paymentPendingBox');
    const paymentPaidBox = document.getElementById('paymentPaidBox');
    
    window.updatePaymentUI = function() {
        if (!paymentPaidCheck) return;
        if (paymentPendingBox) paymentPendingBox.style.display = paymentPaidCheck.checked ? 'none' : '';
        if (paymentPaidBox) paymentPaidBox.style.display = paymentPaidCheck.checked ? '' : 'none';
    };

    if (paymentPaidCheck) {
        paymentPaidCheck.addEventListener('change', window.updatePaymentUI);
        window.updatePaymentUI();
    }

    // --- INTERNATIONAL SCHOOL LOGIC ---
    window.toggleAdminSchoolLocation = function(index) {
        const cb = document.getElementById(`school_${index}_intl`);
        const localGroup = document.getElementById(`school_${index}_local_group`);
        const intlGroup = document.getElementById(`school_${index}_intl_group`);

        if (!cb || !localGroup || !intlGroup) return;

        if (cb.checked) {
            localGroup.style.display = 'none';
            intlGroup.style.display = '';
        } else {
            localGroup.style.display = '';
            intlGroup.style.display = 'none';
        }
    };
});

document.addEventListener('input', function(e) {
        if (e.target && e.target.name && e.target.name.includes('[year]')) {
            let val = e.target.value.replace(/\D/g, '');
            if (val.length > 4) {
                val = val.substring(0, 4) + '-' + val.substring(4, 8);
            }
            e.target.value = val;
        }
    });
</script>
{% endblock %}