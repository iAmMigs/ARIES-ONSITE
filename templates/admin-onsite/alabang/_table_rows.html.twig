{% for r in registrations %}
<tr class="hover:bg-gray-50/70 transition-colors">
    
    {# --- 1. PHOTO COLUMN --- #}
    <td class="py-4 px-6 whitespace-nowrap">
        {% if r.photoSlug %}
            <img src="{{ asset(r.photoSlug) }}" class="w-10 h-10 rounded-full object-cover border border-gray-200 shadow-xs" alt="Student Photo">
        {% else %}
            <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-700 flex items-center justify-center font-black text-xs uppercase border border-slate-200">
                {{ r.firstName|first }}{{ r.lastName|first }}
            </div>
        {% endif %}
    </td>

    {# --- 2. STUDENT ID --- #}
    <td class="py-4 px-6 whitespace-nowrap">
        <span class="font-mono text-xs font-bold text-gray-600 bg-gray-50 px-2.5 py-1 rounded-md border border-gray-200/80">
            {{ r.studentNumber }}
        </span>
    </td>

    {# --- 3. FULL NAME --- #}
    <td class="py-4 px-6 whitespace-nowrap">
        <div class="font-bold text-gray-900 tracking-tight text-sm">
            {{ r.lastName }}, {{ r.firstName }}{% if r.middleName %} {{ r.middleName }}{% endif %}{% if r.suffix %} {{ r.suffix }}{% endif %}
        </div>
        <div class="text-xs text-gray-400 font-mono">{{ r.email|default('') }}</div>
    </td>

    {# --- 4. LEVEL / STRAND --- #}
    <td class="py-4 px-6 whitespace-nowrap">
        <div class="flex flex-col gap-1 items-start">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200">
                {{ r.gradeLevel|replace({'_': ' '})|title }}
            </span>
            {% if r.trackStrand %}
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-200">
                    {{ r.trackStrand }}
                </span>
            {% endif %}
        </div>
    </td>

    {# --- 5. STATUS --- #}
    <td class="py-4 px-6 whitespace-nowrap">
        <div class="flex flex-col gap-1 items-start">
            {% if r.admissionStatus == 'Pending' or r.admissionStatus == 'P' or r.admissionStatus == 'For Payment' %}
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-300">
                    <i class="ki-filled ki-time text-amber-600"></i> {% if r.educationType == 'SHS' %}Pending Exam{% else %}For Payment{% endif %}
                </span>
            {% elseif r.admissionStatus == 'Promissory' %}
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-purple-100 text-purple-800 border border-purple-200">
                    <i class="ki-filled ki-document text-purple-600"></i> Promissory
                </span>
            {% elseif r.admissionStatus == 'Paid' %}
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-800 border border-blue-200">
                    <i class="ki-filled ki-check-tick text-blue-600"></i> Paid
                </span>
            {% elseif r.admissionStatus == 'Enrolled' %}
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Enrolled
                </span>
            {% else %}
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200">
                    {{ r.admissionStatus }}
                </span>
            {% endif %}

            {% if r.documentsAgreedDate %}
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold bg-orange-50 text-orange-700 border border-orange-200" title="Promissory Deadline: {{ r.documentsAgreedDate|date('F d, Y') }}">
                    <i class="ki-filled ki-calendar text-orange-600"></i> Due: {{ r.documentsAgreedDate|date('M d, Y') }}
                </span>
            {% else %}
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200" title="All documents complied">
                    <i class="ki-filled ki-check-circle text-emerald-600"></i> Complied
                </span>
            {% endif %}
        </div>
    </td>

    {# --- 6. DATE APPLIED --- #}
    <td class="py-4 px-6 whitespace-nowrap text-xs font-medium text-gray-500">
        {{ r.createdAt|date('M d, Y') }}
    </td>

    {# --- 7. ACTIONS --- #}
    <td class="py-4 px-6 whitespace-nowrap text-right">
        <div class="inline-flex items-center justify-end gap-1.5">
            {# View Button #}
            <a href="{{ path('app_admin_alabang_registration_view', {'id': r.studentNumber}) }}" 
               class="p-2 rounded-lg text-blue-600 hover:text-blue-800 hover:bg-blue-50 transition-colors" 
               title="View Application Details">
                <i class="ki-filled ki-eye text-lg"></i>
            </a>
            
            {# Edit Button #}
            <a href="{{ path('app_admin_alabang_registration_edit', {'id': r.studentNumber}) }}" 
               class="p-2 rounded-lg text-amber-600 hover:text-amber-800 hover:bg-amber-50 transition-colors" 
               title="Edit Application">
                <i class="ki-filled ki-pencil text-lg"></i>
            </a>
        </div>
    </td>
</tr>
{% else %}
<tr>
    <td colspan="7" class="py-12 text-center text-gray-400 font-medium">
        <div class="flex flex-col items-center gap-2">
            <i class="ki-filled ki-magnifier text-3xl text-gray-300"></i>
            <span>No applicants found matching your filter criteria.</span>
        </div>
    </td>
</tr>
{% endfor %}