{# templates/security/login_alabang.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}FEU Alabang - Admin Portal Login{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-gray-100 px-4 py-12">
    <div class="max-w-md w-full bg-white rounded-2xl shadow-xl overflow-hidden">
        
        {# Login Header #}
        <div class="bg-gradient-to-r from-feu-gold-600 to-feu-gold-500 p-8 text-center relative">
            <div class="relative z-10">
                <img src="{{ asset('images/hero/alabang.png') }}" class="h-16 mx-auto mb-4" alt="FEU Alabang">
                <h1 class="text-2xl font-bold text-gray-900 tracking-tight">Alabang Admin</h1>
                <p class="text-gray-800 text-sm mt-1">Authorized University Personnel Only</p>
            </div>
        </div>

        {# Login Form #}
        <div class="p-8">
            {% if app.request.query.get('reason') == 'timeout' %}
                {# Inactivity Timeout Popup Modal #}
                <div id="inactivityTimeoutModal" class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/60 backdrop-blur-sm p-4 animate-fade-in" role="dialog" aria-modal="true">
                    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 sm:p-8 border border-gray-100 text-center transform transition-all scale-100">
                        <div class="w-16 h-16 rounded-2xl bg-amber-50 text-amber-600 border border-amber-200 flex items-center justify-center mx-auto mb-4 shadow-xs">
                            <i class="ki-filled ki-time-schedule text-3xl"></i>
                        </div>
                        <h3 class="text-xl font-black text-gray-900 tracking-tight">
                            Session Timeout
                        </h3>
                        <p class="text-sm text-gray-600 mt-3 leading-relaxed font-medium">
                            You have been logged out due to inactivity, please log in again
                        </p>
                        <div class="mt-6">
                            <button type="button" 
                                    onclick="document.getElementById('inactivityTimeoutModal').remove();" 
                                    class="w-full inline-flex items-center justify-center gap-1.5 px-5 py-3 rounded-xl font-bold text-sm text-gray-900 bg-feu-gold-500 hover:bg-feu-gold-600 transition-all shadow-sm">
                                <i class="ki-filled ki-check text-base"></i> OK
                            </button>
                        </div>
                    </div>
                </div>

                <div class="mb-6 p-4 rounded-xl bg-amber-50 border border-amber-200 flex items-start gap-3 animate-fade-in">
                    <i class="ki-filled ki-time-schedule text-amber-600 text-xl mt-0.5"></i>
                    <div>
                        <h4 class="text-sm font-bold text-amber-900">Session Expired</h4>
                        <p class="text-xs text-amber-700 mt-0.5">You have been logged out due to inactivity, please log in again.</p>
                    </div>
                </div>
            {% endif %}

            {% if error %}
                <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-100 flex items-start gap-3 animate-fade-in">
                    <i class="ki-filled ki-information-2 text-red-500 text-xl mt-0.5"></i>
                    <div>
                        <h4 class="text-sm font-bold text-red-800">Authentication Error</h4>
                        <p class="text-xs text-red-600 mt-0.5">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                    </div>
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_auth_login_check') }}" class="space-y-5">
                <input type="hidden" name="_failure_path" value="{{ path('app_auth_login_alabang') }}">
                <input type="hidden" name="_campus" value="feu_alabang">
                <div>
                    <label for="username" class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1.5">Username or Employee ID</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i class="ki-filled ki-user text-gray-400"></i>
                        </div>
                        <input type="text" value="{{ last_username }}" name="_username" id="username" class="block w-full pl-10 pr-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-feu-gold-500 focus:border-transparent transition-all font-medium" placeholder="Enter username or employee ID" required autofocus autocomplete="username">
                    </div>
                </div>

                <div>
                    <label for="password" class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1.5">Password</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <i class="ki-filled ki-lock-2 text-gray-400"></i>
                        </div>
                        <input type="password" name="_password" id="password" class="block w-full pl-10 pr-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-feu-gold-500 focus:border-transparent transition-all font-medium" placeholder="••••••••" required autocomplete="current-password">
                    </div>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-lg shadow-feu-gold-900/10 text-sm font-bold text-gray-900 bg-gradient-to-r from-feu-gold-500 to-feu-gold-400 hover:from-feu-gold-600 hover:to-feu-gold-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-feu-gold-500 transition-all transform active:scale-95">
                    Sign In to Alabang Portal
                </button>
            </form>

            <div class="mt-8 text-center">
                <a href="{{ path('app_home_alabang') }}" class="inline-flex items-center text-sm font-medium text-gray-500 hover:text-feu-gold-700 transition-colors">
                    <i class="ki-filled ki-arrow-left text-xs mr-2"></i> Return to Homepage
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
