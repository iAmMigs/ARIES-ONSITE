{# templates/security/login_choice.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Admin Portal Selection{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-gray-100 px-4 py-12">
    <div class="max-w-4xl w-full">
        <div class="text-center mb-12">
            <h1 class="text-4xl font-black text-feu-green-900 tracking-tighter uppercase mb-4">Admin Portals</h1>
            <p class="text-gray-600 font-medium">Please select your campus to sign in to the administrative dashboard.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {# Diliman Portal #}
            <a href="{{ path('app_auth_login_diliman') }}" class="group block bg-white rounded-3xl shadow-xl overflow-hidden border-2 border-transparent hover:border-feu-green-500 transition-all duration-300 transform hover:-translate-y-2">
                <div class="h-48 bg-feu-green-800 relative flex items-center justify-center">
                    <div class="absolute inset-0 opacity-20 bg-[url('https://www.feudiliman.edu.ph/wp-content/uploads/2021/04/FEU-Diliman-Facade.jpg')] bg-cover bg-center"></div>
                    <img src="{{ asset('images/hero/diliman.png') }}" class="h-20 relative z-10 transition-transform group-hover:scale-110" alt="FEU Diliman">
                </div>
                <div class="p-8 text-center">
                    <h2 class="text-2xl font-bold text-gray-900 mb-2">FEU Diliman</h2>
                    <p class="text-gray-500 text-sm mb-6">Access registrations, document setups, and enrollment metrics for the Diliman campus.</p>
                    <span class="inline-flex items-center gap-2 px-6 py-2.5 bg-feu-green-700 text-white rounded-full text-sm font-bold group-hover:bg-feu-green-800 transition-colors">
                        Go to Diliman Portal <i class="ki-filled ki-arrow-right"></i>
                    </span>
                </div>
            </a>

            {# Alabang Portal #}
            <a href="{{ path('app_auth_login_alabang') }}" class="group block bg-white rounded-3xl shadow-xl overflow-hidden border-2 border-transparent hover:border-feu-gold-500 transition-all duration-300 transform hover:-translate-y-2">
                <div class="h-48 bg-feu-gold-500 relative flex items-center justify-center">
                    <div class="absolute inset-0 opacity-20 bg-[url('https://feualabang.edu.ph/assets/img/campus/alabang-facade.jpg')] bg-cover bg-center"></div>
                    <img src="{{ asset('images/hero/alabang.png') }}" class="h-20 relative z-10 transition-transform group-hover:scale-110" alt="FEU Alabang">
                </div>
                <div class="p-8 text-center">
                    <h2 class="text-2xl font-bold text-gray-900 mb-2">FEU Alabang</h2>
                    <p class="text-gray-500 text-sm mb-6">Access registrations, document setups, and enrollment metrics for the Alabang campus.</p>
                    <span class="inline-flex items-center gap-2 px-6 py-2.5 bg-feu-gold-600 text-gray-900 rounded-full text-sm font-bold group-hover:bg-feu-gold-700 transition-colors">
                        Go to Alabang Portal <i class="ki-filled ki-arrow-right"></i>
                    </span>
                </div>
            </a>
        </div>

        <div class="mt-16 text-center">
            <a href="{{ path('app_home_diliman') }}" class="text-gray-500 hover:text-feu-green-700 font-bold transition-colors">
                <i class="ki-filled ki-arrow-left text-xs mr-1"></i> Back to Homepage
            </a>
        </div>
    </div>
</div>
{% endblock %}
