{# templates/layouts/_public_header.html.twig #}
{# ARIES Public Site Header - ARIES Digital University Theme - Enhanced Metronic UI #}
<style>
    /* Header Metronic Enhancements */
    .header-main {
        transition: all 0.3s ease;
    }
    .header-main.scrolled {
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }
    .nav-link {
        position: relative;
        overflow: hidden;
    }
    .nav-link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 0;
        height: 2px;
        background: linear-gradient(90deg, #1a4d2e, #fbbf24);
        transition: all 0.3s ease;
        transform: translateX(-50%);
    }
    .nav-link:hover::after {
        width: 80%;
    }
    .logo-icon {
        position: relative;
        overflow: hidden;
    }
    .logo-icon::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient(45deg, transparent, rgba(255,255,255,0.15), transparent);
        transform: rotate(45deg) translateX(-100%);
        transition: transform 0.6s;
    }
    .logo-group:hover .logo-icon::before {
        transform: rotate(45deg) translateX(100%);
    }
    .btn-apply-pulse {
        animation: applyPulse 2s ease-in-out infinite;
    }
    @keyframes applyPulse {
        0%, 100% { box-shadow: 0 4px 15px rgba(26, 77, 46, 0.25); }
        50% { box-shadow: 0 4px 25px rgba(26, 77, 46, 0.4); }
    }
    .mobile-nav-item {
        position: relative;
    }
    .mobile-nav-item::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        width: 3px;
        height: 0;
        background: linear-gradient(180deg, #1a4d2e, #fbbf24);
        border-radius: 2px;
        transform: translateY(-50%);
        transition: height 0.3s ease;
    }
    .mobile-nav-item:hover::before {
        height: 60%;
    }
    .enrollment-badge {
        animation: badgePulse 2.5s ease-in-out infinite;
    }
    @keyframes badgePulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.7; }
    }
</style>

