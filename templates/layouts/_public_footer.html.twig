{# templates/layouts/_public_footer.html.twig #}
{# ARIES Public Site Footer - ARIES Digital University Theme - Enhanced Metronic UI #}
<style>
    /* Footer Metronic Enhancements */
    .footer-main { position: relative; overflow: hidden; }
    .footer-main::before { content: ''; position: absolute; top: 0; right: -100px; width: 400px; height: 400px; background: radial-gradient(circle, rgba(251, 191, 36, 0.05) 0%, transparent 70%); border-radius: 50%; pointer-events: none; }
    .footer-main::after { content: ''; position: absolute; bottom: -150px; left: -150px; width: 350px; height: 350px; background: radial-gradient(circle, rgba(26, 77, 46, 0.1) 0%, transparent 70%); border-radius: 50%; pointer-events: none; }
    .footer-link { position: relative; transition: all 0.2s ease; }
    .footer-link::before { content: ''; position: absolute; left: -12px; top: 50%; width: 0; height: 2px; background: linear-gradient(90deg, #fbbf24, transparent); transform: translateY(-50%); transition: width 0.3s ease; }
    .footer-link:hover::before { width: 8px; }
    .social-icon { position: relative; overflow: hidden; }
    .social-icon::before { content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(135deg, rgba(26, 77, 46, 0.8), rgba(45, 106, 79, 0.9)); opacity: 0; transition: opacity 0.3s ease; border-radius: inherit; }
    .social-icon:hover::before { opacity: 1; }
    .social-icon i { position: relative; z-index: 1; }
    .newsletter-input:focus { box-shadow: 0 0 0 3px rgba(251, 191, 36, 0.2); }
    .footer-badge { animation: footerBadgePulse 3s ease-in-out infinite; }
    @keyframes footerBadgePulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.02); } }
</style>

<footer class="footer-main bg-gray-900 text-gray-300" id="contact">
    {# Newsletter Section #}
    <div class="bg-gradient-to-r from-feu-green-700 via-feu-green-600 to-feu-green-700 py-10 lg:py-12 relative">
        <div class="container mx-auto px-4 lg:px-8 relative z-10">
            <div class="max-w-4xl mx-auto text-center">
                <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-white/10 backdrop-blur-sm rounded-full mb-4">
                    <i class="ki-filled ki-notification-status text-feu-gold-400"></i>
                    <span class="text-sm font-medium text-white">Stay Updated</span>
                </div>
                <h3 class="text-2xl lg:text-3xl font-bold text-white mb-3">Get Admission Updates</h3>
                <p class="text-white/70 mb-6 max-w-xl mx-auto">Subscribe to receive the latest news about enrollment schedules, requirements, and important announcements.</p>
                <form class="flex flex-col sm:flex-row items-center gap-3 max-w-md mx-auto">
                    <div class="relative flex-1 w-full">
                        <i class="ki-filled ki-sms absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        <input type="email" placeholder="Enter your email" class="newsletter-input w-full pl-11 pr-4 py-3.5 bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl text-white placeholder-white/50 focus:outline-none focus:border-feu-gold-400 transition-all">
                    </div>
                    <button type="submit" class="w-full sm:w-auto px-6 py-3.5 bg-feu-gold-400 hover:bg-feu-gold-300 text-feu-green-900 font-bold rounded-xl transition-all duration-200 hover:-translate-y-0.5 shadow-lg shadow-feu-gold-400/25 flex items-center justify-center gap-2">
                        <span>Subscribe</span>
                        <i class="ki-filled ki-arrow-right"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-4 lg:px-8 py-16 relative z-10">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
            {# Brand Column #}
            <div class="lg:col-span-1">
                <div class="flex items-center gap-3 mb-5">
                    <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-gradient-to-br from-feu-green-500 to-feu-green-600 shadow-lg shadow-feu-green-600/30">
                        <i class="ki-filled ki-abstract-26 text-feu-gold-400 text-xl"></i>
                    </div>
                    <div>
                        <span class="text-xl font-extrabold text-white block">ARIES</span>
                        <span class="text-xs text-feu-gold-400 font-medium tracking-wide">DIGITAL UNIVERSITY</span>
                    </div>
                </div>
                <p class="text-sm text-gray-400 mb-6 leading-relaxed">
                    Admission, Registration, Information, and Enrollment System — Your gateway to academic excellence at FEU Tech, FEU Diliman, and FEU Alabang.
                </p>
                <div class="flex items-center gap-2 mb-6">
                    <a href="https://facebook.com/FEabordo" target="_blank" rel="noopener" class="social-icon w-10 h-10 flex items-center justify-center rounded-xl bg-gray-800 text-gray-400 hover:text-white transition-all duration-200" aria-label="Facebook">
                        <i class="ki-filled ki-facebook text-lg"></i>
                    </a>
                </div>
                <div class="footer-badge inline-flex items-center gap-2 px-4 py-2.5 bg-gray-800/50 backdrop-blur-sm border border-gray-700 rounded-xl">
                    <i class="ki-filled ki-shield-tick text-feu-gold-400"></i>
