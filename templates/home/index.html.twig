{% block javascripts %}
{# Swiper.js for Carousel #}
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

{# AOS (Animate On Scroll) #}
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // ===== Initialize AOS =====
    AOS.init({
        duration: 800,
        easing: 'ease-out-cubic',
        once: true,
        offset: 50
    });

    // ===== 1. SHUFFLE THE DOM ELEMENTS =====
    const swiperWrapper = document.querySelector('.hero-swiper .swiper-wrapper');
    if (swiperWrapper) {
        const slides = Array.from(swiperWrapper.children);

        // Shuffle algorithm
        for (let i = slides.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [slides[i], slides[j]] = [slides[j], slides[i]];
        }

        // Apply shuffled order to DOM
        slides.forEach(slide => swiperWrapper.appendChild(slide));
    }

    // ===== 2. Initialize Hero Carousel =====
    const heroSwiper = new Swiper('.hero-swiper', {
        loop: true,
        autoplay: {
            delay: 6000,
            disableOnInteraction: false,
        },
        effect: 'fade',
        fadeEffect: {
            crossFade: true
        },
        speed: 1000,
        allowTouchMove: false, 
    });

    // ===== 3. DYNAMIC HOVER LOGIC =====
    const btnDiliman = document.getElementById('btn-diliman');
    const btnAlabang = document.getElementById('btn-alabang');

    // Find the NEW index of the specific slides after the shuffle
    const allShuffledSlides = Array.from(swiperWrapper.children);
    const dilimanIndex = allShuffledSlides.findIndex(slide => slide.dataset.campus === 'diliman');
    const alabangIndex = allShuffledSlides.findIndex(slide => slide.dataset.campus === 'alabang');

    // Diliman Button Hover
    if (btnDiliman && dilimanIndex !== -1) {
        btnDiliman.addEventListener('mouseenter', () => {
            heroSwiper.autoplay.stop();
            heroSwiper.slideToLoop(dilimanIndex); // Uses the dynamic index
        });
        btnDiliman.addEventListener('mouseleave', () => {
            heroSwiper.autoplay.start();
        });
    }

    // Alabang Button Hover
    if (btnAlabang && alabangIndex !== -1) {
        btnAlabang.addEventListener('mouseenter', () => {
            heroSwiper.autoplay.stop();
            heroSwiper.slideToLoop(alabangIndex); // Uses the dynamic index
        });
        btnAlabang.addEventListener('mouseleave', () => {
            heroSwiper.autoplay.start();
        });
    }

    // ===== Smooth Scroll for Anchor Links =====
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function(e) {
            const href = this.getAttribute('href');
            if (href !== '#') {
                e.preventDefault();
                const target = document.querySelector(href);
                if (target) {
                    const headerHeight = 80;
                    const targetPosition = target.getBoundingClientRect().top + window.pageYOffset - headerHeight;
                    window.scrollTo({
                        top: targetPosition,
                        behavior: 'smooth'
                    });
                }
            }
        });
    });
});
</script>
