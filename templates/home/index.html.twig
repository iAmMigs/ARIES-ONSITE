                        <div class="flex items-start justify-between mb-4">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                                <i class="ki-filled ki-people text-white text-2xl"></i>
                            </div>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">HUMSS</h3>
                        <p class="text-gray-600 text-sm mb-4">Humanities and Social Sciences</p>
                        <div class="flex flex-wrap gap-2 mt-auto">
                            <span class="px-2 py-1 bg-feu-green-50 text-feu-green-700 text-xs rounded-lg font-bold border border-feu-green-100">FEU Diliman</span>
                            <span class="px-2 py-1 bg-feu-gold-50 text-feu-gold-700 text-xs rounded-lg font-bold border border-feu-gold-100">FEU Alabang</span>
                        </div>
                    </div>

                    {# 4. GAS - General Academic Strand #}
                    <div class="program-card group" data-aos="fade-up" data-aos-delay="300">
                        <div class="flex items-start justify-between mb-4">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-yellow-500 to-yellow-600 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                                <i class="ki-filled ki-book text-white text-2xl"></i>
                            </div>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">GAS</h3>
                        <p class="text-gray-600 text-sm mb-4">General Academic Strand</p>
                        <div class="flex flex-wrap gap-2 mt-auto">
                            <span class="px-2 py-1 bg-feu-green-50 text-feu-green-700 text-xs rounded-lg font-bold border border-feu-green-100">FEU Diliman</span>
                            <span class="px-2 py-1 bg-feu-gold-50 text-feu-gold-700 text-xs rounded-lg font-bold border border-feu-gold-100">FEU Alabang</span>
                        </div>
