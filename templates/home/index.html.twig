{# templates/home/index.html.twig #}
{# ============================================================================
   ARIES Homepage - ARIES Digital University
   Modern University Website inspired by FEU Design
   
   Features:
   - Hero Carousel with Swiper.js
   - Animated Statistics Counters
   - Video Showcase Grid
   - News/Features Tabbed Section
   - Quick Services Grid
   - Cookie Consent Banner
   - Back to Top Button
   - AOS (Animate On Scroll) Effects
   
   Framework: Symfony 7 + Metronic v9.4.0 + Tailwind CSS
   ============================================================================ #}
{% extends 'base.html.twig' %}

{% block title %}Home - ARIES Digital University{% endblock %}
{% block og_title %}ARIES - Digital University{% endblock %}
{% block og_description %}Experience seamless online enrollment at FEU – Far Eastern University. For Tertiary (College) and Basic Education (K-12) students across FEU Tech, FEU Diliman, and FEU Alabang.{% endblock %}

{% block stylesheets %}
{# Swiper.js CSS for Carousel #}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

{# AOS (Animate On Scroll) CSS #}
<link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />

<style>
    /* ===== CSS Custom Properties ===== */
    :root {
        --swiper-theme-color: #fbbf24;
        --swiper-navigation-size: 24px;
    }
    
    /* ===== Global Animations ===== */
    @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }
    
    @keyframes pulse-glow {
        0%, 100% { box-shadow: 0 0 20px rgba(251, 191, 36, 0.3); }
        50% { box-shadow: 0 0 40px rgba(251, 191, 36, 0.5); }
    }
    
    @keyframes gradient-shift {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }
    
    @keyframes count-up {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    .animate-float { animation: float 4s ease-in-out infinite; }
    .animate-pulse-glow { animation: pulse-glow 2s ease-in-out infinite; }
    .animate-gradient { 
        background-size: 200% 200%;
        animation: gradient-shift 3s ease infinite;
    }
    
    /* ===== Hero Section ===== */
    .hero-section {
        min-height: 100vh;
        position: relative;
        overflow: hidden;
    }
    
    .hero-slide {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
    }
    
    .hero-slide::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(26, 77, 46, 0.95) 0%, rgba(26, 77, 46, 0.85) 50%, rgba(45, 106, 79, 0.8) 100%);
        z-index: 1;
    }
    
    .hero-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }
    
    .hero-content {
        position: relative;
        z-index: 2;
    }
    
    /* Hero Pattern Overlay */
    .hero-pattern {
        position: absolute;
        inset: 0;
        background-image: 
            linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
        background-size: 50px 50px;
        z-index: 1;
    }
    
    /* Swiper Custom Styles */
    .hero-swiper .swiper-pagination {
        bottom: 40px !important;
    }
    
    .hero-swiper .swiper-pagination-bullet {
        width: 12px;
        height: 12px;
        background: rgba(255, 255, 255, 0.4);
        opacity: 1;
        transition: all 0.3s ease;
    }
    
    .hero-swiper .swiper-pagination-bullet-active {
        width: 40px;
        border-radius: 6px;
        background: #fbbf24;
    }
    
    .hero-swiper .swiper-button-next,
    .hero-swiper .swiper-button-prev {
        width: 50px;
        height: 50px;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border-radius: 12px;
        transition: all 0.3s ease;
    }
    
    .hero-swiper .swiper-button-next:hover,
    .hero-swiper .swiper-button-prev:hover {
        background: rgba(251, 191, 36, 0.9);
    }
    
    .hero-swiper .swiper-button-next::after,
    .hero-swiper .swiper-button-prev::after {
        font-size: 18px;
        font-weight: bold;
        color: white;
    }
    
    /* ===== Section Styles ===== */
    .section-header {
        text-align: center;
        margin-bottom: 3rem;
    }
    
    .section-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: linear-gradient(135deg, rgba(26, 77, 46, 0.1), rgba(45, 106, 79, 0.1));
        border: 1px solid rgba(26, 77, 46, 0.2);
        border-radius: 9999px;
        font-size: 0.875rem;
        font-weight: 600;
        color: #1a4d2e;
        margin-bottom: 1rem;
    }
    
    .section-title {
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 800;
        color: #111827;
        line-height: 1.2;
        margin-bottom: 1rem;
    }
    
    .section-title-gradient {
        background: linear-gradient(135deg, #1a4d2e 0%, #2d6a4f 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    
    /* ===== Feature Cards ===== */
    .feature-card {
        background: white;
        border-radius: 1.25rem;
        padding: 2rem;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid #e5e7eb;
        position: relative;
        overflow: hidden;
    }
    
    .feature-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #1a4d2e, #fbbf24);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.4s ease;
    }
    
    .feature-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 25px 50px -12px rgba(26, 77, 46, 0.15);
        border-color: transparent;
    }
    
    .feature-card:hover::before {
        transform: scaleX(1);
    }
    
    /* ===== Program Cards ===== */
    .program-card {
        background: white;
        border-radius: 1.25rem;
        padding: 1.75rem;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid #e5e7eb;
        position: relative;
    }
    
    .program-card:hover {
        transform: translateY(-6px) scale(1.02);
        box-shadow: 0 20px 40px rgba(26, 77, 46, 0.12);
        border-color: #1a4d2e;
    }
    
    /* ===== Stats Counter ===== */
    .stat-card {
        background: white;
        border-radius: 1.25rem;
        padding: 2rem;
        text-align: center;
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
    }
    
    .stat-card:hover {
        transform: scale(1.05);
    }
    
    .stat-card::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #1a4d2e, #2d6a4f, #fbbf24);
    }
    
    .stat-number {
        font-size: clamp(2.5rem, 5vw, 3.5rem);
        font-weight: 800;
        background: linear-gradient(135deg, #1a4d2e 0%, #2d6a4f 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1;
    }
    
    /* ===== Video Showcase ===== */
    .video-card {
        position: relative;
        border-radius: 1.25rem;
        overflow: hidden;
        cursor: pointer;
        aspect-ratio: 16/9;
    }
    
    .video-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 50%);
        z-index: 1;
        transition: all 0.3s ease;
    }
    
    .video-card:hover::before {
        background: linear-gradient(to top, rgba(26, 77, 46, 0.9) 0%, rgba(26, 77, 46, 0.4) 100%);
    }
    
    .video-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }
    
    .video-card:hover img {
        transform: scale(1.1);
    }
    
    .video-play-btn {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 70px;
        height: 70px;
        background: rgba(251, 191, 36, 0.9);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2;
        transition: all 0.3s ease;
    }
    
    .video-card:hover .video-play-btn {
        transform: translate(-50%, -50%) scale(1.1);
        box-shadow: 0 0 30px rgba(251, 191, 36, 0.5);
    }
    
    /* ===== News Tabs ===== */
    .news-tab {
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        color: #6b7280;
        background: transparent;
        border: 2px solid transparent;
        border-radius: 0.75rem;
        transition: all 0.3s ease;
        cursor: pointer;
    }
    
    .news-tab:hover {
        color: #1a4d2e;
        background: rgba(26, 77, 46, 0.05);
    }
    
    .news-tab.active {
        color: #1a4d2e;
        background: white;
        border-color: #1a4d2e;
        box-shadow: 0 4px 15px rgba(26, 77, 46, 0.15);
    }
    
    .news-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        border: 1px solid #e5e7eb;
        transition: all 0.3s ease;
    }
    
    .news-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
        border-color: transparent;
    }
    
    /* ===== Service Cards ===== */
    .service-card {
        background: white;
        border-radius: 1.25rem;
        padding: 2rem;
        text-align: center;
        border: 1px solid #e5e7eb;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }
    
    .service-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(26, 77, 46, 0.03), rgba(251, 191, 36, 0.03));
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    
    .service-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(26, 77, 46, 0.15);
        border-color: #1a4d2e;
    }
    
    .service-card:hover::before {
        opacity: 1;
    }
    
    .service-icon {
        width: 70px;
        height: 70px;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        transition: all 0.3s ease;
    }
    
    .service-card:hover .service-icon {
        transform: scale(1.1) rotate(5deg);
    }
    
    /* ===== CTA Section ===== */
    .cta-section {
        background: linear-gradient(135deg, #1a4d2e 0%, #2d6a4f 50%, #1a4d2e 100%);
        position: relative;
        overflow: hidden;
    }
    
    .cta-section::before {
        content: '';
        position: absolute;
        top: -100px;
        right: -100px;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(251, 191, 36, 0.2) 0%, transparent 70%);
        border-radius: 50%;
    }
    
    .cta-section::after {
        content: '';
        position: absolute;
        bottom: -150px;
        left: -150px;
        width: 350px;
        height: 350px;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.05) 0%, transparent 70%);
        border-radius: 50%;
    }
    
    /* ===== Buttons ===== */
    .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1rem 2rem;
        font-size: 1rem;
        font-weight: 700;
        color: #1a4d2e;
        background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
        border-radius: 0.875rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(251, 191, 36, 0.4);
        border: none;
        cursor: pointer;
    }
    
    .btn-primary:hover {
        transform: translateY(-2px) scale(1.02);
        box-shadow: 0 8px 25px rgba(251, 191, 36, 0.5);
    }
    
    .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1rem 2rem;
        font-size: 1rem;
        font-weight: 600;
        color: white;
        background: transparent;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-radius: 0.875rem;
        transition: all 0.3s ease;
    }
    
    .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.5);
    }
    
    .btn-green {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1rem 2rem;
        font-size: 1rem;
        font-weight: 700;
        color: white;
        background: linear-gradient(135deg, #1a4d2e 0%, #2d6a4f 100%);
        border-radius: 0.875rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(26, 77, 46, 0.3);
    }
    
    .btn-green:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(26, 77, 46, 0.4);
    }
    
    /* ===== Back to Top Button ===== */
    .back-to-top {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #1a4d2e, #2d6a4f);
        color: white;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        opacity: 0;
        visibility: hidden;
        transform: translateY(20px);
        transition: all 0.3s ease;
        z-index: 1000;
        box-shadow: 0 4px 20px rgba(26, 77, 46, 0.3);
    }
    
    .back-to-top.visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }
    
    .back-to-top:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 30px rgba(26, 77, 46, 0.4);
    }
    
    /* ===== Cookie Consent ===== */
    .cookie-consent {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: white;
        padding: 1.5rem;
        box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.1);
        z-index: 9999;
        transform: translateY(100%);
        transition: transform 0.5s ease;
    }
    
    .cookie-consent.show {
        transform: translateY(0);
    }
    
    /* ===== Responsive ===== */
    @media (max-width: 768px) {
        .hero-slide {
            min-height: 100vh;
            padding-top: 120px;
        }
        
        .hero-swiper .swiper-button-next,
        .hero-swiper .swiper-button-prev {
            display: none;
        }
        
        .stat-card {
            padding: 1.5rem;
        }
        
        .feature-card {
            padding: 1.5rem;
        }
    }
    
    /* ===== Loading Skeleton ===== */
    .skeleton {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: skeleton-loading 1.5s infinite;
    }
    
    @keyframes skeleton-loading {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }
</style>
{% endblock %}

{% block body %}
    {# Skip to Content for Accessibility #}
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-feu-green-700 focus:text-white focus:rounded-lg">
        Skip to main content
    </a>

    {# Header #}
    {% include 'layouts/_public_header.html.twig' %}

    <main id="main-content">
        {# ===== Hero Carousel Section ===== #}
        <section class="hero-section">
            <div class="swiper hero-swiper h-full">
                <div class="swiper-wrapper">
                    {# Slide 1 - FEU Tech Manila #}
                    <div class="swiper-slide">
                        <div class="hero-slide">
                            <div class="hero-bg" style="background-image: url('{{ asset('images/hero/pic1.jpg') }}');"></div>
                            <div class="hero-pattern"></div>
                            <div class="hero-content container mx-auto px-4 lg:px-8">
                                <div class="max-w-3xl">
                                    <div data-aos="fade-up" class="inline-flex items-center gap-3 px-5 py-2.5 bg-white/10 backdrop-blur-md rounded-full border border-white/20 mb-8">
                                        <span class="relative flex h-3 w-3">
                                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-feu-gold-400 opacity-75"></span>
                                            <span class="relative inline-flex rounded-full h-3 w-3 bg-feu-gold-400"></span>
                                        </span>
                                        <span class="text-sm text-white font-semibold tracking-wide">Enrollment Open for A.Y. 2025-2026</span>
                                    </div>
                                    
                                    <h1 data-aos="fade-up" data-aos-delay="100" class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-extrabold text-white mb-6 leading-tight">
                                        FEU Tech<br>
                                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-feu-gold-400 to-feu-gold-300">Manila</span>
                                    </h1>
                                    
                                    <p data-aos="fade-up" data-aos-delay="200" class="text-lg lg:text-xl text-white/70 mb-4">
                                        The Premier Technology Institution in the Philippines
                                    </p>
                                    
                                    <p data-aos="fade-up" data-aos-delay="300" class="text-base lg:text-lg text-white/60 mb-10 max-w-xl">
                                        Excel in <strong class="text-white/80">IT, Computer Science, Engineering</strong> and more. Join 15,000+ students building the future of technology.
                                    </p>
                                    
                                    <div data-aos="fade-up" data-aos-delay="400" class="flex flex-col sm:flex-row items-start gap-4">
                                        <a href="{{ path('app_admission_apply') }}" class="btn-primary">
                                            <i class="ki-filled ki-rocket"></i>
                                            Apply for Tertiary
                                        </a>
                                        <a href="#programs" class="btn-secondary">
                                            <i class="ki-filled ki-book"></i>
                                            View Programs
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    {# Slide 2 - FEU Diliman #}
                    <div class="swiper-slide">
                        <div class="hero-slide">
                            <div class="hero-bg" style="background-image: url('{{ asset('images/hero/pic2.jpg') }}');"></div>
                            <div class="hero-pattern"></div>
                            <div class="hero-content container mx-auto px-4 lg:px-8">
                                <div class="max-w-3xl">
                                    <div class="inline-flex items-center gap-2 px-4 py-2 bg-feu-gold-400/20 backdrop-blur-md rounded-full border border-feu-gold-400/30 mb-8">
                                        <i class="ki-filled ki-teacher text-feu-gold-400"></i>
                                        <span class="text-sm text-white font-semibold">Complete K-12 to College</span>
                                    </div>
                                    
                                    <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-extrabold text-white mb-6 leading-tight">
                                        FEU<br>
                                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-feu-gold-400 to-feu-gold-300">Diliman</span>
                                    </h1>
                                    
                                    <p class="text-lg lg:text-xl text-white/70 mb-10 max-w-xl">
                                        From <strong class="text-white">Kinder to College</strong> — build strong foundations early. STEM, ABM, HUMSS tracks plus Business & Accountancy programs.
                                    </p>
                                    
                                    <div class="flex flex-col sm:flex-row items-start gap-4">
                                        <a href="{{ path('app_admission_apply') }}" class="btn-primary">
                                            <i class="ki-filled ki-notepad-edit"></i>
                                            Enroll in BED
                                        </a>
                                        <a href="#campuses" class="btn-secondary">
                                            <i class="ki-filled ki-geolocation"></i>
                                            View Campus
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    {# Slide 3 - FEU Alabang #}
                    <div class="swiper-slide">
                        <div class="hero-slide">
                            <div class="hero-bg" style="background-image: url('{{ asset('images/hero/pic3.jpg') }}');"></div>
                            <div class="hero-pattern"></div>
                            <div class="hero-content container mx-auto px-4 lg:px-8">
                                <div class="max-w-3xl">
                                    <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur-md rounded-full border border-white/20 mb-8">
                                        <i class="ki-filled ki-geolocation text-feu-gold-400"></i>
                                        <span class="text-sm text-white font-semibold">South Metro Manila</span>
                                    </div>
                                    
                                    <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-extrabold text-white mb-6 leading-tight">
                                        FEU Tech<br>
                                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-feu-gold-400 to-feu-gold-300">Alabang</span>
                                    </h1>
                                    
                                    <p class="text-lg lg:text-xl text-white/70 mb-10 max-w-xl">
                                        Quality education closer to home. <strong class="text-white">Senior High School</strong> with STEM, ABM, ICT tracks plus select <strong class="text-white">College programs</strong>.
                                    </p>
                                    
                                    <div class="flex flex-col sm:flex-row items-start gap-4">
                                        <a href="{{ path('app_admission_apply') }}" class="btn-primary">
                                            <i class="ki-filled ki-rocket"></i>
                                            Apply Now
                                        </a>
                                        <a href="#campuses" class="btn-secondary">
                                            <i class="ki-filled ki-geolocation"></i>
                                            Campus Details
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    

                </div>
                
                {# Swiper Navigation #}
                <div class="swiper-button-next hidden lg:flex"></div>
                <div class="swiper-button-prev hidden lg:flex"></div>
                <div class="swiper-pagination"></div>
            </div>
        </section>

        {# ===== About ARIES Section ===== #}
        <section class="py-20 lg:py-28 bg-white" id="about">
            <div class="container mx-auto px-4 lg:px-8">
                <div class="section-header" data-aos="fade-up">
                    <span class="section-badge">
                        <i class="ki-filled ki-abstract-26"></i>
                        About ARIES
