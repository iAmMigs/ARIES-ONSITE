{# templates/home/index.html.twig #}
{# ============================================================================
   ARIES Homepage - ARIES Digital University
   Modern University Website inspired by FEU Design
   
   Framework: Symfony 7 + Metronic v9.4.0 + Tailwind CSS
   ============================================================================ #}
{% extends 'base.html.twig' %}

{% block title %}Home - ARIES Digital University{% endblock %}
{% block og_title %}ARIES - Digital University{% endblock %}
{% block og_description %}Experience seamless online enrollment at FEU. For Tertiary (College) and Basic Education (K-12) students across FEU Tech, FEU Diliman, and FEU Alabang.{% endblock %}

{% block stylesheets %}
{# Swiper.js CSS for Carousel #}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

{# AOS (Animate On Scroll) CSS #}
<link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />

<style>
    /* ===== CSS Custom Properties ===== */
    :root {
        --swiper-theme-color: #fbbf24;
    }
    
    /* ===== Hero Section ===== */
    .hero-section {
        height: 100vh;
        min-height: 600px;
        position: relative;
        overflow: hidden;
    }
    
    /* Pure Background Carousel */
    .hero-swiper {
        position: absolute;
        inset: 0;
        z-index: 0;
    }

    .hero-slide {
        position: relative;
        width: 100%;
        height: 100%;
    }
    
    .hero-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    /* Dark Overlay so text is readable */
    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(26, 77, 46, 0.85) 0%, rgba(26, 77, 46, 0.60) 50%, rgba(45, 106, 79, 0.40) 100%);
        z-index: 1; 
    }
    
    /* Hero Pattern Overlay */
    .hero-pattern {
        position: absolute;
        inset: 0;
        background-image: 
            linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
        background-size: 50px 50px;
        z-index: 2;
        pointer-events: none;
    }
    
    /* Centered Foreground Content */
    .hero-content {
        position: absolute;
        inset: 0;
        z-index: 10;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
    }
    
    /* ===== Section Styles ===== */
    .section-header { text-align: center; margin-bottom: 3rem; }
    .section-badge { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; background: linear-gradient(135deg, rgba(26, 77, 46, 0.1), rgba(45, 106, 79, 0.1)); border: 1px solid rgba(26, 77, 46, 0.2); border-radius: 9999px; font-size: 0.875rem; font-weight: 600; color: #1a4d2e; margin-bottom: 1rem; }
    .section-title { font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; color: #111827; line-height: 1.2; margin-bottom: 1rem; }
    .section-title-gradient { background: linear-gradient(135deg, #1a4d2e 0%, #2d6a4f 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    
    /* ===== Feature Cards ===== */
    .feature-card { background: white; border-radius: 1.25rem; padding: 2rem; transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); border: 1px solid #e5e7eb; position: relative; overflow: hidden; }
    .feature-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, #1a4d2e, #fbbf24); transform: scaleX(0); transform-origin: left; transition: transform 0.4s ease; }
    .feature-card:hover { transform: translateY(-8px); box-shadow: 0 25px 50px -12px rgba(26, 77, 46, 0.15); border-color: transparent; }
    .feature-card:hover::before { transform: scaleX(1); }
    
    /* ===== Program Cards ===== */
    .program-card { background: white; border-radius: 1.25rem; padding: 1.75rem; transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); border: 1px solid #e5e7eb; position: relative; }
    .program-card:hover { transform: translateY(-6px) scale(1.02); box-shadow: 0 20px 40px rgba(26, 77, 46, 0.12); border-color: #1a4d2e; }
    
    /* ===== Video Showcase ===== */
    .video-card { position: relative; border-radius: 1.25rem; overflow: hidden; cursor: pointer; aspect-ratio: 16/9; }
    .video-card::before { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 50%); z-index: 1; transition: all 0.3s ease; }
    .video-card:hover::before { background: linear-gradient(to top, rgba(26, 77, 46, 0.9) 0%, rgba(26, 77, 46, 0.4) 100%); }
    .video-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
    .video-card:hover img { transform: scale(1.1); }
    .video-play-btn { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 70px; height: 70px; background: rgba(251, 191, 36, 0.9); border-radius: 50%; display: flex; align-items: center; justify-content: center; z-index: 2; transition: all 0.3s ease; }
    .video-card:hover .video-play-btn { transform: translate(-50%, -50%) scale(1.1); box-shadow: 0 0 30px rgba(251, 191, 36, 0.5); }
    
    /* ===== Service Cards ===== */
    .service-card { background: white; border-radius: 1.25rem; padding: 2rem; text-align: center; border: 1px solid #e5e7eb; transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); position: relative; overflow: hidden; }
    .service-card::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(26, 77, 46, 0.03), rgba(251, 191, 36, 0.03)); opacity: 0; transition: opacity 0.3s ease; }
    .service-card:hover { transform: translateY(-8px); box-shadow: 0 20px 40px rgba(26, 77, 46, 0.15); border-color: #1a4d2e; }
    .service-card:hover::before { opacity: 1; }
    .service-icon { width: 70px; height: 70px; border-radius: 1rem; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; transition: all 0.3s ease; }
    .service-card:hover .service-icon { transform: scale(1.1) rotate(5deg); }
    
    /* ===== Buttons ===== */
    .btn-primary { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 1rem 2rem; font-size: 1rem; font-weight: 700; color: #1a4d2e; background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%); border-radius: 0.875rem; transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(251, 191, 36, 0.4); border: none; cursor: pointer; }
    .btn-primary:hover { transform: translateY(-2px) scale(1.02); box-shadow: 0 8px 25px rgba(251, 191, 36, 0.5); }
    .btn-secondary { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 1rem 2rem; font-size: 1rem; font-weight: 600; color: white; background: transparent; border: 2px solid rgba(255, 255, 255, 0.3); border-radius: 0.875rem; transition: all 0.3s ease; }
    .btn-secondary:hover { background: rgba(255, 255, 255, 0.1); border-color: rgba(255, 255, 255, 0.5); }
    .btn-green { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 1rem 2rem; font-size: 1rem; font-weight: 700; color: white; background: linear-gradient(135deg, #1a4d2e 0%, #2d6a4f 100%); border-radius: 0.875rem; transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(26, 77, 46, 0.3); }
    .btn-green:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(26, 77, 46, 0.4); }
</style>
{% endblock %}

{% block body %}
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-feu-green-700 focus:text-white focus:rounded-lg">
        Skip to main content
    </a>

    {% include 'layouts/_public_header.html.twig' %}

    <main id="main-content">
        {# ===== Hero Carousel Section - PURE BACKGROUND ===== #}
        <section class="hero-section">
            
            {# Background Swiper #}
            <div class="swiper hero-swiper">
                <div class="swiper-wrapper">
                    {# Slide 0 - General FEU / Manila #}
                    <div class="swiper-slide">
                        <div class="hero-slide">
                            <div class="hero-bg" style="background-image: url('{{ asset('images/hero/pic1.jpg') }}');"></div>
                            <div class="hero-overlay"></div>
                        </div>
                    </div>
                    {# Slide 1 - Diliman (ADDED DATA ATTRIBUTE) #}
                    <div class="swiper-slide" data-campus="diliman">
                        <div class="hero-slide">
                            <div class="hero-bg" style="background-image: url('{{ asset('images/hero/pic2.jpg') }}');"></div>
                            <div class="hero-overlay"></div>
                        </div>
                    </div>
                    {# Slide 2 - Alabang (ADDED DATA ATTRIBUTE) #}
                    <div class="swiper-slide" data-campus="alabang">
                        <div class="hero-slide">
                            <div class="hero-bg" style="background-image: url('{{ asset('images/hero/pic3.jpg') }}');"></div>
                            <div class="hero-overlay"></div>
                        </div>
                    </div>
                    {# Slide 3 - Cheer #}
                    <div class="swiper-slide">
                        <div class="hero-slide">
                            <div class="hero-bg" style="background-image: url('{{ asset('images/hero/pic4.jpg') }}');"></div>
                            <div class="hero-overlay"></div>
                        </div>
                    </div>
                    {# Slide 4 - Diliman Court #}
                    <div class="swiper-slide">
                        <div class="hero-slide">
                            <div class="hero-bg" style="background-image: url('{{ asset('images/hero/pic5.jpg') }}');"></div>
                            <div class="hero-overlay"></div>
                        </div>
                    </div>
                    {# Slide 5 - Alabang Event #}
                    <div class="swiper-slide">
                        <div class="hero-slide">
                            <div class="hero-bg" style="background-image: url('{{ asset('images/hero/pic6.jpg') }}');"></div>
                            <div class="hero-overlay"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="hero-pattern"></div>

            {# STATIC CENTERED CONTENT #}
            <div class="hero-content container mx-auto px-4 lg:px-8">
                <div class="max-w-4xl" data-aos="fade-up">
                    <h1 class="text-5xl md:text-6xl lg:text-8xl font-extrabold text-white mb-6 leading-tight">
                        Start your campus life with <span class="text-feu-gold-400">FEU</span>
                    </h1>
                    
                    <p class="text-xl md:text-2xl text-white/80 mb-12 font-medium">
                        Choose the FEU campus that you want to enroll in.
                    </p>
                    
                    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
                        {# Interactive Buttons with IDs for JS #}
                        <a href="{{ path('app_admission_apply') }}" class="btn-primary px-8 py-4 text-lg" id="btn-diliman">
                            <i class="ki-filled ki-geolocation"></i> FEU Diliman
                        </a>
                        <a href="{{ path('app_admission_apply') }}" class="btn-secondary px-8 py-4 text-lg" id="btn-alabang">
                            <i class="ki-filled ki-geolocation"></i> FEU Alabang
                        </a>
                    </div>
                </div>
            </div>
        </section>

        {# ===== About ARIES Section ===== #}
        <section class="py-20 lg:py-28 bg-white" id="about">
            <div class="container mx-auto px-4 lg:px-8">
                <div class="section-header" data-aos="fade-up">
                    <span class="section-badge">
                        <i class="ki-filled ki-abstract-26"></i>
                        About ARIES
                    </span>
                    <h2 class="section-title">
                        What is
                        <span class="section-title-gradient">ARIES?</span>
                    </h2>
                    <p class="text-lg text-gray-600 max-w-3xl mx-auto">
                        ARIES (Admission, Registration, Information & Enrollment System) is FEU's comprehensive digital platform 
                        for both <strong>Tertiary</strong> and <strong>Basic Education Department (BED)</strong> students across 
                        <strong>FEU Tech Manila</strong>, <strong>FEU Diliman</strong>, and <strong>FEU Alabang</strong>.
                    </p>
                </div>
                
                {# Features Grid #}
                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 mb-20">
                    <div class="feature-card" data-aos="fade-up" data-aos-delay="0">
                        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-feu-green-500 to-feu-green-600 flex items-center justify-center mb-5 shadow-lg">
                            <i class="ki-filled ki-cloud text-white text-2xl"></i>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-3">100% Cloud-Based</h3>
                        <p class="text-gray-600">Complete your entire enrollment from anywhere in the world, anytime you want.</p>
                    </div>
                    
                    <div class="feature-card" data-aos="fade-up" data-aos-delay="100">
                        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-feu-gold-400 to-feu-gold-500 flex items-center justify-center mb-5 shadow-lg">
                            <i class="ki-filled ki-shield-tick text-feu-green-800 text-2xl"></i>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-3">Bank-Level Security</h3>
                        <p class="text-gray-600">Your personal data is protected with enterprise-grade encryption and security.</p>
                    </div>
                    
                    <div class="feature-card" data-aos="fade-up" data-aos-delay="200">
                        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-feu-green-500 to-feu-green-600 flex items-center justify-center mb-5 shadow-lg">
                            <i class="ki-filled ki-delivery-time text-white text-2xl"></i>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-3">Real-Time Tracking</h3>
                        <p class="text-gray-600">Monitor your application status with instant updates and email notifications.</p>
                    </div>
                    
                    <div class="feature-card" data-aos="fade-up" data-aos-delay="300">
                        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-feu-gold-400 to-feu-gold-500 flex items-center justify-center mb-5 shadow-lg">
                            <i class="ki-filled ki-message-question text-feu-green-800 text-2xl"></i>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-3">24/7 Support</h3>
                        <p class="text-gray-600">Get help whenever you need it through our dedicated support channels.</p>
                    </div>
                </div>
            </div>
        </section>

        {# ===== Our Campuses Section ===== #}
