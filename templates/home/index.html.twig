                                <i class="ki-filled ki-chart-pie-3 text-white text-2xl"></i>
                            </div>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">ABM</h3>
                        <p class="text-gray-600 text-sm mb-4">Accountancy, Business, and Management</p>
                        <div class="flex flex-wrap gap-2 mt-auto">
                            <span class="px-2 py-1 bg-feu-green-50 text-feu-green-700 text-xs rounded-lg font-bold border border-feu-green-100">FEU Diliman</span>
